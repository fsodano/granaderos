"""Worker-only shirt neckline, sewn onto the accepted reduced coat edge."""
import math
import bpy, bmesh
from mathutils import Vector

def collar_directions(vertices):
    points=[(v.co.x,v.co.y+.036,i) for i,v in enumerate(vertices)]
    # The native sewn edge has small inward detours at its rear. Follow its
    # outer angular order without copying those detours into the visible rim.
    ordered=sorted(points)
    def cross(o,a,b):return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])
    halves=[]
    for sequence in (ordered,list(reversed(ordered))):
        h=[]
        for p in sequence:
            while len(h)>=2 and cross(h[-2],h[-1],p)<=0:h.pop()
            h.append(p)
        halves.extend(h[:-1])
    ids=sorted({p[2] for p in halves});count=len(vertices);angles=[None]*count
    for k,a in enumerate(ids):
        b=ids[(k+1)%len(ids)];end=b if b>a else b+count
        start=math.atan2(points[a][1],points[a][0]);stop=math.atan2(points[b][1],points[b][0])
        delta=(stop-start)%math.tau
        if delta>math.pi:raise ValueError('The sewn collar must retain its native outer winding')
        for j in range(a,end):angles[j%count]=start+delta*(j-a)/(end-a)
    for i in range(1,count):
        while angles[i]<angles[i-1]:angles[i]+=math.tau
    step=math.tau/count;phase=sum(a-i*step for i,a in enumerate(angles))/count
    return [[Vector((math.cos(a*(1-f)+(phase+i*step)*f),math.sin(a*(1-f)+(phase+i*step)*f),0)) for i,a in enumerate(angles)] for f in (.15,.60,1.)]


def fit_worker_neckline(ctx, lod):
    from anatomy_surface import sewn_boundary, surface_weights
    from optimize import _head_component_vertices, _keep_vertices, HEAD_SKIN_RATIOS
    coat=ctx['coat'];objects=ctx['objects'];material=ctx['M']['red']
    # The retained head copy has not reached its own reduction yet. It supplies
    # the same displayed native neck, without reading the cropped hand batch.
    reference=next(obj for obj in objects if obj.get('retain_head_skin'))
    skin=reference.copy();skin.data=reference.data.copy();skin.name='Worker_Neck_Reference'
    bpy.context.collection.objects.link(skin)
    _keep_vertices(skin,_head_component_vertices(skin))
    bpy.context.view_layer.objects.active=skin
    modifier=skin.modifiers.new('Worker_Neck_LOD','DECIMATE');modifier.ratio=HEAD_SKIN_RATIOS[lod]
    modifier.use_collapse_triangulate=True
    while skin.modifiers.find(modifier.name)>0:bpy.ops.object.modifier_move_up(modifier=modifier.name)
    bpy.ops.object.modifier_apply(modifier=modifier.name)
    red=list(coat.data.materials).index(material)
    def unchanged_faces():
        return sorted(tuple(sorted(tuple(coat.data.vertices[i].co)for i in f.vertices))for f in coat.data.polygons if f.material_index!=red)
    bm=bmesh.new();bm.from_mesh(coat.data)
    def inside_neck_patch(vertex):
        p=vertex.co;radius=math.hypot(p.x,p.y+.036)
        front=max(0,-(p.y+.036)/max(.001,radius))
        return p.z>1.445 and radius<.145
    removed=[f for f in bm.faces if f.material_index==red or any(inside_neck_patch(v)for v in f.verts)]
    print('WORKER_NECK_PATCH_REMOVED',len(removed))
    bmesh.ops.delete(bm,geom=removed,context='FACES')
    loose=[v for v in bm.verts if not v.link_faces]
    if loose:bmesh.ops.delete(bm,geom=loose,context='VERTS')
    bm.to_mesh(coat.data);bm.free();coat.data.update()
    before=unchanged_faces()
    seam=sewn_boundary(coat,lambda v:v.co.z>1.35 and abs(v.co.x)<.20)
    count=len(seam);dirs=collar_directions(seam)
    seam_angles=[math.atan2(d.y,d.x)for d in dirs[0]]
    for i in range(1,count):
        while seam_angles[i]<seam_angles[i-1]:seam_angles[i]+=math.tau
    phase=seam_angles[0];seam_parameters=[(a-phase)/math.tau for a in seam_angles]
    assert all(b>a for a,b in zip(seam_parameters,seam_parameters[1:]))
    seam_tones=[tuple(coat.data.color_attributes['Human_Surface_Tone'].data[v.index].color)for v in seam]
    coords=[v.co.copy()for v in seam]
    weights=[{coat.vertex_groups[g.group].name:g.weight for g in v.groups if g.weight>1e-7}for v in seam]
    rows=[list(range(count))];faces=[];regular_count=104
    angles=[phase+i*math.tau/regular_count for i in range(regular_count)]
    def ring(level):
        ids=[]
        for a in angles:
            front=max(0,-math.sin(a));z=level-.006*front**4
            direction=Vector((math.cos(a),math.sin(a),0));centre=Vector((0,-.036,z))
            hit,q,n,f=skin.ray_cast(centre+direction*.17,-direction)
            if not hit:raise ValueError('Worker neckline needs an actual native neck hit')
            ids.append(len(coords));coords.append(q+direction*.006)
            weights.append(surface_weights(skin,q,f))
        return ids
    # Uniform upper samples remove the inherited rear detour. The base still
    # uses the exact accepted shirt seam, so the remaining garment is unchanged.
    rows.append(ring(1.515));rows.append(ring(1.531))
    def join(lower,upper,skip_front=False,lower_parameters=None):
        i=j=0;n=len(lower);m=len(upper)
        while i<n or j<m:
            a=lower[i%n];b=upper[j%m]
            u=(lower_parameters[i+1] if lower_parameters is not None and i+1<n else (i+1)/n) if i<n else 2
            v=(j+1)/m if j<m else 2
            if abs(u-v)<1e-10:poly=(a,lower[(i+1)%n],upper[(j+1)%m],b);i+=1;j+=1
            elif u<v:poly=(a,lower[(i+1)%n],b);i+=1
            else:poly=(a,upper[(j+1)%m],b);j+=1
            if skip_front:
                centre=sum((coords[k]for k in poly),Vector())/len(poly)
                if abs(centre.x)<.016 and centre.y<-.070:continue
            faces.append(poly)
    join(rows[0],rows[1],lower_parameters=seam_parameters);shirt_face_count=len(faces)
    join(rows[1],rows[2])
    top=list(rows[-1]);previous=[]
    # Separate coincident vertices at the sewn fold. The cloth keeps a
    # distinct fold plane instead of shading the whole collar as a tube.
    for i in top:
        previous.append(len(coords));coords.append(coords[i].copy());weights.append(dict(weights[i]))
    # A short turn-down collar follows the neck at its sewn stand, then falls
    # over the shirt. A centre opening separates the two front collar points.
    for t in (.20,.55,1.):
        ring_ids=[]
        for i,a in enumerate(angles):
            front=max(0,-math.sin(a));direction=Vector((math.cos(a),math.sin(a),0))
            p=coords[top[i]]+direction*((.017+.010*front**3)*t)
            p.z-=(.022+.030*front**6)*t
            ring_ids.append(len(coords));coords.append(p);weights.append(dict(weights[top[i]]))
        join(previous,ring_ids,True);previous=ring_ids
    # Sew a narrow turned hem; it has real thickness rather than a paper edge.
    hem=[]
    for i in previous:
        p=coords[i];direction=Vector((p.x,p.y+.036,0)).normalized()
        hem.append(len(coords));coords.append(p-direction*.0012+Vector((0,0,.0006)));weights.append(dict(weights[i]))
    join(previous,hem,True)
    bpy.data.objects.remove(skin,do_unlink=True)
    uvs=[]
    for polygon in faces:
        values=[(.5+math.atan2(coords[i].x,-(coords[i].y+.036))/math.tau, (coords[i].z-1.46)/.085)for i in polygon]
        if max(u for u,v in values)-min(u for u,v in values)>.5:
            values=[(u+1 if u<.5 else u,v)for u,v in values]
        uvs.append(values)
    collar=ctx['mesh']('Worker_Sewn_Shirt_Collar',coords,faces,material,weights,uvs)
    collar.data.materials.append(ctx['M']['navy'])
    for face in collar.data.polygons[:shirt_face_count]:face.material_index=1
    # The original collar's face pigment has no distinct identity to preserve;
    # use the same shirt material and neutral pigment on the new facing.
    tones=collar.data.color_attributes.new(name='Human_Surface_Tone',type='FLOAT_COLOR',domain='POINT')
    for entry in tones.data:entry.color=(1,1,1,1)
    for entry,value in zip(tones.data,seam_tones):entry.color=value
    seam_positions={tuple(round(x,6)for x in p)for p in coords[:count]}
    bpy.ops.object.select_all(action='DESELECT');coat.select_set(True);collar.select_set(True);bpy.context.view_layer.objects.active=coat;bpy.ops.object.join();objects.remove(collar)
    bm=bmesh.new();bm.from_mesh(coat.data);selected=[v for v in bm.verts if tuple(round(x,6)for x in v.co)in seam_positions]
    bmesh.ops.remove_doubles(bm,verts=selected,dist=.000002)
    bmesh.ops.triangulate(bm,faces=[f for f in bm.faces if f.material_index==red]);bm.to_mesh(coat.data);bm.free();coat.data.update()
    after=unchanged_faces()
    from collections import Counter
    assert not(Counter(before)-Counter(after)),'Worker collar may not alter any retained shirt support face'
    print('WORKER_NECKLINE',len(before),'unchanged shirt triangles;',count,'sewn vertices;',len(coords),'collar vertices')
