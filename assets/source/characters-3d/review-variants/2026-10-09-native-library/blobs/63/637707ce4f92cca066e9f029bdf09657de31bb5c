+"""Private Worker waistcoat: cut an actual continuous band from reduced shirt.
+
+The shirt remains untouched. Triangle intersections carry its native weights;
+only the waistcoat opening/armholes/hem and their 1.4 mm turned edges change.
+"""
+import math
+import bpy,bmesh
+from mathutils import Vector
+
+def rebuild_worker_waistcoat(ctx,obj):
+    coat=ctx['coat'];coat.data.calc_loop_triangles()
+    names=[g.name for g in coat.vertex_groups]
+    # Preserve the sampled seam/shoulder rows. Relax only the front panel's
+    # anatomical chest loops: flattening their original nipple fan had folded
+    # triangles back through the garment before any action was applied.
+    points=[v.co.copy()for v in coat.data.vertices];neighbours=[set()for p in points]
+    source_weights=[{names[g.group]:g.weight for g in v.groups}for v in coat.data.vertices]
+    for edge in coat.data.edges:
+        a,b=edge.vertices;neighbours[a].add(b);neighbours[b].add(a)
+    influence=[]
+    for p in points:
+        mask=max(0,min(1,(p.z-1.17)/.035,(1.405-p.z)/.035,(.165-abs(p.x))/.035,(-p.y-.070)/.035))
+        front=max(0,min(1,(.01-p.y)/.10));opening=1.470*(1-front)+(1.285+1.85*abs(p.x))*front-p.z
+        mask*=max(0,min(1,(opening-.018)/.032));influence.append(mask)
+    original=[p.copy()for p in points]
+    for iteration in range(12):
+        after=[p.copy()for p in points]
+        for i,p in enumerate(points):
+            if influence[i]<=0 or not neighbours[i]:continue
+            average=sum((points[j]for j in neighbours[i]),Vector())/len(neighbours[i])
+            q=p.lerp(average,.55*influence[i]);q.y=min(q.y,original[i].y+.001)
+            after[i]=q
+        points=after
+    for iteration in range(3):
+        after=[dict(w)for w in source_weights]
+        for i,w in enumerate(source_weights):
+            if influence[i]<=0 or not neighbours[i]:continue
+            keys=set(w)|set(k for j in neighbours[i]for k in source_weights[j]);amount=.35*influence[i]
+            after[i]={k:w.get(k,0)*(1-amount)+sum(source_weights[j].get(k,0)for j in neighbours[i])/len(neighbours[i])*amount for k in keys}
+        source_weights=after
+    envelope=bpy.data.meshes.new('Worker_Front_Envelope');envelope.from_pydata(points,[],[tuple(f.vertices)for f in coat.data.polygons]);envelope.update()
+    envelope_normals=[v.normal.copy()for v in envelope.vertices]
+    print('WORKER_FRONT_ENVELOPE_MAX',max((a-b).length for a,b in zip(points,original)),flush=True)
+    def vertex(index):return(points[index],envelope_normals[index],source_weights[index])
+    def mix(a,b,t):
+        keys=set(a[2])|set(b[2])
+        return(a[0].lerp(b[0],t),a[1].lerp(b[1],t).normalized(),{k:a[2].get(k,0)*(1-t)+b[2].get(k,0)*t for k in keys})
+    def clip(poly,f):
+        result=[]
+        for a,b in zip(poly,poly[1:]+poly[:1]):
+            x,y=f(a[0]),f(b[0]);inside=x>=-1e-9
+            if inside:result.append(a)
+            if inside!=(y>=-1e-9):result.append(mix(a,b,x/(x-y)))
+        return result
+    def neck(p):
+        front=max(0,min(1,(.01-p.y)/.10))
+        limit=1.470*(1-front)+(1.285+1.85*abs(p.x))*front
+        return limit-p.z
