metrics={}
for view,suffix in [('face','.face'),('isometric','')]:
 imgs=[Image.open(root/f'{stage}/granadero/stand.idle.unarmed.sample-1{suffix}.png').convert('RGB')for stage in ('before','after')]
 out=Image.new('RGB',(1400,732),'#202622');d=ImageDraw.Draw(out)
 for i,img in enumerate(imgs):out.paste(img,(i*700,32));d.text((i*700+16,9),['Baseline','Rejected material pilot'][i],fill='white')
 out.save(root/f'compare-{view}.png')
 a,b=map(lambda im:np.asarray(im).astype(float),imgs);diff=np.abs(a-b);metrics[view]={'meanAbsoluteChannelChangeOutOf255':float(diff.mean()),'maxChannelChange':float(diff.max()),'changedPixels':int(np.any(diff>0,axis=2).sum())}
raw=(base/'granadero-lod0.glb').read_bytes();doc=json.loads(raw[20:20+int.from_bytes(raw[12:16],'little')]);mask=np.asarray(Image.open(root/'head-mask.png'))>0
