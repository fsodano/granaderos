   assert a['materials'][pa['material']]['name']=='Skin' and key=='COLOR_0',(ma['name'],key)
   positions=list(struct.iter_unpack('<3f',acc(a,ab,pa['attributes']['POSITION'])))
   ca=a['accessors'][idx];width={'VEC3':3,'VEC4':4}[ca['type']];fmt={5121:'B',5123:'H',5126:'f'}[ca['componentType']];one=255 if fmt=='B' else 65535 if fmt=='H' else 1
   for i,(x,y)in enumerate(zip(struct.iter_unpack('<'+str(width)+fmt,before),struct.iter_unpack('<'+str(width)+fmt,after))):
    if x!=y:
     assert all(abs(v-one)<1e-6 for v in y)
     colour.append(positions[i])
  if 'TEXCOORD_1'in pb['attributes']:
   assert a['materials'][pa['material']]['name']=='Skin'
