 while o.modifiers.find(dec.name)>0:bpy.ops.object.modifier_move_up(modifier=dec.name)
 bpy.ops.object.modifier_apply(modifier=dec.name)
 rows.append({'name':o.name,'before':before,'after':facts(o)})
