def facts(o):
 coords={v.index:tuple(round(x,7) for x in v.co) for v in o.data.vertices};edges={}
 for p in o.data.polygons:
  ids=list(p.vertices)
  for a,b in zip(ids,ids[1:]+ids[:1]):
   a,b=coords[a],coords[b]
   if a==b:continue
   key=tuple(sorted((a,b)));edges[key]=edges.get(key,0)+1
 bounds=[e for e,n in edges.items() if n==1]
 return {'vertices':len(o.data.vertices),'faces':len(o.data.polygons),'boundaryEdges':len(bounds),'boundaryPoints':bounds}
