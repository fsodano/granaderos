"""Private Worker vest with a shared, native-weighted shirt seam."""
import math,json
from pathlib import Path
import bpy
from mathutils import Vector

def rebuild_worker_waistcoat(ctx,obj):
    coat=ctx['coat'];source=coat.data;source.calc_loop_triangles()
    names=[g.name for g in coat.vertex_groups]
    original=[v.co.copy()for v in source.vertices]
    source_weights=[{names[g.group]:g.weight for g in v.groups}for v in source.vertices]
    colours=source.color_attributes['Human_Surface_Tone']
    source_colours=[tuple(c.color)for c in colours.data]
    points=[p.copy()for p in original];neighbours=[set()for p in points]
    for edge in source.edges:
        a,b=edge.vertices;neighbours[a].add(b);neighbours[b].add(a)
    def neck(p):
        front=max(0,min(1,(.01-p.y)/.10))
        return 1.470*(1-front)+(1.285+1.85*abs(p.x))*front-p.z
    constraints=[lambda p:p.z-1.010,lambda p:1.495-p.z,
                 lambda p:.187-.32*max(0,p.z-1.275)-abs(p.x),neck]
    influence=[]
    for p in points:
        mask=max(0,min(1,(p.z-1.17)/.035,(1.405-p.z)/.035,(.165-abs(p.x))/.035,(-p.y-.070)/.035))
        # The garment can bridge pectoral loops, but all sewn boundaries stay
        # on their source shirt triangles with no smoothing drift.
        mask*=max(0,min(1,(min(f(p)for f in constraints)-.012)/.035))
        influence.append(mask)
    for iteration in range(12):
        after=[p.copy()for p in points]
        for i,p in enumerate(points):
            if influence[i]<=0 or not neighbours[i]:continue
            average=sum((points[j]for j in neighbours[i]),Vector())/len(neighbours[i])
            q=p.lerp(average,.55*influence[i]);q.y=min(q.y,original[i].y+.001);after[i]=q
        points=after
    envelope=bpy.data.meshes.new('Worker_Front_Envelope');envelope.from_pydata(points,[],[tuple(f.vertices)for f in source.polygons]);envelope.update()
    normals=[v.normal.copy()for v in envelope.vertices]
    def blend_dict(a,b,t):return{k:a.get(k,0)*(1-t)+b.get(k,0)*t for k in set(a)|set(b)}
    # Records carry original position, native normal, native weights, barycentric
    # provenance, and original loop UV. Both sides use the identical record.
    def mix(a,b,t):return(a[0].lerp(b[0],t),a[1].lerp(b[1],t).normalized(),blend_dict(a[2],b[2],t),blend_dict(a[3],b[3],t),a[4].lerp(b[4],t))
    def clip(poly,f):
        result=[]
        for a,b in zip(poly,poly[1:]+poly[:1]):
            x,y=f(a[0]),f(b[0]);inside=x>=-1e-9
            if inside:result.append(a)
            if inside!=(y>=-1e-9):result.append(mix(a,b,x/(x-y)))
        return result
    def normalized(w):
        keep=sorted(w.items(),key=lambda kv:-kv[1])[:4];total=sum(v for k,v in keep)
        return{k:v/total for k,v in keep if v>1e-7}
    coords=[];weights=[];faces=[];records=[];cache={}
    shirt_coords=[p.copy()for p in original];shirt_weights=[dict(w)for w in source_weights];shirt_colours=list(source_colours);shirt_faces=[];shirt_uvs=[];shirt_mats=[];shirt_cache={tuple(round(c,5)for c in p):i for i,p in enumerate(original)}
    def colour(record):return tuple(sum(source_colours[i][k]*v for i,v in record[3].items())for k in range(4))
    def shirt_vertex(v):
        key=tuple(round(c,5)for c in v[0])
        if key not in shirt_cache:
            shirt_cache[key]=len(shirt_coords);shirt_coords.append(v[0]);shirt_weights.append(normalized(v[2]));shirt_colours.append(colour(v))
        return shirt_cache[key]
    def put(v):
        p,n,w,bary,uv=v;key=tuple(round(c,5)for c in p)
        if key not in cache:
            smooth=sum((points[i]*amount for i,amount in bary.items()),Vector())
            amount=max(0,min(1,min(f(p)for f in constraints)/.025))
            fitted=p.lerp(smooth,amount)
            smooth_n=sum((normals[i]*amount for i,amount in bary.items()),Vector()).normalized()
            normal=n.lerp(smooth_n,amount).normalized()
            cache[key]=len(coords);coords.append(fitted+normal*.003);weights.append(normalized(w));records.append(v)
        return cache[key]
    def add_fan(ids,points_out,faces_out):
        for i in range(1,len(ids)-1):
            tri=(ids[0],ids[i],ids[i+1])
            if len(set(tri))==3 and (points_out[tri[1]]-points_out[tri[0]]).cross(points_out[tri[2]]-points_out[tri[0]]).length>1e-10:faces_out.append(tri)
    removed=changed=0
    for tri in source.loop_triangles:
        poly=[(original[i],source.vertices[i].normal.copy(),source_weights[i],{i:1.0},source.uv_layers.active.data[li].uv.copy())for i,li in zip(tri.vertices,tri.loops)]
        inside=[];outside=[]
        for side in (-1,1):
            piece=clip(poly,lambda p:side*p.x)
            for constraint in constraints:
                if len(piece)<3:break
                discard=clip(piece,lambda p:-constraint(p))
                if len(discard)>=3:outside.append(discard)
                piece=clip(piece,constraint)
            if len(piece)>=3:inside.append(piece)
        if not inside:
            shirt_faces.append(tuple(tri.vertices));shirt_uvs.append([v[4]for v in poly]);shirt_mats.append(source.polygons[tri.polygon_index].material_index)
            continue
        removed+=1
        for piece in inside:add_fan([put(v)for v in piece],coords,faces)
        for piece in outside:
            ids=[shirt_vertex(v)for v in piece]
            for i in range(1,len(ids)-1):
                f=(ids[0],ids[i],ids[i+1])
                if len(set(f))<3 or (shirt_coords[f[1]]-shirt_coords[f[0]]).cross(shirt_coords[f[2]]-shirt_coords[f[0]]).length<1e-10:continue
                shirt_faces.append(f);shirt_uvs.append([piece[j][4]for j in (0,i,i+1)]);shirt_mats.append(source.polygons[tri.polygon_index].material_index);changed+=1
    edges={}
    for f in faces:
        for a,b in zip(f,f[1:]+f[:1]):edges.setdefault(tuple(sorted((a,b))),[]).append((a,b))
    rim={};seams=[]
    for edge,values in edges.items():
        if len(values)!=1:continue
        a,b=values[0]
        for i in (a,b):
            if i not in rim:
                v=records[i];rim[i]=len(coords);coords.append(v[0].copy());weights.append(normalized(v[2]));seams.append({'position':list(v[0]),'weights':normalized(v[2])})
        faces.append((b,a,rim[a],rim[b]))
    def assign(obj,mesh,ws):
        old=obj.data;obj.data=mesh;obj.vertex_groups.clear();groups={name:obj.vertex_groups.new(name=name)for name in sorted(set(k for w in ws for k in w))}
        for i,w in enumerate(ws):
            for name,amount in w.items():
                if amount>1e-7:groups[name].add([i],amount,'REPLACE')
        if old.users==0:bpy.data.meshes.remove(old)
    shirt=bpy.data.meshes.new('Worker_Shirt_Sewn_Boundary');shirt.from_pydata(shirt_coords,[],shirt_faces);shirt.update()
    for m in source.materials:shirt.materials.append(m)
    layer=shirt.uv_layers.new(name=source.uv_layers.active.name)
    for face,uv,mat in zip(shirt.polygons,shirt_uvs,shirt_mats):
        face.use_smooth=True;face.material_index=mat
        for li,value in zip(face.loop_indices,uv):layer.data[li].uv=value
    col=shirt.color_attributes.new(name='Human_Surface_Tone',type='FLOAT_COLOR',domain='POINT')
    for entry,value in zip(col.data,shirt_colours):entry.color=value
    shirt.color_attributes.active_color_index=0;shirt.color_attributes.render_color_index=0
    assign(coat,shirt,shirt_weights)
    mesh=bpy.data.meshes.new('Worker_Waistcoat_Sewn');mesh.from_pydata(coords,[],faces);mesh.update();mesh.materials.append(ctx['M']['trousers']);assign(obj,mesh,weights)
    for f in mesh.polygons:f.use_smooth=len(f.vertices)==3
    colour_attr=mesh.color_attributes.new(name='Human_Surface_Tone',type='FLOAT_COLOR',domain='POINT')
    for v,c in zip(mesh.vertices,colour_attr.data):
        p=v.co;shade=.96+.02*math.sin(p.z*19+p.x*13)+.015*math.sin(p.z*37-p.y*17);c.color=(shade,shade,shade,1)
    mesh.color_attributes.active_color_index=0;mesh.color_attributes.render_color_index=0
    bpy.data.meshes.remove(envelope)
    receipt={'seamRecords':seams,'vestVertices':len(coords),'vestFaces':len(faces),'replacedCoveredShirtTriangles':removed,'newShirtBoundaryTriangles':changed,'maxGarmentRelaxationMetres':max((a-b).length for a,b in zip(points,original))}
    Path('/tmp/granadero-worker-clothing-current-pilot/sewn-source-proof.json').write_text(json.dumps(receipt,indent=2)+'\n')
    print('WORKER_SEWN_BOUNDARY',len(seams),len(coords),len(faces),removed,changed,flush=True)
