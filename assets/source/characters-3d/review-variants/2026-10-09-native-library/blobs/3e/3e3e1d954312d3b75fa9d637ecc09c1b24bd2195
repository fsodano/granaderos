"""A small, sewn compression study on the two military uniforms only.

The existing coat topology and skinning stay intact. Unequal folds stop before
neck and sleeve openings; no change is made to native skin or joint frames.
"""
import math
from mathutils import Vector


def _reference_relief(point, normal, heads):
    def bell(value, width):
        return math.exp(-(value / width) ** 2)

    def fold(value, width):
        # A rounded ridge with a shallow narrow tuck, rather than a sharp rib.
        return bell(value - width * .35, width) - .70 * bell(value + width * .72, width * .52)

    side = 'l' if point.x > 0 else 'r'
    sign = 1 if side == 'l' else -1
    shoulder = heads['upperarm_' + side]
    elbow = heads['lowerarm_' + side]
    wrist = heads['hand_' + side]
    axis = (wrist - elbow).normalized()
    across = axis.cross(Vector((0, -1, 0))).normalized()
    delta = point - elbow
    along = delta.dot(axis)
    cross = delta.dot(across)
    front = max(0, min(1, .58 - normal.y * .48))
    value = 0
    if delta.length < .175:
        # The inside elbow gathers into three unequal, tapered diagonal folds.
        for centre, slant, width, amplitude in ((-.036, .34, .015, .0100),
                                               (.011, -.30, .012, .0090),
                                               (.055, .24, .016, .0060)):
            curve = along - centre + cross * slant + .12 * cross * cross / .07
            value += amplitude * fold(curve, width) * bell(cross, .060) * front

    delta = point - wrist
    along = delta.dot(axis)
    if -.155 < along < -.074:
        # Soft cloth collects just above the sewn crimson facing.
        value += .0065 * fold(along + .103 + delta.dot(across) * .28, .013) * bell(delta.y, .052)

    # Short fans grow from the armhole into the chest, not around the arm.
    shoulder_z = shoulder.z
    x = abs(point.x)
    armhole = bell(x - .155, .072) * bell(point.z - (shoulder_z - .105), .087)
    forward = max(0, -normal.y)
    value += .0090 * fold(point.z - (shoulder_z - .102) + (x - .155) * .64, .017) * armhole * forward * max(0,min(1,(x-.10)/.060))
    value += .0060 * fold(point.z - (shoulder_z - .145) - (x - .140) * .38, .015) * armhole * forward * max(0,min(1,(x-.10)/.060))

    # The waist belt holds the hem. Small diagonal gathers taper into the
    # smooth chest panel and do not form horizontal bands around the torso.
    waist = bell(point.z - 1.110, .064) * bell(x - .083, .095) * forward
    value += .0095 * fold(point.z - 1.096 + (x - .060) * .27, .014) * waist
    value += .0065 * fold(point.z - 1.140 - (x - .090) * .35, .017) * waist
    value += .0050 * bell(x - (.101 + (point.z - 1.085) * .15), .010) * bell(point.z - 1.112, .039) * forward

    # Leave sewn neck and wrist boundary loops at their established positions.
    neck_fade = max(0, min(1, (1.478 - point.z) / .045))
    wrist_fade = max(0, min(1, (-along - .075) / .025)) if delta.length < .14 else 1
    return max(-.0050, min(.0100, value * neck_fade * wrist_fade))


def relax_neck_gathers(coat):
    """Spread narrow native neck valleys into the upper cloth, not its seam."""
    neighbours=[[] for _ in coat.data.vertices];edges={}
    for face in coat.data.polygons:
        ids=list(face.vertices)
        for a,b in zip(ids,ids[1:]+ids[:1]):
            key=tuple(sorted((a,b)));edges[key]=edges.get(key,0)+1
    boundary=set()
    for (a,b),count in edges.items():
        neighbours[a].append(b);neighbours[b].append(a)
        if count==1:boundary.update((a,b))
    original=[v.co.copy() for v in coat.data.vertices]
    amounts=[]
    for i,p in enumerate(original):
        if i in boundary or p.z>=1.525 or p.z<=1.365 or abs(p.x)>=.175 or p.y>=-.025:
            amounts.append(0);continue
        zfade=min(1,(1.528-p.z)/.015,(p.z-1.365)/.035)
        xfade=min(1,(.175-abs(p.x))/.035)
        amounts.append(.48*max(0,zfade)*max(0,xfade))
    for _ in range(8):
        prior=[v.co.copy() for v in coat.data.vertices]
        for i,(vertex,amount) in enumerate(zip(coat.data.vertices,amounts)):
            if not amount or not neighbours[i]:continue
            mean=sum((prior[j] for j in neighbours[i]),Vector())/len(neighbours[i])
            delta=prior[i].lerp(mean,amount)-original[i]
            if delta.length>.008:delta=delta.normalized()*.008
            vertex.co=original[i]+delta
    assert all((coat.data.vertices[i].co-original[i]).length==0 for i in boundary)
    coat.data.update()



def compression_relief(point, normal, heads):
    """A few broad, uneven tension rolls anchored at real cloth constraints."""
    def bell(value,width):return math.exp(-(value/width)**2)
    def fold(distance,width):
        return bell(distance-width*.34,width)-.40*bell(distance+width*.9,width*.82)
    def seam_roll(x,z,start,end,width,depth):
        dx,dz=end[0]-start[0],end[1]-start[1];length=math.hypot(dx,dz)
        t=((x-start[0])*dx+(z-start[1])*dz)/(length*length)
        if t<=0 or t>=1:return 0
        distance=((x-start[0])*(-dz)+(z-start[1])*dx)/length
        envelope=math.sin(math.pi*t)**.8
        return depth*fold(distance,width)*envelope
    old=_reference_relief(point,normal,heads)
    side='l' if point.x>0 else 'r';x=abs(point.x)
    front=max(0,-normal.y);value=0
    # Unequal pulls descend from the armhole into the unsupported front panel.
    # Each roll fades at both endpoints and never becomes a ring around a limb.
    if x<.215:
        if side=='r':
            value+=seam_roll(x,point.z,(.194,1.375),(.032,1.207),.027,.026)
            value+=seam_roll(x,point.z,(.178,1.267),(.025,1.134),.025,.023)
        else:
            value+=seam_roll(x,point.z,(.190,1.380),(.051,1.252),.027,.024)
            value+=seam_roll(x,point.z,(.162,1.246),(.023,1.139),.029,.021)
        # A short sideways gather is caught immediately above the waist belt.
        value+=seam_roll(x,point.z,(.170,1.098),(.026,1.126),.023,.024)
        value*=front
    elbow=heads['lowerarm_'+side];wrist=heads['hand_'+side]
    axis=(wrist-elbow).normalized();across=axis.cross(Vector((0,-1,0))).normalized()
    delta=point-elbow;along=delta.dot(axis);lateral=delta.dot(across)
    if delta.length<.19:
        facing=max(0,min(1,.55-normal.y*.50))
        value+=.022*fold(along+.032+lateral*.45,.035)*bell(lateral,.068)*facing
        value+=.016*fold(along-.045-lateral*.25,.030)*bell(lateral-.012,.058)*facing
    # Keep the accepted neck, shoulder board, belt and cuff contact bands.
    neck=max(0,min(1,(1.438-point.z)/.048))
    hem=max(0,min(1,(point.z-1.086)/.030))
    d=point-wrist;wrist_fade=max(0,min(1,(-(d.dot(axis))-.090)/.04)) if d.length<.15 else 1
    mix=neck*hem*wrist_fade
    return old*(1-mix)+max(-.005,min(.020,value))*mix
