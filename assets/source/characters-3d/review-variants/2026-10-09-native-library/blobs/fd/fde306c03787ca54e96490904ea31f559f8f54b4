"""Private Worker waistcoat: cut an actual continuous band from reduced shirt.

The shirt remains untouched. Triangle intersections carry its native weights;
only the waistcoat opening/armholes/hem and their 1.4 mm turned edges change.
"""
import math
import bpy,bmesh
from mathutils import Vector

def rebuild_worker_waistcoat(ctx,obj):
    coat=ctx['coat'];coat.data.calc_loop_triangles()
    names=[g.name for g in coat.vertex_groups]
    def vertex(index):
        v=coat.data.vertices[index]
        return (v.co.copy(),v.normal.copy(),{names[g.group]:g.weight for g in v.groups})
    def mix(a,b,t):
        keys=set(a[2])|set(b[2])
        return(a[0].lerp(b[0],t),a[1].lerp(b[1],t).normalized(),{k:a[2].get(k,0)*(1-t)+b[2].get(k,0)*t for k in keys})
    def clip(poly,f):
        result=[]
        for a,b in zip(poly,poly[1:]+poly[:1]):
            x,y=f(a[0]),f(b[0]);inside=x>=-1e-9
            if inside:result.append(a)
            if inside!=(y>=-1e-9):result.append(mix(a,b,x/(x-y)))
        return result
    def neck(p):
        front=max(0,min(1,(.01-p.y)/.10))
        limit=1.470*(1-front)+(1.285+1.85*abs(p.x))*front
        return limit-p.z
    constraints=[lambda p:p.z-1.010,lambda p:1.495-p.z,
                 lambda p:.187-.32*max(0,p.z-1.275)-abs(p.x),neck]
    coords=[];normals=[];weights=[];faces=[];cache={}
    def put(v):
        p,n,w=v;position=p+n*.003
        key=tuple(round(c,8)for c in p)
        if key not in cache:
            cache[key]=len(coords);coords.append(position);normals.append(n);weights.append(w)
        return cache[key]
    # A regular torso sheet bridges the source chest's collapsed anatomical
    # triangles. It samples the real shirt, but does not inherit its nipple
    # topology. Moderate smoothing acts only on this outer garment envelope.
    rings=37;columns=80;sample=[];radii=[]
    def surface_weights(point,face):
        poly=coat.data.polygons[face];ids=list(poly.vertices)[:3]
        a,b,c=[coat.data.vertices[i].co for i in ids]
        e=b-a;f=c-a;q=point-a;aa=e.dot(e);bb=e.dot(f);cc=f.dot(f);den=aa*cc-bb*bb
        v=(q.dot(e)*cc-q.dot(f)*bb)/den if abs(den)>1e-12 else 0
        w=(q.dot(f)*aa-q.dot(e)*bb)/den if abs(den)>1e-12 else 0
        factors=[max(0,1-v-w),max(0,v),max(0,w)];total=sum(factors);out={}
        for index,factor in zip(ids,factors):
            for g in coat.data.vertices[index].groups:out[names[g.group]]=out.get(names[g.group],0)+g.weight*factor/total
        return out
    for row in range(rings):
        z=1.007+.491*row/(rings-1);centre=Vector((0,-.025,z));values=[];weights_row=[]
        for column in range(columns):
            angle=math.tau*column/columns;direction=Vector((math.cos(angle),math.sin(angle),0))
            hit,q,n,face=coat.ray_cast(centre+direction*.28,-direction)
            if hit:
                radius=max(.055,(q-centre).dot(direction));weight=surface_weights(q,face)
            else:
                radius=radii[-1][column] if radii else .14;weight=sample[-1][column] if sample else {'spine_03':1}
            values.append(radius);weights_row.append(weight)
        radii.append(values);sample.append(weights_row)
    # Repeated local averaging removes anatomical pits without random folds.
    # Taper the effect near the upper/lower hems to keep the native fit.
    for iteration in range(7):
        next_radius=[list(row)for row in radii]
        for row in range(1,rings-1):
            for column in range(columns):
                average=(radii[row][(column-1)%columns]+radii[row][(column+1)%columns]+radii[row-1][column]+radii[row+1][column])*.25
                next_radius[row][column]=radii[row][column]*.40+average*.60
        radii=next_radius
    grid=[]
    for row in range(rings):
        z=1.007+.491*row/(rings-1);centre=Vector((0,-.025,z));line=[]
        for column in range(columns):
            angle=math.tau*column/columns;direction=Vector((math.cos(angle),math.sin(angle),0))
            line.append((centre+direction*radii[row][column],direction,sample[row][column]))
        grid.append(line)
    for row in range(rings-1):
        for column in range(columns):
            next_column=(column+1)%columns
            poly=[grid[row][column],grid[row][next_column],grid[row+1][next_column],grid[row+1][column]]
            for side in (-1,1):
                piece=clip(poly,lambda p:side*p.x)
                for constraint in constraints:
                    if len(piece)<3:break
                    piece=clip(piece,constraint)
                if len(piece)<3:continue
                ids=[put(v)for v in piece]
                for i in range(1,len(ids)-1):
                    tri=(ids[0],ids[i],ids[i+1])
                    if len(set(tri))==3 and (coords[tri[1]]-coords[tri[0]]).cross(coords[tri[2]]-coords[tri[0]]).length>1e-10:faces.append(tri)
    edges={}
    for f in faces:
        for a,b in zip(f,f[1:]+f[:1]):edges.setdefault(tuple(sorted((a,b))),[]).append((a,b))
    rim={}
    for edge,values in edges.items():
        if len(values)!=1:continue
        a,b=values[0]
        for i in (a,b):
            if i not in rim:
                rim[i]=len(coords);coords.append(coords[i]-normals[i]*.0014);normals.append(normals[i]);weights.append(dict(weights[i]))
        faces.append((b,a,rim[a],rim[b]))
    mesh=bpy.data.meshes.new('Worker_Waistcoat_Continuous');mesh.from_pydata(coords,[],faces);mesh.update();old=obj.data;obj.data=mesh
    mesh.materials.append(ctx['M']['trousers'])
    obj.vertex_groups.clear();groups={name:obj.vertex_groups.new(name=name)for name in sorted(set(k for w in weights for k in w))}
    for i,w in enumerate(weights):
        for name,amount in w.items():
            if amount>1e-7:groups[name].add([i],amount,'REPLACE')
    for f in mesh.polygons:f.use_smooth=len(f.vertices)==3
    colour=mesh.color_attributes.new(name='Human_Surface_Tone',type='FLOAT_COLOR',domain='POINT')
    for v,c in zip(mesh.vertices,colour.data):
        p=v.co;shade=.96+.02*math.sin(p.z*19+p.x*13)+.015*math.sin(p.z*37-p.y*17);c.color=(shade,shade,shade,1)
    mesh.color_attributes.active_color_index=0;mesh.color_attributes.render_color_index=0
    if old.users==0:bpy.data.meshes.remove(old)
    # The torso is clothed by the vest here. Keep the shirt at all visible
    # openings and a 12 mm seam overlap, but remove its occluded interior.
    # A duplicate independently interpolated cloth layer produces crossings
    # through the bent native chest even with matching rest normals/weights.
    bm=bmesh.new();bm.from_mesh(coat.data)
    hidden=[f for f in bm.faces if all(all(test(v.co)>.012 for test in constraints)for v in f.verts)]
    hidden_count=len(hidden);bmesh.ops.delete(bm,geom=hidden,context='FACES_ONLY')
    bm.to_mesh(coat.data);bm.free();coat.data.update()
    print('WORKER_HIDDEN_SHIRT_REMOVED',hidden_count,flush=True)
    print('WORKER_CONTINUOUS_WAISTCOAT',len(coords),len(faces),'boundary',len(rim),flush=True)
