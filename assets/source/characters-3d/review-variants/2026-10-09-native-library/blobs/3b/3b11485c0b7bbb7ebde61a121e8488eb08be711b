+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {writeFileSync} from 'node:fs';
+import {publishedActor} from './published-actor-fixture.mjs';
+import {AnimationMixer,LoopOnce,Vector3,Triangle,Ray,Box3} from '../web/node_modules/three/build/three.module.js';
+import {clone} from '../web/node_modules/three/examples/jsm/utils/SkeletonUtils.js';
+
+const ray=new Ray(),hit=new Vector3(),direction=new Vector3();
+function crosses(a,b){
+ for(let k=0;k<3;k++){
+  direction.subVectors(a[(k+1)%3],a[k]);const length=direction.length();
+  if(length<1e-12)continue;
+  ray.set(a[k],direction.divideScalar(length));
+  if(ray.intersectTriangle(...b,false,hit)){
+   const distance=hit.distanceTo(a[k]);
+   // Shared edges and tangent endpoints are contact, not a through-skin crossing.
+   if(distance>1e-6&&distance<length-1e-6)return true;
+  }
+ }
+ return false;
+}
+function surface(skin,side){
+ const g=skin.geometry,vertices=[];
+ for(let i=0;i<g.attributes.position.count;i++){
+  const rest=new Vector3().fromBufferAttribute(g.attributes.position,i),weights={};let total=0;
+  for(let k=0;k<4;k++){
+   const w=g.attributes.skinWeight.getComponent(i,k);
+   if(w>0){weights[skin.skeleton.bones[g.attributes.skinIndex.getComponent(i,k)].name]=w;total+=w;}
+  }
+  // Only identical native rest positions AND normalized weights form a UV seam.
+  // Never weld vertices merely because a posed thumb touches its index finger.
+  const seam=rest.toArray().map(x=>x.toFixed(7)).join(',')+'|'+Object.entries(weights).sort().map(([n,w])=>n+':'+(w/total).toFixed(6)).join(',');
+  vertices.push({rest,weights,seam});
+ }
+ const pattern=new RegExp(`^(hand|thumb_0[123]|index_0[123]|middle_0[123]|ring_0[123]|pinky_0[123])_${side}$`),faces=[];
+ for(let i=0;i<g.index.count;i+=3){
+  const ids=[g.index.getX(i),g.index.getX(i+1),g.index.getX(i+2)];
+  if(!ids.some(k=>Object.entries(vertices[k].weights).some(([n,w])=>pattern.test(n)&&w>.001)))continue;
+  faces.push({id:i/3,ids,seams:new Set(ids.map(k=>vertices[k].seam)),restArea:new Triangle(...ids.map(k=>vertices[k].rest)).getArea(),
+   web:ids.some(k=>(vertices[k].weights['thumb_01_'+side]??0)>.08)&&ids.some(k=>(vertices[k].weights['hand_'+side]??0)>.08),box:new Box3(),points:[]});
+ }
+ const web=faces.filter(f=>f.web),pairs=[];
+ assert.ok(web.length>100,'the test includes the connected thumb root, not just distal finger pads');
+ for(const a of web)for(const b of faces){
+  if(a.id>=b.id&&b.web)continue;
+  if([...a.seams].some(key=>b.seams.has(key)))continue;
+  pairs.push([a,b]);
+ }
+ const indices=[...new Set(faces.flatMap(f=>f.ids))],points=new Map(indices.map(i=>[i,new Vector3()]));
+ return {web,pairs,update(){
+  for(const i of indices)skin.localToWorld(skin.applyBoneTransform(i,points.get(i).copy(vertices[i].rest)));
+  for(const face of faces){face.points=face.ids.map(i=>points.get(i));face.box.setFromPoints(face.points);}
+ }};
+}
+const evidence=[];
+for(const preset of ['granadero','woman-scout'])for(const gesture of ['idle','walk','run']){
+ test(`${preset}: ${gesture} preserves the connected relaxed thumb web on both hands`,async()=>{
+  const asset=await publishedActor(preset,0),model=clone(asset.body.scene),name=`stand.${gesture}.unarmed`;
+  const clip=asset.animation.animations.find(c=>c.name===name);assert.ok(clip,name);
+  let skin;const bones={};model.traverse(o=>{if(o.isBone)bones[o.name]=o;if(o.isSkinnedMesh&&o.material.name==='Skin')skin=o;});assert.ok(skin);
+  const mixer=new AnimationMixer(model),action=mixer.clipAction(clip);action.setLoop(LoopOnce,1);action.clampWhenFinished=true;action.play();
+  const hands=Object.fromEntries(['l','r'].map(side=>[side,surface(skin,side)]));
+  // The thumb is held in one local pose, but the whole authored gait is sampled:
+  // actual skin matrices also include hand/forearm influences at the web boundary.
+  const samples=Math.ceil(clip.duration*120),rows={};
+  for(const side of ['l','r'])rows[side]={side,minimumAreaRatio:Infinity,maximumShaftBendDeg:0,maximumCrossingPairs:0};
+  for(let frame=0;frame<=samples;frame++){
+   const time=clip.duration*frame/samples;mixer.setTime(time);model.updateMatrixWorld(true);skin.skeleton.update();
+   for(const [side,hand]of Object.entries(hands)){
+    hand.update();const row=rows[side];let crossings=0;
+    for(const [a,b]of hand.pairs)if(a.box.intersectsBox(b.box)&&(crosses(a.points,b.points)||crosses(b.points,a.points)))crossings++;
+    const area=Math.min(...hand.web.map(f=>new Triangle(...f.points).getArea()/f.restArea));
+    const joints=[1,2,3].map(n=>bones[`thumb_0${n}_${side}`].getWorldPosition(new Vector3()));
+    const bend=joints[1].clone().sub(joints[0]).angleTo(joints[2].clone().sub(joints[1]))*180/Math.PI;
+    row.minimumAreaRatio=Math.min(row.minimumAreaRatio,area);row.maximumShaftBendDeg=Math.max(row.maximumShaftBendDeg,bend);row.maximumCrossingPairs=Math.max(row.maximumCrossingPairs,crossings);
+    if(crossings&&!row.firstCrossing)row.firstCrossing={time,count:crossings};
+   }
+  }
+  const result={preset,name,duration:clip.duration,samples:samples+1,hands:rows};evidence.push(result);
+  if(process.env.THUMB_WEB_REPORT)writeFileSync(process.env.THUMB_WEB_REPORT,JSON.stringify(evidence,null,2));
+  for(const row of Object.values(rows)){
+   assert.equal(row.maximumCrossingPairs,0,`${name} ${row.side}: connected web crosses other hand skin: ${JSON.stringify(row.firstCrossing)}`);
+   assert.ok(row.maximumShaftBendDeg<90,`${name} ${row.side}: thumb shaft folds back ${row.maximumShaftBendDeg.toFixed(2)} degrees`);
+   assert.ok(row.minimumAreaRatio>.15,`${name} ${row.side}: a web triangle collapses below 15% of its native area (${row.minimumAreaRatio})`);
+  }
+ });
+}
