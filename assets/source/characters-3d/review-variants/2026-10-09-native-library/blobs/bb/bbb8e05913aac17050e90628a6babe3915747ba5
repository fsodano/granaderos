 const asset=await publishedActor(appearance,lod),body=asset.body.scene,mixer=new AnimationMixer(body),clip=asset.animation.animations.find(c=>c.name==='prone.idle.unarmed'),action=mixer.clipAction(clip).setLoop(LoopOnce,1).play();action.clampWhenFinished=true;const parts=[];body.traverse(mesh=>{if(!mesh.isSkinnedMesh)return;const ix=mesh.geometry.attributes.skinIndex,w=mesh.geometry.attributes.skinWeight;for(let i=0;i<mesh.geometry.attributes.position.count;i++){let arm=0,dominant='',max=0;for(let j=0;j<4;j++){const n=mesh.skeleton.bones[ix.getComponent(i,j)].name,v=w.getComponent(i,j);if(/^(upperarm_|lowerarm_|hand_|thumb_|index_|middle_|ring_|pinky_)/.test(n)){arm+=v;if(v>max){max=v;dominant=n;}}}if(arm>.7)parts.push({mesh,i,dominant});}});
