 const visit=node=>{if(!node)return;if(Array.isArray(node)){node.forEach(visit);return;}if(node.type===ArchitectureVolume&&String(node.props.label).startsWith('chapel-corner-')){const p=node.props;parts.push({label:p.label,plan:p.points.map(point=>({u:(point.x-frame.origin.x)*frame.u.x+(point.y-frame.origin.y)*frame.u.y,v:(point.x-frame.origin.x)*frame.v.x+(point.y-frame.origin.y)*frame.v.y})),bottom:p.bottom,top:p.top,palette:p.palette,texture:p.texture,cap:p.cap});}visit(node.props?.children);};
 for(const object of buildingDetails({...b,walls:battle.tiles.filter(t=>t.buildingId===b.id)},new Set(),(x,y)=>({x:(x-y)*26,y:(x+y)*14})))visit(object.node);
 palettes.push({finish,sourceWallHeight:getBuildingProfile(b).wallHeight,parts});
}
console.log(JSON.stringify({source:'Current buildingDetails()/pier() and ArchitectureVolume()',tileMetres:T,verticalUnitsPerMetre:V,sourceStroke:{faceUnits:.45,capUnits:.5,faceDiameterMetres:.45/V,capDiameterMetres:.5/V},retainedNativeReliefMetres:.34*T-.09,maximumCapitalHullAboveActualHeightMetres:2.5/V+.25/V,palettes},null,2));
