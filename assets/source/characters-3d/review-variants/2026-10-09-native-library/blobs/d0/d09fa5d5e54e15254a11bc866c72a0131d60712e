"""Private shoulder padding topology/normal correction; no fit displacement."""
import bpy,bmesh,json
from pathlib import Path
from mathutils import Vector

def fit_epaulettes(ctx,lod):
    if ctx['preset'] not in ('granadero','royalist'):return
    rows=[]
    for o in ctx['objects']:
        if not o.name.startswith('Crimson_Epaulette_'):continue
        centre=sum((v.co for v in o.data.vertices),Vector())/len(o.data.vertices)
        before=sum(p.normal.dot(p.center-centre) for p in o.data.polygons)/len(o.data.polygons)
        bm=bmesh.new();bm.from_mesh(o.data)
        bmesh.ops.remove_doubles(bm,verts=list(bm.verts),dist=1e-7)
        bmesh.ops.recalc_face_normals(bm,faces=list(bm.faces))
        bm.normal_update();volume=bm.calc_volume(signed=True)
        if volume<0:bmesh.ops.reverse_faces(bm,faces=list(bm.faces))
        bm.to_mesh(o.data);bm.free();o.data.update()
        after=sum(p.normal.dot(p.center-centre) for p in o.data.polygons)/len(o.data.polygons)
        rows.append({'name':o.name,'meanRadialNormalBefore':before,'meanRadialNormalAfter':after,'vertices':len(o.data.vertices),'faces':len(o.data.polygons)})
    Path('/tmp/granadero-epaulette-fit-pilot/topology-'+ctx['preset']+'-lod'+str(lod)+'.json').write_text(json.dumps(rows,indent=2)+'\n')
    print('EPAULETTE_NORMALS',rows,flush=True)
