import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';
import {buildIdentity} from '../tools/build-identity.mjs';import {canonicalContent} from '../game/content-identity.js';import {decodeSave,encodeSave} from '../game/save.js';import {rosterFor,operativeLocation} from '../game/campaign.js';import {sectorInventoryModel} from '../game/sector-inventory.js';import {carriedAmmunition} from '../game/campaign-ammunition.js';import {unitAmmunitionByType,stackAmmunitionByType,addAmmoCounts} from '../game/physical-ammunition.js';import {ammoCount} from '../game/ammo-types.js';import {extractItemQuantity,handRecord} from '../game/tactical-inventory.js';import {WEAPONS} from '../game/tactical.js';import {contractExpiresSeconds} from '../game/contracts.js';
const d='/tmp/granaderos-stock-ending/',p=d+'stock-ensenada-friendly-supply',sha=t=>createHash('sha256').update(t).digest('hex'),input=d+'stock-ensenada-preparation-ready-accepted.save.json',output=p+'-accepted.save.json',inputText=fs.readFileSync(input),outputText=fs.readFileSync(output),a=decodeSave(inputText.toString()),b=decodeSave(outputText.toString()),receipt=JSON.parse(fs.readFileSync(p+'-receipt.json','utf8'));
assert.equal(sha(inputText),'35299b38e92affa4eeabb800ace2d039df3b3b5c9a3c894ad2a2ef3f0834dec4');assert.equal(sha(outputText),'2f0f72a66b10e83d4ca1b91bdcd4868cd89038a1abe30f75a4e4b3bab7ee0e4d');assert.deepEqual(decodeSave(encodeSave(b.campaign,b.battle)),b);assert.equal(b.battle,null);assert.equal(b.campaign.pendingBattle,null);assert.equal(b.campaign.pendingEncounter,null);
const force=[0,3,4,10,117,146],serving=a.campaign.recruited.filter(id=>a.campaign.operativeState[id].alive&&!a.campaign.operativeState[id].captured),dead=Object.keys(a.campaign.operativeState).map(Number).filter(id=>!a.campaign.operativeState[id].alive),clock=s=>s.hour*3600+s.secondOfHour;
function custody(s){const roster=rosterFor(s),ammunition={},guns=[];let dressings=0,ownedGuns=0,knownGuns=0;for(const id of serving){const m=sectorInventoryModel(s,operativeLocation(s,id),roster,id),u=carriedAmmunition(roster.find(o=>o.id===id),s.operativeState[id]);addAmmoCounts(ammunition,unitAmmunitionByType(u));dressings+=s.operativeState[id].medkits;for(const row of m.carried){const stack=extractItemQuantity(m.personal,row.item,row.count).stack;if(WEAPONS[stack.weapon]?.capacity>0){ownedGuns+=stack.count;const normalized=structuredClone(stack);delete normalized.item;guns.push(canonicalContent(normalized));}}}for(const sector of ['cordoba','buenos_aires'])for(const row of sectorInventoryModel(s,sector,roster,0).entries){const stack=JSON.parse(row.expected);addAmmoCounts(ammunition,stackAmmunitionByType(stack));if(stack.item==='medkits')dressings+=stack.count;if(WEAPONS[stack.weapon]?.capacity>0){knownGuns+=stack.count;const normalized=structuredClone(stack);delete normalized.item;guns.push(canonicalContent(normalized));}}return {ammunition,dressings,ownedGuns,knownGuns,totalGuns:ownedGuns+knownGuns,guns:guns.sort()};}
const before=custody(a.campaign),after=custody(b.campaign);assert.deepEqual(before,after,'All finite ammunition/dressings/guns remain exact in current living and two known-source pools.');assert.deepEqual(before.ammunition,{musket_75:167,pistol_69:74,rifle_62:48,shot_16:23});assert.equal(after.dressings,14);
for(const id of dead)assert.deepEqual(a.campaign.operativeState[id],b.campaign.operativeState[id]);assert.equal(dead.length,40);assert.deepEqual(a.campaign.operativeState[105],b.campaign.operativeState[105]);assert.deepEqual(a.campaign.contracts,b.campaign.contracts);assert.equal(a.campaign.seed,b.campaign.seed);for(const key of ['phase','flags','completed','defeated','artilleryDepot','equipmentShipments','loadouts'])assert.deepEqual(a.campaign[key],b.campaign[key]);assert.equal(b.campaign.phase,3);assert.equal(b.campaign.completed,false);assert.ok(b.campaign.squads.every(q=>!q.journey));
const chestId='buenos_aires:building:chest:10:4',oldChest=a.campaign.sectorStates.buenos_aires.props.find(p=>p.id===chestId),newChest=b.campaign.sectorStates.buenos_aires.props.find(p=>p.id===chestId),expected=structuredClone(oldChest);expected.contents[1].count-=17;expected.contents[3].count-=1;assert.deepEqual(newChest,expected,'Entire known chest changes only authorized17musket/1pistol debit.');assert.deepEqual(a.campaign.sectorStates.cordoba,b.campaign.sectorStates.cordoba,'Córdoba retained source custody is untouched.');
const roster=rosterFor(b.campaign),field=force.map(id=>{const op=roster.find(o=>o.id===id),r=b.campaign.operativeState[id],u=carriedAmmunition(op,r),oldU=carriedAmmunition(rosterFor(a.campaign).find(o=>o.id===id),a.campaign.operativeState[id]);assert.deepEqual(handRecord({...u,id:String(id)},'primary'),handRecord({...oldU,id:String(id)},'primary'),'Each readied gun/loaded charge retains full identity and profile.');assert.equal(u.loaded+ammoCount(u),12);assert.equal(operativeLocation(b.campaign,id),'buenos_aires');return {id,name:op.name,hp:r.hp,maxHp:r.maxHp,bleeding:r.bleeding,bandaged:r.bandaged,energy:r.energy,fatigue:r.fatigue,morale:r.morale,weapon:u.weapon,condition:u.condition,loaded:u.loaded,loose:ammoCount(u),typedAmmunition:unitAmmunitionByType(u),dressings:r.medkits,assignment:r.assignment,activeSlot:r.activeSlot};});assert.equal(field.reduce((sum,r)=>sum+r.loaded+r.loose,0),72);assert.equal(field.reduce((sum,r)=>sum+r.dressings,0),11);
const terms=serving.map(id=>{const e=contractExpiresSeconds(b.campaign.contracts[id]);assert.ok(e===null||e>clock(b.campaign));if(!force.includes(id))assert.equal(operativeLocation(b.campaign,id),operativeLocation(a.campaign,id));return {id,location:operativeLocation(b.campaign,id),expiresSecond:e,remainingSeconds:e===null?null:e-clock(b.campaign)};});
const money=receipt.events.map(e=>({index:e.index,action:e.action.type,hour:e.after.hour,second:e.after.secondOfHour,before:e.before.cash,after:e.after.cash,delta:e.after.cash-e.before.cash}));assert.deepEqual(money.map(e=>e.delta),[0,-10,0,8000,0,0,0,0,0]);assert.equal(b.campaign.resources.treasury,97970);assert.equal(clock(b.campaign)-clock(a.campaign),14400);assert.equal(b.campaign.townIncome.lastPaidDay,a.campaign.townIncome.lastPaidDay+1);assert.deepEqual(b.campaign.townIncome.activations,a.campaign.townIncome.activations);
const source=await buildIdentity(process.cwd());assert.deepEqual(source,receipt.source);const files=[...new Set(execFileSync('git',['ls-files','--cached','--others','--exclude-standard','-z','--','tests'],{encoding:'utf8'}).split('\0').filter(Boolean))].sort(),h=createHash('sha256');for(const path of files){h.update(path);h.update('\0');h.update(fs.readFileSync(path));h.update('\0');}assert.equal(files.length,883);assert.equal(h.digest('hex'),receipt.tests.digest);
const health=serving.map(id=>({id,before:{hp:a.campaign.operativeState[id].hp,energy:a.campaign.operativeState[id].energy,fatigue:a.campaign.operativeState[id].fatigue,morale:a.campaign.operativeState[id].morale},after:{hp:b.campaign.operativeState[id].hp,energy:b.campaign.operativeState[id].energy,fatigue:b.campaign.operativeState[id].fatigue,morale:b.campaign.operativeState[id].morale}})),territory=Object.keys(a.campaign.sectors).filter(id=>canonicalContent(a.campaign.sectors[id])!==canonicalContent(b.campaign.sectors[id])).map(id=>({id,before:a.campaign.sectors[id],after:b.campaign.sectors[id]}));
const audit={readOnly:true,input,inputHash:sha(inputText),output,outputHash:sha(outputText),source,tests:receipt.tests,fullReplay:receipt.fullReplay,newOrders:9,sourceBefore:oldChest,sourceAfter:newChest,exactAuthorizedDebits:{musket_75:17,pistol_69:1},before,after,field,fieldCompatibleRounds:72,fieldDressings:11,terms,health,territory,money,actualTimeSeconds:14400,arrivalNotice:b.campaign.travelNotice,dead,captive105Exact:true,originalContractsExact:true,gunsLoadProfilesExact:true,phase3Retained:true,seedExact:true,limits:'Stops in friendly Buenos Aires. Ensenada remains royalist/strength unknown; no queue, attack, new actors, medical action, gun/artillery pickup, supplies grant, shop, slope field or full-ending claim.'};const path=p+'-terminal-audit.receipt.json';assert.equal(fs.existsSync(path),false);fs.writeFileSync(path,JSON.stringify(audit,null,2)+'\n');console.log(JSON.stringify({path,hash:sha(fs.readFileSync(path)),before:{ammunition:before.ammunition,dressings:before.dressings,guns:before.totalGuns},after:{ammunition:after.ammunition,dressings:after.dressings,guns:after.totalGuns},field,terms,health,territory,money,fullReplay:receipt.fullReplay},null,2));
