const dir='/tmp/granaderos-stock-ending/',input=dir+'stock-tucuman-aid-accepted.save.json',target=dir+'stock-salta-recapture-reassignment-stopped.save.json',receipt=dir+'stock-salta-recapture-reassignment-stopped.receipt.json';
const sha=x=>createHash('sha256').update(x).digest('hex'),inputText=fs.readFileSync(input,'utf8'),targetText=fs.readFileSync(target,'utf8'),initial=decodeSave(inputText),accepted=decodeSave(targetText),prior=JSON.parse(fs.readFileSync(receipt,'utf8')),history=prior.history;
