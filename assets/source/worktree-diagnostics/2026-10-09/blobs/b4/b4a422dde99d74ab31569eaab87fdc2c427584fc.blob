import assert from 'node:assert/strict';
import fs from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {buildIdentity} from '../tools/build-identity.mjs';
import {encodeSave,decodeSave} from '../game/save.js';
import {dispatchCampaign} from '../game/campaign.js';
import {foundryFor} from '../game/campaign-foundry.js';
import {ownedArtilleryCount} from '../game/campaign-artillery.js';
import {enterSector} from '../game/world.js';
import {syncBattleTime} from '../game/time.js';
import {actBattle,presentedActBattle,createBattle} from '../game/tactical.js';
import {addIssuedGriefParticipant} from '../game/companion-grief.js';
import {addIssuedConductObserver} from '../game/service-objections.js';
import {applyQuestWithdrawalOrders} from '../game/quest-withdrawal.js';
import {applyQuestEscortOrders} from '../game/quest-escort.js';
import {projectDialogueMovements} from '../game/dialogue-movement.js';
const root=process.cwd(),dir='/tmp/granaderos-stock-ending/',prefix=dir+'stock-public-projects',input=dir+'stock-controlled-recovery-continuation-accepted.save.json';
const hash=data=>createHash('sha256').update(data).digest('hex'),inputText=fs.readFileSync(input,'utf8'),inputHash=hash(inputText);
assert.equal(inputHash,'0731f2e0b96332d2aaf5f02cbbf7315aedbecee641af3b588bffefb1a6c4fe2f');
assert.equal(fs.existsSync(prefix+'-before.save.json'),false,'Never overwrite an earlier project proof.');
const source=await buildIdentity(root);assert.equal(source.source,'7c9b603b2c65c3cd3c62a0ae97cb3a7885627380ffbdfb9eb5c1db18b23df07e');assert.equal(source.revision,'2bd8bb50f1910303433b53a7eaf7e69c979ba682');
const files=[...new Set(execFileSync('git',['ls-files','--cached','--others','--exclude-standard','-z','--','tests'],{encoding:'utf8'}).split('\0').filter(Boolean))].sort();
const testDigest=()=>{const h=createHash('sha256');for(const path of files){h.update(path);h.update('\0');h.update(fs.readFileSync(path));h.update('\0');}return h.digest('hex');};
const tests={count:files.length,digest:testDigest()};assert.deepEqual(tests,{count:883,digest:'003daf7b2d8a5d4ab59beb534efd19a0042577ca4d85c3cd30b55dddf59b2b46'});
let pair=decodeSave(inputText);const initial=structuredClone(pair),history=[],events=[];let attemptedAction=null,stage='admission';
const summary=s=>({hour:s.hour,secondOfHour:s.secondOfHour,cash:s.resources.treasury,phase:s.phase,flags:s.flags,reputation:s.reputation,mendoza:s.sectors.mendoza,ownedGuns:ownedArtilleryCount(s),passes:['uspallata','los_patos'].map(id=>({id,...s.sectors[id]})),completed:s.completed,pendingBattle:s.pendingBattle,pendingEncounter:s.pendingEncounter});
function official(p){const text=encodeSave(p.campaign,p.battle);assert.deepEqual(decodeSave(text),p);return text;}
function save(name){const text=official(pair);fs.writeFileSync(prefix+'-'+name+'.save.json',text);fs.writeFileSync(prefix+'-latest.save.json',text);fs.writeFileSync(prefix+'-history.json',JSON.stringify(history,null,2)+'\n');fs.writeFileSync(prefix+'-events.json',JSON.stringify(events,null,2)+'\n');return hash(text);}
function safe(){const s=pair.campaign;assert.equal(pair.battle,null);assert.equal(s.pendingBattle,null);assert.equal(s.pendingEncounter,null);assert.equal(s.defeated,false);assert.equal(s.completed,false);assert.equal(s.phase,3);assert.equal(ownedArtilleryCount(s),2);assert.equal(s.sectors.uspallata.owner,'royalist');assert.equal(s.sectors.los_patos.owner,'royalist');for(const key of ['hour','secondOfHour','seed','operativeState','recruited','squad','squads','activeSquadId','location','contracts','sectorStates','sceneStates','detentionRecords'])assert.deepEqual(s[key],initial.campaign[key],`Project must preserve ${key}`);}
function perform(p,step){
 if(step.kind==='campaign'){const next=dispatchCampaign(p.campaign,step.action);assert.equal(next.lastError,null,next.lastError);return {campaign:next,battle:next.pendingBattle?enterSector(next.pendingBattle,next.sectorStates[next.pendingBattle.sector]):null};}
 if(step.kind==='tactical'){const before=structuredClone(p.battle),next=actBattle(p.battle,step.action),shown=presentedActBattle(p.battle,step.action);assert.deepEqual(p.battle,before);assert.equal(next.lastError,null,next.lastError);assert.deepEqual(shown.state,next);const synced=syncBattleTime(p.campaign,next);assert.equal(synced.error,null,synced.error);return {campaign:synced.campaign,battle:synced.battle};}
 if(step.kind==='talk'){const npc=p.battle.npcs.find(n=>n.id===step.action.npcId),next=dispatchCampaign(p.campaign,{...step.action,sectorState:p.battle});assert.equal(next.lastError,null,next.lastError);assert.equal(next.lastConversation.outcome,'recruited');let updated=structuredClone(applyQuestWithdrawalOrders(next,projectDialogueMovements(next,applyQuestEscortOrders(next,p.battle))));updated.npcs=updated.npcs.filter(n=>n.id!==npc.id);const id=next.lastConversation.operativeId,issued=next.pendingBattle.squad.find(o=>o.id===id);assert.ok(issued&&npc);if(!updated.units.some(u=>Number(u.id)===id)){const unit=createBattle([issued],{width:p.battle.width,height:p.battle.height,enemies:[],exploration:true}).units.find(u=>u.side==='player'),joined={...unit,x:npc.x,y:npc.y};updated.units.push(joined);addIssuedGriefParticipant(updated,joined);addIssuedConductObserver(updated,joined);}return {campaign:next,battle:updated};}
 if(step.kind==='leave'){const next=dispatchCampaign(p.campaign,{type:'leaveSector',battleId:p.campaign.pendingBattle.id,sectorState:p.battle,survivors:p.battle.units.filter(u=>u.side==='player')});assert.equal(next.lastError,null,next.lastError);return {campaign:next,battle:null};}
 throw Error('Unknown recorded step.');
}
async function replayAll(){let p=decodeSave(fs.readFileSync(dir+'stock-salta-recapture-battle-continuation-settled.save.json','utf8'));const previous=[...JSON.parse(fs.readFileSync(dir+'stock-controlled-recovery-ten-orders-history.json','utf8')),...JSON.parse(fs.readFileSync(dir+'stock-controlled-recovery-continuation-history.json','utf8'))];assert.equal(previous.length,173);for(const step of previous){p=perform(p,step);assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);}assert.deepEqual(p,initial);for(const step of history){p=perform(p,step);assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);}assert.deepEqual(p,pair);return {original:10,recovery:163,projects:history.length,total:173+history.length,exact:true,ordinaryPresentedEqual:true,officialEveryAction:true};}
function receipt(error,replay,outputHash){return {input,inputHash,inputUnchanged:hash(fs.readFileSync(input))===inputHash,source,tests,stage,error,attemptedAction,history,events,fullReplay:replay,outputHash,before:summary(initial.campaign),after:summary(pair.campaign),debit:initial.campaign.resources.treasury-pair.campaign.resources.treasury,personnelCustodyTermsRngTimeExact:true,noMoreGameplay:true};}
try{
 safe();assert.equal(initial.campaign.flags.foundry,true);assert.equal(initial.campaign.flags.armyFunded,false);assert.equal(initial.campaign.flags.parliament,false);assert.equal(initial.campaign.sectors.mendoza.owner,'patriot');assert.equal(initial.campaign.sectors.mendoza.fort,0);assert.equal(initial.campaign.resources.treasury,93878);assert.equal(initial.campaign.hour,1577);assert.equal(initial.campaign.secondOfHour,3319);assert.equal(foundryFor(initial.campaign).fundingCost,3000);save('before');
 const orders=[{type:'fundArmy'},{type:'diplomacy',kind:'parliament'},{type:'fortify',sector:'mendoza'}],prices=[3000,200,150];
 for(let i=0;i<orders.length;i++){
  stage=orders[i].type;safe();save('pre-action');attemptedAction={kind:'campaign',action:orders[i]};const before=structuredClone(pair);pair=perform(pair,attemptedAction);assert.deepEqual(before,decodeSave(encodeSave(before.campaign,before.battle)));history.push(structuredClone(attemptedAction));events.push({index:i+1,action:orders[i],before:summary(before.campaign),after:summary(pair.campaign),newLog:pair.campaign.log.slice(0,Math.max(0,pair.campaign.log.length-before.campaign.log.length)),newCityEvents:pair.campaign.cityLoyaltyEvents.filter(e=>!before.campaign.cityLoyaltyEvents.some(p=>JSON.stringify(p)===JSON.stringify(e)))});save('order-'+(i+1));safe();assert.equal(before.campaign.resources.treasury-pair.campaign.resources.treasury,prices[i]);attemptedAction=null;console.log(JSON.stringify(events.at(-1)));
 }
 assert.equal(pair.campaign.flags.armyFunded,true);assert.equal(pair.campaign.flags.parliament,true);assert.equal(pair.campaign.sectors.mendoza.fort,1);assert.equal(initial.campaign.resources.treasury-pair.campaign.resources.treasury,3350);stage='full-replay';const replay=await replayAll();assert.equal(hash(fs.readFileSync(input)),inputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests.digest);const outputHash=save('accepted');fs.writeFileSync(prefix+'-receipt.json',JSON.stringify(receipt(null,replay,outputHash),null,2)+'\n');console.log(JSON.stringify({event:'publicProjectsAccepted',orders:history.length,fullReplay:replay,outputHash,...summary(pair.campaign)}));
}catch(error){let stoppedAdmissionError=null,outputHash=null,replay=null;try{outputHash=save('stopped');}catch(e){stoppedAdmissionError=e.stack;}try{replay=await replayAll();}catch(e){replay={error:e.stack};}assert.equal(hash(fs.readFileSync(input)),inputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests.digest);fs.writeFileSync(prefix+'-stopped.receipt.json',JSON.stringify({...receipt(error.stack,replay,outputHash),stoppedAdmissionError},null,2)+'\n');console.error(error.stack);process.exitCode=1;}
