import {chromium} from '/Users/fsodano/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright/index.mjs';
const browser=await chromium.launch({headless:true,executablePath:'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome'});const ctx=await browser.newContext({viewport:{width:1600,height:900}});const p=await ctx.newPage();
await p.goto('http://127.0.0.1:3210/',{waitUntil:'networkidle',timeout:120000});await p.getByRole('button',{name:'Combate de San Lorenzo ⚔',exact:true}).click();await p.waitForFunction(()=>{const c=document.querySelector('canvas[data-sector-renderer="three"]');return c?.dataset.loadedActors===c?.dataset.actors&&Number(c?.dataset.actors)>0&&c.dataset.pendingActors==='0'},{timeout:60000});await p.waitForTimeout(2000);
console.log((await p.locator('body').innerText()).slice(0,16000));await p.screenshot({path:'.cache/trailer-capture/battle-initial.png'});
await p.locator('[aria-label^="3. Lorenzo Barcala."]').click();await p.getByRole('button',{name:'Cámara',exact:true}).click();await p.getByRole('button',{name:'Acercar campo',exact:true}).click();await p.getByRole('button',{name:'Centrar cámara en el combatiente seleccionado',exact:true}).click();await p.getByRole('button',{name:'Cámara',exact:true}).click();await p.waitForTimeout(2000);await p.screenshot({path:'.cache/trailer-capture/battle-zoom.png'});
await p.getByRole('button',{name:'Cámara',exact:true}).click();await p.getByRole('button',{name:'Alejar campo',exact:true}).click();await p.getByRole('button',{name:'Alejar campo',exact:true}).click();await p.getByRole('button',{name:'Cámara',exact:true}).click();await p.waitForTimeout(1000);await p.screenshot({path:'.cache/trailer-capture/battle-wide.png'});console.log('UNITS',await p.locator('[data-unit-id]').evaluateAll(es=>es.map(e=>({id:e.getAttribute('data-unit-id'),label:e.querySelector('[aria-label]')?.getAttribute('aria-label'),position:e.getBoundingClientRect().toJSON()}))));console.log('OCCUPIED',await p.getByRole('button').evaluateAll(es=>es.map(e=>e.getAttribute('aria-label')).filter(t=>t&&/^[A-Z]+[0-9]+, /.test(t)&&!t.includes('accesible')&&!t.includes('obstáculo'))));await p.getByRole('button',{name:'Equipo',exact:true}).click();await p.screenshot({path:'.cache/trailer-capture/battle-equipment.png'});console.log('EQUIP',await p.locator('body').innerText());console.log('BUTTONS',await p.getByRole('button').evaluateAll(es=>es.map(e=>({name:e.getAttribute('aria-label')||e.textContent,disabled:e.disabled})).filter(e=>!e.name?.includes('accesible')).slice(0,100)));
await browser.close();
