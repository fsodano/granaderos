assert.deepEqual(p,before);assert.equal(sha(fs.readFileSync(input)),inputHash);
const report={mode:'read-only; no campaign/tactical orders',input,inputHash,inputUnchanged:true,sourceIdentity,tests,current:{hour:s.hour,secondOfHour:s.secondOfHour,dayTime:'17:55:19',cash:s.resources.treasury,phase:s.phase,pendingBattle:null,pendingEncounter:null,ensenada:s.sectors.ensenada,enemyStrength:'unknown; no Ensenada contact report',ammunitionStores:s.ammunitionStores,armoryItems:s.armoryItems,travelNotice:s.travelNotice,routes:s.routes,currentBAQuote:previewStrategicRoute(s,s.activeSquadId,'buenos_aires','posta')},personnel,knownSources,renewals,totalProspectiveRetentionCost:548,availableBulletinQuotes:available,
 plan:{recommendedExistingForce:ids,reason:'Replace unarmed, wounded, morale-zero Quiroga9 with actual local healthy skilled doctor10. The six-person cap is retained. Cabral3 and Ojeda117 still require real known-source gun recovery; four known cartridges deficits remain until actual allocation.',noNewHireRequired:true,recoveredGuns:[{recipient:3,source:cabralGun},{recipient:117,source:ojedaGun}],nativeStillOwnedGuns:[0,4,10,146],targetCompatibleRoundsPerPerson:12,exactProjectedCompatibleNeed:{musket:17,pistol:26},ammunitionSourcePlan:{cordobaPistol:localPistol.map(x=>({key:x.key,count:x.count,expected:x.expected})),buenosAiresMusket:{key:baMusket.key,count:17,sourceBefore:60,expected:baMusket.expected},buenosAiresPistol:{key:baPistol.key,count:1,sourceBefore:20,expected:baPistol.expected},distribution:{0:{family:'ammoMusket',take:5},3:{family:'ammoMusket',take:11,actualPickedLoad:1},117:{family:'ammoMusket',take:1,actualPickedLoad:1},4:{family:'ammoPistol',take:12},10:{family:'ammoPistol',take:12},146:{family:'ammoPistol',take:2}}},finiteDressingPlan:{sourceActor:0,sourceBefore:6,transferTo10:3,transferTo146:3,sourceAfter:0,fieldTotal:11,otherCarried:{3:2,4:2,117:1},noNewStock:true},boundedRestBeforeFormation:{suggestedHours:4,reason:'Use genuine rest to recover doctor146 energy and avoid immediate night entry; actual post-rest conditions and notice interruptions must be rechecked.'},formation:{reuseActiveSquad:s.activeSquadId,ids,returnToService:true,noNinthSquad:true},publicTravel:{legs:[{from:'cordoba',to:'buenos_aires',mode:'posta',hours:travelLegHours('cordoba','buenos_aires','posta'),cost:10},{from:'buenos_aires',to:'ensenada',mode:'posta',intent:'attack',hours:travelLegHours('buenos_aires','ensenada','posta'),cost:10}],nominalHours:8,nominalCost:20,nightArrivalWithoutRest:'01:55:19 next day',daylightExtraWithoutActionTimeSeconds:14681,afterFourHourRestMinimumExtraSeconds:281,actualGate:'Recompute actual clock; wait only in the friendly staging sector and stop on encounters/expiry/fatigue/failed source access.'},knownFixedProspectiveCost:568,cashAfterOnlyThoseKnownCosts:89960,earliestDeadlineAfterOneDayRetention:{hour:1618,second:1741,remainingAtCurrentSeconds:146022},limits:['No state changes or victory proof. Enemy positions and strength were not inspected.','The actual pickup profiles replace missing guns; they must not be compared to unowned canonical fallback profiles.','Current morale remains poor for0/117/146; four rest hours and legitimate pay do not restore high morale.','BA sources are already known but are not reachable now because no owned actor is present there; revalidate on real arrival.','No first-aid stroke is indicated now: all serving wounds are stable and bandaged. Care material must remain for real later injury.','Arsenal pieces require actual victory, a later actual exploration request, and observed chest opening; no third gun is owned now.']}};
