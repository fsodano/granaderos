const available=[138,132,106,143,118].map(id=>{const o=roster.find(o=>o.id===id),r=s.operativeState[id];return {id,name:o.name,recruited:s.recruited.includes(id),alive:r.alive,hp:r.hp,maxHp:r.maxHp,bleeding:r.bleeding,medical:o.medical,marksmanship:o.marksmanship,leadership:o.leadership,weapon:o.weapon,dayQuote:contractQuote(s,o,'day'),arrivalHours:hiringTravelHours(s,id),arrivalReason:hiringArrivalReason(s,'cordoba')};});
