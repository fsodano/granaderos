const dir='/tmp/granaderos-stock-ending/',input=dir+'stock-public-projects-accepted.save.json',output=dir+'stock-ensenada-readiness-audit.receipt.json',sha=x=>createHash('sha256').update(x).digest('hex');assert.equal(fs.existsSync(output),false);
const text=fs.readFileSync(input,'utf8'),inputHash=sha(text);assert.equal(inputHash,'acf5b17c5b96fa9d0638aab4b203d7c99cee171420dc13e3cacd682df7cbf017');
const p=decodeSave(text),before=structuredClone(p),s=p.campaign,roster=rosterFor(s),clock=s.hour*3600+s.secondOfHour;
assert.deepEqual(decodeSave(encodeSave(s,p.battle)),p);assert.equal(p.battle,null);assert.equal(s.pendingBattle,null);assert.equal(s.pendingEncounter,null);
const ids=[0,3,4,10,117,146],serving=roster.filter(o=>s.recruited.includes(o.id)&&s.operativeState[o.id]?.alive&&!s.operativeState[o.id].captured);
const personnel=serving.map(o=>{const r=s.operativeState[o.id],u=carriedAmmunition(o,r),w=weaponSpecification(u);return {id:o.id,name:o.name,location:operativeLocation(s,o.id),hp:r.hp,maxHp:r.maxHp,bleeding:r.bleeding,bandaged:r.bandaged,energy:r.energy,fatigue:r.fatigue,morale:r.morale,assignment:r.assignment,asleep:r.asleep,routed:r.routed??false,surrendered:r.surrendered??false,medical:o.medical,marksmanship:o.marksmanship,leadership:o.leadership,actualOwnedPrimary:!r.weaponDropped&&w?.capacity>0,weaponDropped:r.weaponDropped??false,primary:w&&{id:w.id,name:w.name,range:w.range,condition:r.condition,jammed:r.jammed,family:ammoTypeFor(u),loaded:u.loaded,compatibleReserve:ammoCount(u)},reserveByFamily:ammoStock(u),medkits:r.medkits,restRate:restRecovery(o,r,s),medicalHourlyRate:doctorRate(o,s),doctorReason:careAssignmentReason(s,o,'doctor'),contract:contractStatus(s,o.id),currentIssueMorale:ids.includes(o.id)?deploymentMorale(s,o.id,ids):null,capacity:ids.includes(o.id)?{additionalMedkits:supplyRoom(u,'medkits',6),additionalMusket:supplyRoom(u,'ammoMusket',20),additionalPistol:supplyRoom(u,'ammoPistol',20),overflow:personalPockets(u).overflow}:null};});
assert.equal(personnel.length,12);assert.ok(personnel.every(o=>o.bleeding===0));
const knownSources=['cordoba','buenos_aires','retiro'].map(at=>{const m=sectorInventoryModel(s,at,roster,at==='cordoba'?0:undefined);return {sector:at,operativeId:m.operativeId,accessReason:m.reason,rows:m.entries.filter(e=>{const q=JSON.parse(e.expected);return q.kind==='ammunition'||q.item==='medkits'||q.weapon>=1800&&q.weapon<=1808;}).map(e=>({...e,expectedSource:JSON.parse(e.expected)}))};});
const c=knownSources.find(x=>x.sector==='cordoba'),ba=knownSources.find(x=>x.sector==='buenos_aires'),source=(pool,key)=>{const r=pool.rows.find(r=>r.key===key);assert.ok(r);return r;};
const cabralGun=source(c,'drop:5'),ojedaGun=source(c,'ground:sector-item-14');assert.equal(cabralGun.expectedSource.weapon,1800);assert.equal(cabralGun.condition,98);assert.equal(cabralGun.loaded,1);assert.equal(ojedaGun.expectedSource.weapon,1803);assert.equal(ojedaGun.condition,99);assert.equal(ojedaGun.loaded,1);assert.ok(cabralGun.reachable&&ojedaGun.reachable);
const localPistolKeys=['["body","enemy-group-1-0","inventory:ammo:pistol_69"]','["body","enemy-0","inventory:ammo:pistol_69"]','container:cordoba:building:chest:17:1:2'];const localPistol=localPistolKeys.map(key=>source(c,key));assert.equal(localPistol.reduce((n,x)=>n+x.count,0),25);assert.ok(localPistol.every(x=>x.reachable));
const baMusket=source(ba,'container:buenos_aires:building:chest:10:4:1'),baPistol=source(ba,'container:buenos_aires:building:chest:10:4:3');assert.equal(baMusket.count,60);assert.equal(baPistol.count,20);
