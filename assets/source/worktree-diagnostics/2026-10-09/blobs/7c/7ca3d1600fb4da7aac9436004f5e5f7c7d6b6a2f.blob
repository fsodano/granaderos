import assert from 'node:assert/strict';import fs from 'node:fs';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';
import {buildIdentity} from '../tools/build-identity.mjs';import {encodeSave,decodeSave} from '../game/save.js';import {dispatchCampaign,rosterFor,operativeLocation} from '../game/campaign.js';import {contractQuote,contractExpiresSeconds} from '../game/contracts.js';
import {sectorInventoryModel} from '../game/sector-inventory.js';import {carriedAmmunition} from '../game/campaign-ammunition.js';import {unitAmmunitionByType,stackAmmunitionByType,addAmmoCounts} from '../game/physical-ammunition.js';import {ammoCount} from '../game/ammo-types.js';
import {inventoryUsage,equipmentFingerprint,handRecord} from '../game/tactical-inventory.js';import {handLayout} from '../game/hand-layout.js';import {equipmentCursorPreview,actBattle,presentedActBattle,createBattle} from '../game/tactical.js';import {enterSector} from '../game/world.js';import {syncBattleTime} from '../game/time.js';
import {previewStrategicRoute} from '../game/strategic-route.js';import {tooTiredToMarch} from '../game/march-fatigue.js';
import {addIssuedGriefParticipant} from '../game/companion-grief.js';import {addIssuedConductObserver} from '../game/service-objections.js';import {applyQuestWithdrawalOrders} from '../game/quest-withdrawal.js';import {applyQuestEscortOrders} from '../game/quest-escort.js';import {projectDialogueMovements} from '../game/dialogue-movement.js';
const dir='/tmp/granaderos-stock-ending/',prefix=dir+'stock-ensenada-daylight-approach',input=dir+'stock-ensenada-friendly-supply-accepted.save.json',sha=x=>createHash('sha256').update(x).digest('hex'),root=process.cwd();
const inputText=fs.readFileSync(input,'utf8'),inputHash=sha(inputText);assert.equal(inputHash,'2f0f72a66b10e83d4ca1b91bdcd4868cd89038a1abe30f75a4e4b3bab7ee0e4d');assert.equal(fs.existsSync(prefix+'-before.save.json'),false,'Never overwrite earlier proof.');
const source=await buildIdentity(root);assert.equal(source.source,'7c9b603b2c65c3cd3c62a0ae97cb3a7885627380ffbdfb9eb5c1db18b23df07e');assert.equal(source.revision,'2bd8bb50f1910303433b53a7eaf7e69c979ba682');
const files=[...new Set(execFileSync('git',['ls-files','--cached','--others','--exclude-standard','-z','--','tests'],{encoding:'utf8'}).split('\0').filter(Boolean))].sort(),statusBefore=execFileSync('git',['status','--porcelain'],{encoding:'utf8'});
function testDigest(){const h=createHash('sha256');for(const path of files){h.update(path);h.update('\0');h.update(fs.readFileSync(path));h.update('\0');}return h.digest('hex');}
const tests={count:files.length,digest:testDigest()};assert.deepEqual(tests,{count:883,digest:'003daf7b2d8a5d4ab59beb534efd19a0042577ca4d85c3cd30b55dddf59b2b46'});
let pair=decodeSave(inputText),history=[],events=[],stage='admission',attemptedAction=null,rejectedOutcome=null,renewalCost=0;let routePreview=null;const continuationStart=structuredClone(pair),originalInput=input,originalInputHash=sha(fs.readFileSync(originalInput)),priorPreparation=[...JSON.parse(fs.readFileSync(dir+'stock-ensenada-preparation-history.json','utf8')),...JSON.parse(fs.readFileSync(dir+'stock-ensenada-preparation-continuation-history.json','utf8')),...JSON.parse(fs.readFileSync(dir+'stock-ensenada-preparation-ready-history.json','utf8')),...JSON.parse(fs.readFileSync(dir+'stock-ensenada-friendly-supply-history.json','utf8'))],initial=structuredClone(pair);assert.equal(originalInputHash,'2f0f72a66b10e83d4ca1b91bdcd4868cd89038a1abe30f75a4e4b3bab7ee0e4d');assert.equal(priorPreparation.length,35);const proofInitial=initial,serving=pair.campaign.recruited.filter(id=>pair.campaign.operativeState[id].alive&&!pair.campaign.operativeState[id].captured),dead=Object.keys(pair.campaign.operativeState).map(Number).filter(id=>!pair.campaign.operativeState[id].alive),force=[0,3,4,10,117,146];assert.equal(dead.length,40);assert.equal(serving.length,12);
const c=()=>pair.campaign,clock=s=>s.hour*3600+(s.secondOfHour??0),roster=()=>rosterFor(c()),model=id=>sectorInventoryModel(c(),'buenos_aires',roster(),id),op=id=>roster().find(o=>o.id===id),owned=id=>carriedAmmunition(op(id),c().operativeState[id]);
function finiteLedger(s){const roster=rosterFor(s),ammo={};let dressings=0;for(const id of serving){const o=roster.find(o=>o.id===id),r=s.operativeState[id];addAmmoCounts(ammo,unitAmmunitionByType(carriedAmmunition(o,r)));dressings+=r.medkits;}const known=[];for(const sector of ['cordoba','buenos_aires'])for(const row of sectorInventoryModel(s,sector,roster,0).entries){const stack=JSON.parse(row.expected);addAmmoCounts(ammo,stackAmmunitionByType(stack));if(stack.item==='medkits')dressings+=stack.count;known.push({sector,key:row.key,count:row.count,expected:row.expected});}return {authority:'Current personal serving owners plus public already known Córdoba and Buenos Aires physical source rows. Returned living scene mirrors are not counted. Other sectors/captivity unchanged; no unseen/new enemies are counted.',ammunition:ammo,dressings,knownSources:known};}
const initialFinite=finiteLedger(initial.campaign);
function short(){return {hour:c().hour,secondOfHour:c().secondOfHour,cash:c().resources.treasury,location:c().location,pendingBattle:c().pendingBattle?.id??null,pendingEncounter:c().pendingEncounter,serving:serving.map(id=>{const r=c().operativeState[id];return {id,location:operativeLocation(c(),id),hp:r.hp,bleeding:r.bleeding,bandaged:r.bandaged,energy:r.energy,fatigue:r.fatigue,morale:r.morale,medkits:r.medkits,assignment:r.assignment,loaded:r.carriedLoaded,condition:r.condition,weaponDropped:r.weaponDropped,activeSlot:r.activeSlot,expiry:contractExpiresSeconds(c().contracts[id])};})};}
function official(p=pair){const text=encodeSave(p.campaign,p.battle);assert.deepEqual(decodeSave(text),p);return text;}
function save(name){const text=official();fs.writeFileSync(prefix+'-'+name+'.save.json',text);fs.writeFileSync(prefix+'-latest.save.json',text);fs.writeFileSync(prefix+'-history.json',JSON.stringify(history,null,2)+'\n');fs.writeFileSync(prefix+'-events.json',JSON.stringify(events,null,2)+'\n');return sha(text);}
function safe(){assert.equal(pair.battle,null);assert.equal(c().pendingBattle,null);assert.equal(c().pendingEncounter,null,'An unexpected encounter stops supply.');assert.equal(c().defeated,false);assert.equal(c().location,'buenos_aires','Approach remains at the origin until later confirmation.');for(const id of dead)assert.deepEqual(c().operativeState[id],initial.campaign.operativeState[id],`Dead${id} retained exactly.`);for(const id of serving){const r=c().operativeState[id],expiry=contractExpiresSeconds(c().contracts[id]);assert.ok(c().recruited.includes(id)&&r.alive&&!r.captured&&r.hp>=15&&!r.bleeding,`Serving${id} stays stable.`);assert.ok(expiry===null||expiry>clock(c()),`Serving${id} must not expire.`);if(!force.includes(id))assert.equal(operativeLocation(c(),id),operativeLocation(initial.campaign,id),'Only the approved six may travel.');}
 assert.deepEqual(c().operativeState[105],initial.campaign.operativeState[105],'Existing captive105 is exact.');for(const q of c().squads){if(q.journey){assert.equal(q.id,'squad-44');assert.ok(['moving','ready'].includes(q.journey.status),'A real paused route stops approach.');assert.deepEqual(q.journey.path,['buenos_aires','ensenada']);assert.equal(q.journey.intent,'attack');assert.equal(q.journey.returning,false);if(q.journey.status==='ready'){assert.equal(q.journey.reason,'assault');assert.equal(q.journey.elapsed,4);assert.equal(q.journey.elapsedSecond??0,0);}for(const id of q.members){assert.equal(c().operativeState[id].asleep,false,'Actual sleep interrupts this route.');assert.equal(tooTiredToMarch(c().operativeState[id]),false,'Actual fatigue interrupts this route.');}}}
 if(c().travelNotice){assert.equal(c().location,'buenos_aires');assert.ok(c().travelNotice.events?.length>0);for(const e of c().travelNotice.events){assert.equal(e.squadId,'squad-44');assert.equal(e.sector,'buenos_aires');}}
 const ledger=finiteLedger(c());assert.deepEqual(ledger.ammunition,initialFinite.ammunition,'No ammunition gain/spend in friendly supply.');assert.equal(ledger.dressings,initialFinite.dressings,'No dressing gain/spend in friendly supply.');}

function termBudget(seconds){for(const id of serving){const e=contractExpiresSeconds(c().contracts[id]);assert.ok(e===null||e>clock(c())+seconds,`Requote${id} before${seconds}s.`);}}
function perform(p,step){
 if(step.kind==='campaign'){const next=dispatchCampaign(p.campaign,step.action);if(next.lastError){rejectedOutcome={step,error:next.lastError,campaign:next,battle:p.battle};throw Error(next.lastError);}return {campaign:next,battle:next.pendingBattle?enterSector(next.pendingBattle,next.sectorStates[next.pendingBattle.sector]):null};}
 if(step.kind==='tactical'){const before=structuredClone(p.battle),next=actBattle(p.battle,step.action),shown=presentedActBattle(p.battle,step.action);assert.deepEqual(p.battle,before);assert.equal(next.lastError,null,next.lastError);assert.deepEqual(shown.state,next);const synced=syncBattleTime(p.campaign,next);assert.equal(synced.error,null,synced.error);return {campaign:synced.campaign,battle:synced.battle};}
 if(step.kind==='talk'){const npc=p.battle.npcs.find(n=>n.id===step.action.npcId),next=dispatchCampaign(p.campaign,{...step.action,sectorState:p.battle});assert.equal(next.lastError,null,next.lastError);assert.equal(next.lastConversation.outcome,'recruited');let updated=structuredClone(applyQuestWithdrawalOrders(next,projectDialogueMovements(next,applyQuestEscortOrders(next,p.battle))));updated.npcs=updated.npcs.filter(n=>n.id!==npc.id);const id=next.lastConversation.operativeId,issued=next.pendingBattle.squad.find(o=>o.id===id);assert.ok(issued&&npc);if(!updated.units.some(u=>Number(u.id)===id)){const unit=createBattle([issued],{width:p.battle.width,height:p.battle.height,enemies:[],exploration:true}).units.find(u=>u.side==='player'),joined={...unit,x:npc.x,y:npc.y};updated.units.push(joined);addIssuedGriefParticipant(updated,joined);addIssuedConductObserver(updated,joined);}return {campaign:next,battle:updated};}
 if(step.kind==='leave'){const next=dispatchCampaign(p.campaign,{type:'leaveSector',battleId:p.campaign.pendingBattle.id,sectorState:p.battle,survivors:p.battle.units.filter(u=>u.side==='player')});assert.equal(next.lastError,null,next.lastError);return {campaign:next,battle:null};}throw Error('Unknown recorded step.');
}
function raw(action,detail={}){safe();save('pre-action');attemptedAction={kind:'campaign',action:structuredClone(action)};const before=structuredClone(pair),previous=short();pair=perform(pair,attemptedAction);history.push(structuredClone(attemptedAction));events.push({index:history.length,stage,action,detail,before:previous,after:short()});fs.appendFileSync(prefix+'-accepted.jsonl',JSON.stringify(events.at(-1))+'\n');save('active');assert.deepEqual(before,decodeSave(encodeSave(before.campaign,before.battle)));safe();attemptedAction=null;console.log(JSON.stringify({event:'accepted',index:history.length,stage,action,hour:c().hour,second:c().secondOfHour,cash:c().resources.treasury}));}
function sourceTake(id,key,count){
 const row=model(id).entries.find(r=>r.key===key);assert.ok(row&&row.reachable,row?.reason??'Known source absent.');assert.ok(row.count>=count);const stack=JSON.parse(row.expected),prior=row.count,beforeOwner=unitAmmunitionByType(owned(id)),beforeKits=c().operativeState[id].medkits;
 let sourceProof=null;if(row.kind==='container'){const split=key.lastIndexOf(':'),sourceId=key.slice('container:'.length,split),index=Number(key.slice(split+1)),source=c().sectorStates.buenos_aires.props.find(p=>p.id===sourceId);assert.ok(source);assert.deepEqual(source.contents[index],stack);sourceProof={sourceId,index,before:structuredClone(source)};}
 raw({type:'sectorInventory',sector:'buenos_aires',operativeId:id,direction:'take',sourceKey:key,expected:row.expected,count},{sourceBefore:row,sourceProof});
 if(sourceProof){const expected=structuredClone(sourceProof.before);expected.contents[sourceProof.index].count-=count;if(!expected.contents[sourceProof.index].count)expected.contents.splice(sourceProof.index,1);assert.deepEqual(c().sectorStates.buenos_aires.props.find(p=>p.id===sourceProof.sourceId),expected,'Exact source-container contents debit, independent of index shift.');}
 else{const after=model(id).entries.find(r=>r.key===key)?.count??0;assert.equal(after,prior-count,'Exact stable source debit.');}
 const incoming={...stack,count},expectedAmmo={...beforeOwner};addAmmoCounts(expectedAmmo,stackAmmunitionByType(incoming));assert.deepEqual(unitAmmunitionByType(owned(id)),expectedAmmo,'Exact recipient ammunition custody.');if(stack.item==='medkits')assert.equal(c().operativeState[id].medkits,beforeKits+count);return incoming;
}
function recover(id,key){const keys=new Set(Object.keys(owned(id).inventory??{})),incoming=sourceTake(id,key,1),entry=model(id).carried.find(r=>r.inventoryKey&&!keys.has(r.inventoryKey)&&JSON.parse(r.expected??'null')?.weapon===incoming.weapon);assert.ok(entry,'The actual recovered gun has one new carried record.');raw({type:'sectorInventory',sector:'cordoba',operativeId:id,direction:'equip',inventoryKey:entry.inventoryKey,expected:entry.expected,slot:'primary'},{incoming,sourceKey:key});const equipped=handRecord(model(id).personal,'primary');for(const [key,value]of Object.entries(incoming))if(key!=='item')assert.deepEqual(equipped[key],value,`Actual source gun must preserve${key}.`);}
function giveDressings(id){const beforeKeys=new Set(model(0).entries.map(r=>r.key)),beforeKits=c().operativeState[0].medkits;raw({type:'sectorInventory',sector:'cordoba',operativeId:0,direction:'drop',item:'medkits',count:3});assert.equal(c().operativeState[0].medkits,beforeKits-3);const dropped=model(id).entries.find(r=>!beforeKeys.has(r.key)&&JSON.parse(r.expected).item==='medkits'&&r.count===3);assert.ok(dropped?.reachable,'The actual newly dropped dressings must be reachable.');sourceTake(id,dropped.key,3);assert.equal(c().operativeState[id].medkits,3);}
function loadStrategically(id,count){const m=model(id),u=m.personal,slots=inventoryUsage(u).slots,sourceSlot=slots.find(r=>r.entry?.item==='inventory:ammo:pistol_69');assert.ok(sourceSlot);const destinationId=handLayout(u).right==='primary'?'hand:right':slots.find(r=>r.entry?.item==='primary')?.id;assert.ok(destinationId,'Use the real worn/stowed gun endpoint.');const action={type:'dragEquipment',unitId:String(id),sourceId:sourceSlot.id,destinationId,count,expectedSource:equipmentFingerprint(u,sourceSlot.id),expectedDestination:equipmentFingerprint(u,destinationId)},context={mode:'exploration',phase:'player',status:'active',units:[u],equipmentContext:'campaign'},preview=equipmentCursorPreview(context,u,action);assert.ok(preview.valid,preview.reason);assert.equal(preview.operation,'reload');assert.equal(preview.rounds,count);assert.equal(preview.seconds,0);assert.equal(preview.pa,0);const {type,...rest}=action;raw({type:'sectorInventory',sector:'cordoba',operativeId:id,direction:'arrange',kind:'cursor',cursorAction:type,...rest},{publicPreview:preview,policy:'Actual free safe-map cursor load; no tactical AP/time claim.'});assert.equal(c().operativeState[id].carriedLoaded,count);assert.equal(c().operativeState[id].equipmentCursor,undefined);}
function readyPrimary(id){const m=model(id);if(handLayout(m.personal).right==='primary')return;const row=m.carried.find(r=>r.item==='primary');assert.ok(row?.mainhand?.valid,row?.mainhand?.reason??'Actual primary not readyable.');raw({type:'sectorInventory',sector:'cordoba',operativeId:id,direction:'equip',...row.mainhand.action},{realGunReady:true});assert.equal(handLayout(model(id).personal).right,'primary');}
async function replayAll(){let p=decodeSave(fs.readFileSync(dir+'stock-salta-recapture-battle-continuation-settled.save.json','utf8'));const prior=[...JSON.parse(fs.readFileSync(dir+'stock-controlled-recovery-ten-orders-history.json','utf8')),...JSON.parse(fs.readFileSync(dir+'stock-controlled-recovery-continuation-history.json','utf8')),...JSON.parse(fs.readFileSync(dir+'stock-public-projects-history.json','utf8'))];assert.equal(prior.length,176);for(const step of prior){p=perform(p,step);assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);}assert.deepEqual(p,decodeSave(fs.readFileSync(dir+'stock-public-projects-accepted.save.json','utf8')));for(const step of priorPreparation){p=perform(p,step);assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);}assert.deepEqual(p,continuationStart);for(const step of history){p=perform(p,step);assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);}assert.deepEqual(p,pair);return {prior:176,preparation:26,friendlySupply:9,daylightApproach:history.length,total:211+history.length,exact:true,officialEveryAction:true,priorTacticalOrdinaryPresentedEqual:true,newActionsAllStrategic:true};}
function receipt(error,replay,outputHash){return {input,inputHash,originalInput,originalInputHash,previousRecordedOrders:211,previousStopPreserved:true,inputUnchanged:sha(fs.readFileSync(input))===inputHash,source,tests,statusBefore,stage,error,attemptedAction,orders:history.length,totalRecordedOrders:211+history.length,history,events,force,renewalCost,routePreview,seconds:clock(c())-clock(initial.campaign),cashDelta:c().resources.treasury-initial.campaign.resources.treasury,before:{summary:shortFrom(initial),finite:initialFinite},after:{summary:short(),finite:finiteLedger(c())},priorDead:dead,originalServing:serving,fullReplay:replay,outputHash,limits:'281seconds of public friendly clock alignment, then one queued four-hour adjacent posta approach to Ensenada boundary. No assault confirmation/start, tactical scene, pickups, clinical work, renewal/hire/shop/shipping, new slope or cannon order. Hostile strength/positions remain unknown.'};}
function shortFrom(p){return {hour:p.campaign.hour,secondOfHour:p.campaign.secondOfHour,cash:p.campaign.resources.treasury,location:p.campaign.location};}
try{
 safe();assert.equal(c().resources.treasury,97970);assert.equal(c().hour,1585);assert.equal(c().secondOfHour,3319);assert.ok(c().travelNotice?.events?.length);assert.ok(c().squads.every(q=>!q.journey));assert.equal(c().activeSquadId,'squad-44');assert.deepEqual(c().squad,force);save('before');
 stage='actual-public-clock-alignment';termBudget(281+14400+600);const priorNotice=structuredClone(c().travelNotice),beforeClock=clock(c());raw({type:'advanceStrategicTime',seconds:281},{acknowledgesExistingArrivalNotice:priorNotice,policy:'Ordinary public clock; no manual notice/time mutation.'});assert.equal(clock(c())-beforeClock,281,'Stop if actual clock notice prevents the281-second advance.');assert.equal(c().hour,1586);assert.equal(c().secondOfHour,0);assert.equal(c().travelNotice,null,'The old arrival notice is acknowledged by the admitted public clock action.');assert.equal(c().assignmentAttention.notice,null);assert.equal(c().contractAttention.notice,null);assert.equal(c().logisticsNotice,null);save('actual-alignment');
 stage='public-adjacent-attack-intent-queue';routePreview=previewStrategicRoute(c(),'squad-44','ensenada','posta');assert.ok(routePreview.valid,routePreview.reason);assert.equal(routePreview.hours,4);assert.deepEqual(routePreview.path,['buenos_aires','ensenada']);assert.equal(routePreview.action.type,'attack');assert.equal(routePreview.action.queue,true);assert.equal(c().sectors.buenos_aires.owner,'patriot');assert.equal(c().sectors.ensenada.owner,'royalist');termBudget(14400+600);raw(routePreview.action,{publicRoute:routePreview,policy:'Queue only; no startAssault/confirmation/un-queued attack.'});save('actual-approach-queue');
 stage='four-real-public-clock-approach-hours';for(let i=0;i<4;i++){const q=c().squads.find(q=>q.id==='squad-44');assert.equal(q.journey.status,'moving','Stop before any extra wait at a ready boundary.');termBudget(3600+600);const prior=clock(c());raw({type:'advanceStrategicTime',seconds:3600});assert.equal(clock(c())-prior,3600,'An unexpected clock interrupt stops the admitted prefix.');if(i<3){assert.equal(c().travelNotice,null);assert.equal(c().squads.find(q=>q.id==='squad-44').journey.status,'moving');}assert.equal(c().assignmentAttention.notice,null);assert.equal(c().contractAttention.notice,null);assert.equal(c().logisticsNotice,null);save('actual-approach-hour-'+(i+1));}
 safe();const ready=c().squads.find(q=>q.id==='squad-44');assert.equal(ready.journey.status,'ready');assert.equal(c().hour,1590);assert.equal(c().secondOfHour,0);assert.equal(clock(c())-clock(initial.campaign),14681);assert.equal(c().resources.treasury,97960);assert.equal(c().location,'buenos_aires');assert.equal(c().pendingBattle,null);assert.equal(c().sectors.ensenada.owner,'royalist');for(const id of force){assert.equal(owned(id).loaded+ammoCount(owned(id)),12);assert.ok(owned(id).loaded>0&&!owned(id).weaponDropped);assert.equal(c().operativeState[id].assignment,'active');}assert.equal(force.reduce((sum,id)=>sum+c().operativeState[id].medkits,0),11);assert.equal(history.length,6);assert.equal(c().phase,3);assert.equal(c().completed,false);save('actual-ready-boundary');
 stage='full-prior-and-preparation-replay';const replay=await replayAll();assert.equal(sha(fs.readFileSync(input)),inputHash);assert.equal(sha(fs.readFileSync(originalInput)),originalInputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests.digest);assert.equal(execFileSync('git',['status','--porcelain'],{encoding:'utf8'}),statusBefore);const outputHash=save('accepted');fs.writeFileSync(prefix+'-receipt.json',JSON.stringify(receipt(null,replay,outputHash),null,2)+'\n');console.log(JSON.stringify({event:'ensenadaDaylightBoundaryAccepted',orders:history.length,renewalCost,routePreview,seconds:14681,outputHash,fullReplay:replay,summary:short(),finite:finiteLedger(c())}));
}catch(error){let outputHash=null,stoppedAdmissionError=null,replay=null;try{outputHash=save('stopped');}catch(e){stoppedAdmissionError=e.stack;fs.writeFileSync(prefix+'-unadmitted-outcome.json',JSON.stringify(pair,null,2)+'\n');}if(rejectedOutcome)fs.writeFileSync(prefix+'-rejected-outcome.json',JSON.stringify(rejectedOutcome,null,2)+'\n');try{replay=await replayAll();}catch(e){replay={error:e.stack};}assert.equal(sha(fs.readFileSync(input)),inputHash);assert.equal(sha(fs.readFileSync(originalInput)),originalInputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests.digest);fs.writeFileSync(prefix+'-stopped.receipt.json',JSON.stringify({...receipt(error.stack,replay,outputHash),stoppedAdmissionError},null,2)+'\n');console.error(error.stack);console.log(JSON.stringify({event:'ensenadaDaylightApproachStopped',stage,orders:history.length,outputHash,replay,summary:short()}));process.exitCode=1;}
