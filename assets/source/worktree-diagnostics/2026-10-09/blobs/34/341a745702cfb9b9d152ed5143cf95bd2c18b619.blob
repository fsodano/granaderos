import assert from 'node:assert/strict';
import {writeFileSync,readFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {initialCampaign,dispatchCampaign} from '../game/campaign.js';
import {defaultContentPackage} from '../game/content-package.js';
import {prepareCampaignBattle} from '../game/battle-handoff.js';
import {encodeSave,decodeSave} from '../game/save.js';
import {syncBattleTime} from '../game/time.js';
import {actBattle,presentedActBattle,endTurn,presentedEndTurn,getReachable,hasLineOfSight,actionCosts,reloadPlan,itemUsePreview,interruptAvailable} from '../game/tactical.js';
import {playerKnownBattle} from '../game/player-known-state.js';
import {sectorDeploymentModel} from '../game/sector-deployment.js';
import {targetPreview} from '../game/ja2-hud.js';

const prefix='/tmp/granaderos-wounded-native-approach',hash=text=>createHash('sha256').update(text).digest('hex');
const frozenFiles=['game/tactical.js','game/tactical-condition.js','game/weapon-reload.js','game/tactical-ai.js','game/maps.js','game/maps/buenos_aires.json'];
const digests=()=>Object.fromEntries(frozenFiles.map(path=>[path,hash(readFileSync(new URL('../'+path,import.meta.url)))]));
const frozen=digests(),initial=decodeSave(encodeSave(initialCampaign(8,defaultContentPackage()))),rawInitial=structuredClone(initial),history=[],records=[];
let pair=initial,publicMap=null,woundedId=null,shotDone=false,coverDone=false,partialDone=false,source=null;
const own=(battle=pair.battle)=>battle?.units.filter(u=>u.side==='player').map(u=>Object.fromEntries(['id','x','y','hp','maxHp','ap','energy','fatigue','bleeding','bandaged','shock','morale','stance','activeSlot','loaded','ammo','condition','medkits','reloadProgress','routed','unconscious','departure'].filter(k=>u[k]!==undefined).map(k=>[k,u[k]])))??[];
function save(label){const text=encodeSave(pair.campaign,pair.battle??null);assert.deepEqual(decodeSave(text),pair);writeFileSync(prefix+'-'+label+'.save.json',text);return hash(text);}
function record(kind,action,before,shown=null){
 const pub=pair.battle?playerKnownBattle(pair.battle):null,visible=new Set(pub?.units.map(u=>u.id));
 const evidence=shown?.frames.filter(f=>f.impacts?.some(i=>i.damage>0&&['110','107'].includes(i.unitId))).map(f=>({type:f.type,unitId:visible?.has(f.unitId)?f.unitId:null,impacts:f.impacts.filter(i=>['110','107'].includes(i.unitId)),shotVisual:f.shotVisual??null}));
 const row={number:history.length,kind,action,saveSHA:save(String(history.length).padStart(3,'0')),hour:pair.campaign.hour,second:pair.campaign.secondOfHour,cash:pair.campaign.resources.treasury,turn:pair.battle?.turn,mode:pair.battle?.mode,phase:pair.battle?.phase,status:pair.battle?.status,own:own(),observed:pub?.units.filter(u=>u.side==='enemy'),newLog:pair.battle?.log.slice(before.battle?.log.length??0),evidence};
 records.push(row);writeFileSync(prefix+'-history.json',JSON.stringify(history,null,2));writeFileSync(prefix+'-records.json',JSON.stringify(records,null,2));console.log(JSON.stringify(row));
}
function campaign(action){const before=pair,input=structuredClone(pair),next=dispatchCampaign(pair.campaign,action);if(next.lastError){writeFileSync(prefix+'-rejected.raw.json',JSON.stringify({action,result:next}));throw Error(next.lastError);}pair=decodeSave(encodeSave(next));assert.deepEqual(before,input);history.push({kind:'campaign',action});record('campaign',action,before);}
function handoff(){const before=pair,p=prepareCampaignBattle(pair.campaign,{placement:true});if(p.error)throw Error(p.error);pair=decodeSave(encodeSave(p.campaign,p.battle));history.push({kind:'handoff',options:{placement:true}});record('handoff',{placement:true},before);}
function tactical(action){
 const before=pair,input=structuredClone(pair),ending=action.type==='endTurn',ordinary=ending?endTurn(pair.battle):actBattle(pair.battle,action),shown=ending?presentedEndTurn(pair.battle):presentedActBattle(pair.battle,action);
 assert.deepEqual(shown.state,ordinary);assert.deepEqual(pair,input);
 if(ordinary.lastError){writeFileSync(prefix+'-rejected.raw.json',JSON.stringify({action,battle:ordinary}));throw Error(ordinary.lastError);}
 const p=syncBattleTime(pair.campaign,ordinary);if(p.error){writeFileSync(prefix+'-unadmitted.raw.json',JSON.stringify({action,p}));throw Error(p.error);}
 pair=decodeSave(encodeSave(p.campaign,p.battle));history.push({kind:'tactical',action});record('tactical',action,before,shown);
}
function view(){const k=playerKnownBattle(pair.battle),ids=new Set(k.units.map(u=>u.id)),props=new Set(k.props.map(p=>p.id));return {...pair.battle,units:pair.battle.units.filter(u=>u.side==='player'||ids.has(u.id)).map(u=>u.side==='player'?u:k.units.find(v=>v.id===u.id)),npcs:k.npcs,props:pair.battle.props.filter(p=>props.has(p.id)),tiles:pair.battle.tiles.filter(t=>publicMap.has(`${t.x},${t.y}`))};}
function moveToward(id,goal){const s=view(),u=s.units.find(u=>u.id===id),points=getReachable(s,u);points.sort((a,b)=>Math.hypot(a.x-goal.x,a.y-goal.y)-Math.hypot(b.x-goal.x,b.y-goal.y)||a.cost-b.cost||a.y-b.y||a.x-b.x);const destination=points.find(p=>p.path.length>0);if(!destination)return false;const step=destination.path.slice(0,3).reverse().map(p=>points.find(v=>v.x===p.x&&v.y===p.y&&(v.tacticalLevel??0)===(p.tacticalLevel??0))).find(p=>p?.cost>0&&p.cost<=24);if(!step)return false;tactical({type:'move',unitId:id,x:step.x,y:step.y,tacticalLevel:step.tacticalLevel??0});return true;}
function actual(){return pair.battle.units.find(u=>u.id===woundedId);}
function wounded(){return pair.battle.units.filter(u=>u.side==='player'&&u.hp>0&&u.hp<u.maxHp&&!u.unconscious&&!u.routed&&!u.departure).sort((a,b)=>Number(b.id==='110')-Number(a.id==='110'))[0];}
function coverCell(){const s=view(),u=s.units.find(u=>u.id===woundedId),known=playerKnownBattle(pair.battle).units.filter(u=>u.side==='enemy'&&u.hp>0&&!u.routed&&!u.unconscious),refs=source?[source,...known.filter(v=>v.id!==source.id)]:known;return getReachable(s,u).filter(p=>p.cost>0&&p.cost<=u.ap&&p.path.length<=3&&refs.length&&!hasLineOfSight(s,refs[0],{...u,...p})).sort((a,b)=>a.cost-b.cost||refs.filter(e=>hasLineOfSight(s,e,{...u,...a})).length-refs.filter(e=>hasLineOfSight(s,e,{...u,...b})).length||a.y-b.y||a.x-b.x)[0];}
function care(){const s=pair.battle,u=actual();if(!u.bleeding)return false;const doc=s.units.filter(v=>v.side==='player'&&v.hp>=15&&!v.unconscious&&!v.routed&&v.medkits>0&&v.medical>0&&interruptAvailable(s,v)).sort((a,b)=>b.medical-a.medical||String(a.id).localeCompare(String(b.id)))[0];if(!doc)return false;if(doc.activeSlot!=='medical'){if(doc.ap<actionCosts(s,doc).weapon)return false;tactical({type:'weapon',unitId:doc.id,slot:'medical'});}const current=pair.battle.units.find(v=>v.id===doc.id),plan=itemUsePreview(pair.battle,current,actual());if(!plan.valid)return false;tactical({type:'useItem',unitId:doc.id,targetId:woundedId});return true;}
async function replay(){let r=decodeSave(encodeSave(initial.campaign));for(const event of history){if(event.kind==='campaign'){const c=dispatchCampaign(r.campaign,event.action);assert.equal(c.lastError,null);r=decodeSave(encodeSave(c));}else if(event.kind==='handoff'){const p=prepareCampaignBattle(r.campaign,event.options);assert.equal(p.error,null);r=decodeSave(encodeSave(p.campaign,p.battle));}else{const ending=event.action.type==='endTurn',b=ending?endTurn(r.battle):actBattle(r.battle,event.action),p=syncBattleTime(r.campaign,b);assert.equal(b.lastError,null);assert.equal(p.error,null);r=decodeSave(encodeSave(p.campaign,p.battle));}}assert.deepEqual(r,pair);}

try{
 console.log(JSON.stringify({stage:'initial',head:'c27a7b3a30f751fb2c3df171be8dcb4e65845ecc',frozen,inputSHA:hash(encodeSave(initial.campaign)),scope:'One actual paid native BA approach, no geometry or actor-state boundary'}));
 for(const id of [110,107])campaign({type:'recruitCivic',id,term:'week'});campaign({type:'wait',hours:6});campaign({type:'attack',sector:'buenos_aires'});handoff();
 const model=sectorDeploymentModel(pair.battle);publicMap=new Set(model.cells.map(t=>`${t.x},${t.y}`));
 for(const id of ['110','107']){const edge=model.units.find(u=>u.id===id).edge,cells=model.entryCells[edge];const x=id==='110'?34:33,cell=cells.slice().sort((a,b)=>Math.abs(a.x-x)-Math.abs(b.x-x)||a.y-b.y)[0];tactical({type:'placeDeployment',unitIds:[id],...cell});}
 tactical({type:'confirmDeployment'});
 for(let n=0;n<60;n++){
  const s=pair.battle;if(s.status!=='active')throw Error('Actual terminal '+s.status);const living=s.units.filter(u=>u.side==='player'&&u.hp>0&&!u.unconscious&&!u.routed&&!u.departure);if(!living.length)throw Error('No capable survivor');
  if(s.phase!=='player'){tactical({type:'endTurn'});continue;}
  if(!woundedId){const u=wounded();if(u){woundedId=u.id;console.log(JSON.stringify({stage:'earned-wound',id:woundedId,own:own(),saveSHA:save('wounded')}));}else if(s.mode==='exploration'){const lead=living.find(u=>u.id==='110')??living[0];if(!moveToward(lead.id,{x:34,y:22}))throw Error('Native approach has no improving public route');const second=pair.battle.units.find(u=>u.id!=='110'&&u.side==='player');if(pair.battle.mode==='exploration'&&second?.hp>0&&!second.unconscious)moveToward(second.id,{x:34,y:23});continue;}else{tactical({type:'endTurn'});continue;}}
  const u=actual();if(!u||u.hp<15||u.unconscious||u.routed||u.departure)throw Error('The actual wounded actor cannot continue');
  if(!shotDone){const known=playerKnownBattle(s),targets=known.units.filter(v=>v.side==='enemy'&&v.hp>0&&!v.unconscious&&!v.routed).map(v=>({v,p:targetPreview(s,u,s.units.find(t=>t.id===v.id),{mode:'fire',aim:1})})).filter(x=>x.p?.valid);targets.sort((a,b)=>b.p.chance-a.p.chance||a.v.id.localeCompare(b.v.id));if(!targets.length){tactical({type:'endTurn'});continue;}source=structuredClone(targets[0].v);tactical({type:'fire',unitId:woundedId,targetId:source.id,aim:1});shotDone=true;if(actual().jammed)throw Error('Actual wounded shot misfired');continue;}
  if(!coverDone){const p=coverCell();if(!p)throw Error('No affordable public hard-cover cell after the aimed shot');tactical({type:'move',unitId:woundedId,x:p.x,y:p.y,tacticalLevel:p.tacticalLevel??0});const after=view();assert.equal(hasLineOfSight(after,source,actual()),false);coverDone=true;console.log(JSON.stringify({stage:'native-hard-cover',source,own:own(),cost:p.cost,path:p.path,saveSHA:save('covered')}));continue;}
  if(u.bleeding){if(care())continue;if(u.hp/u.bleeding<=2)throw Error('Actual bleed budget unsafe without affordable care');}
  if(u.activeSlot!=='primary'){if(u.ap<4){tactical({type:'endTurn'});continue;}tactical({type:'weapon',unitId:u.id,slot:'primary'});continue;}
  if(u.loaded){if(!partialDone)throw Error('No retained partial work was earned');assert.equal(u.ammo,8);await replay();assert.deepEqual(initial,rawInitial);assert.deepEqual(digests(),frozen);console.log(JSON.stringify({stage:'completed',accepted:history.length,own:own(),saveSHA:save('accepted'),exactReplay:true,inputUnchanged:true,frozenUnchanged:true}));break;}
  const plan=reloadPlan(u,s);if(!plan.available)throw Error('Actual reserve exhausted');if(!plan.pa){tactical({type:'endTurn'});continue;}tactical({type:'reload',unitId:u.id});if(!actual().loaded){partialDone=true;console.log(JSON.stringify({stage:'native-partial-reload',plan,own:own(),saveSHA:save('partial')}));}else if(!partialDone)throw Error('Native reload completed without a partial boundary');
  if(n===59)throw Error('Bounded native diagnostic exhausted');
 }
}catch(error){save('stopped');writeFileSync(prefix+'-stop.json',JSON.stringify({reason:error.message,history,records,frozen,own:own()},null,2));console.log(JSON.stringify({stage:'stopped',reason:error.message,accepted:history.length,own:own(),saveSHA:save('stopped')}));await replay();assert.deepEqual(initial,rawInitial);assert.deepEqual(digests(),frozen);console.log(JSON.stringify({stage:'stopped-replay',exact:true,inputUnchanged:true,frozenUnchanged:true}));process.exitCode=1;}
