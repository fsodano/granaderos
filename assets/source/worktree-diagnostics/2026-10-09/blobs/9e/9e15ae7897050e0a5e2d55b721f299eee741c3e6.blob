import fs from'node:fs';import assert from'node:assert/strict';import{createHash}from'node:crypto';import{decodeSave}from'../game/save.js';import{contractExpiresSeconds}from'../game/contracts.js';
const dir='/tmp/granaderos-stock-ending/',input=dir+'stock-tucuman-aid-accepted.save.json',pairPath=dir+'stock-salta-recapture-reassignment-stopped.save.json',auditPath=dir+'stock-salta-recapture-custody-audit.receipt.json',failed=dir+'stock-salta-recapture-reassignment-stopped.receipt.json',hash=x=>createHash('sha256').update(x).digest('hex'),before=decodeSave(fs.readFileSync(input,'utf8')),after=decodeSave(fs.readFileSync(pairPath,'utf8')),audit=JSON.parse(fs.readFileSync(auditPath,'utf8')),r=JSON.parse(fs.readFileSync(failed,'utf8'));
assert.equal(audit.ordersVerified,128);assert.equal(audit.admittedPairHash,hash(fs.readFileSync(pairPath)));const s=after.campaign,clock=s.hour*3600+s.secondOfHour;
const guns=c=>({depots:c.artilleryDepots,transfers:c.artilleryTransfers,stock:Object.fromEntries(Object.entries(c.sectorStates).map(([at,b])=>[at,b.artillery]))});assert.deepEqual(guns(before.campaign),guns(s));
const paid=r.events.filter(e=>e.event==='paidRenewal').reduce((n,e)=>n+e.price,0);assert.equal(paid,1356);const cashEvents=r.events.filter(e=>e.event==='acceptedOrder'&&e.before.cash!==e.after.cash),cashDelta=cashEvents.reduce((n,e)=>n+e.after.cash-e.before.cash,0);assert.equal(s.resources.treasury,before.campaign.resources.treasury+cashDelta);assert.equal(cashDelta,6584);
const terms=audit.serving.map(id=>({id,expiresAt:s.contracts[id]?.expiresAt??null,expiresSecond:s.contracts[id]?.expiresSecond??0,expiresSeconds:contractExpiresSeconds(s.contracts[id]),remainingSeconds:contractExpiresSeconds(s.contracts[id])===null?null:contractExpiresSeconds(s.contracts[id])-clock}));for(const t of terms)assert.ok(t.remainingSeconds===null||t.remainingSeconds>0);
const ammoMoves=r.events.filter(e=>e.event==='finitePickup'&&e.tag.startsWith('ammo')).reduce((n,e)=>(n[e.tag]=(n[e.tag]??0)+e.count,n),{});ammoMoves.ammoShot+=r.events.filter(e=>e.event==='finiteDepotTransfer'&&e.family==='ammoShot'&&e.direction==='take').reduce((n,e)=>n+e.n,0);assert.deepEqual(ammoMoves,{ammoPistol:13,ammoMusket:11,ammoRifle:5,ammoShot:12});
const dressingMoves=r.events.filter(e=>e.event==='finitePickup'&&e.tag==='dressings').reduce((n,e)=>n+e.count,0);assert.equal(dressingMoves,8);
const out={scope:'Single preparation continued from immutable accepted seven- then ten-order prefixes. No Salta combat actions.',source:audit.source,testsDigest:audit.testsDigest,testFiles:880,input,inputHash:audit.inputHash,preparedPair:pairPath,preparedPairHash:audit.admittedPairHash,custodyAudit:auditPath,priorStopsPreserved:[dir+'stock-salta-recapture-stopped.receipt.json',dir+'stock-salta-recapture-continuation-stopped.receipt.json',failed],orders:128,officialReplayEqual:true,ordinaryPresentedEqual:true,tacticalFrames:audit.frames,clock:{hour:s.hour,second:s.secondOfHour},elapsedSeconds:clock-(before.campaign.hour*3600+before.campaign.secondOfHour),cash:{initial:before.campaign.resources.treasury,renewalDebit:paid,postDebit:60,earnedPortIncome:8000,final:s.resources.treasury},priorDeaths:29,serving:21,allExistingHealthAndBleedingUnchanged:true,terms,finiteAmmunitionReallocation:ammoMoves,currentPhysicalAmmoTotals:audit.finalCorrected,currentPhysicalDressings:audit.finalDressings,finiteDressingReallocation:dressingMoves,field:r.summary.field,fieldCompatibleAmmunition:144,fieldDressings:r.summary.field.reduce((n,u)=>n+u.medkits,0),gunsExactUnchanged:true,loadProfileReceipts:audit.profileReceipts,initialBattle:{battleId:s.pendingBattle.id,daytime:!after.battle.night,status:after.battle.status,mode:after.battle.mode,phase:after.battle.phase,elapsedSeconds:after.battle.elapsedSeconds,playerIds:after.battle.units.filter(u=>u.side==='player'&&audit.profileReceipts.some(p=>String(p.id)===u.id)).map(u=>u.id)},oldProofFailureResolved:'Raw whole-scene count included historical departed records. Independently defined world/canonical ownership ledger proves128-event conservation; no refill or discarded duplicate counted as spend.'};assert.equal(out.initialBattle.elapsedSeconds,0);fs.writeFileSync(dir+'stock-salta-recapture-preparation-proof.receipt.json',JSON.stringify(out,null,2));console.log(JSON.stringify({receipt:dir+'stock-salta-recapture-preparation-proof.receipt.json',cash:out.cash,clock:out.clock,ammo:out.currentPhysicalAmmoTotals,dressings:out.currentPhysicalDressings,fieldDressings:out.fieldDressings,minPaidTermRemaining:Math.min(...terms.filter(t=>t.remainingSeconds!==null).map(t=>t.remainingSeconds)),battle:out.initialBattle},null,2));
