import fs from 'node:fs';
import assert from 'node:assert/strict';
import {buildIdentity} from '../tools/build-identity.mjs';
import {dispatchCampaign,rosterFor} from '../game/campaign.js';
import {encodeSave,decodeSave} from '../game/save.js';
import {enterSector} from '../game/world.js';
import {syncBattleTime} from '../game/time.js';
import {actBattle,presentedActBattle,itemUsePreview,exitPreview,getReachable,transferPreview} from '../game/tactical.js';
import {contractExpiresSeconds,contractQuote} from '../game/contracts.js';
import {expandCellScene} from '../game/cell-scene-storage.js';
import {sectorInventoryModel} from '../game/sector-inventory.js';
import {boundaryMatches} from '../game/tactical-exits.js';
import {spacePoint,sameSurface} from '../game/tactical-space.js';
const directory='/tmp/granaderos-stock-ending',source=`${directory}/stock-mendoza-settled.save.json`,original=decodeSave(fs.readFileSync(source,'utf8')).campaign,unchanged=structuredClone(original),identity=await buildIdentity(process.cwd());
const dead=Object.entries(original.operativeState).filter(([,r])=>!r.alive).map(([id])=>Number(id)),serving=original.recruited.filter(id=>original.operativeState[id].alive&&!original.operativeState[id].captured),history=[],notes=[];
let p={campaign:structuredClone(original),battle:null};
const now=c=>c.hour*3600+(c.secondOfHour??0);
function invariant(pair){for(const id of dead)assert.equal(pair.campaign.operativeState[id].alive,false,`prior death ${id}`);for(const id of serving){const r=pair.campaign.operativeState[id],contract=pair.campaign.contracts[id],expiry=contractExpiresSeconds(contract);assert.ok(pair.campaign.recruited.includes(id)&&r.alive&&!r.captured,`serving survivor ${id} must remain alive/free`);assert.ok(contract&&(expiry===null||expiry>now(pair.campaign)),`real contract ${id} must remain active`);}assert.equal(pair.campaign.pendingEncounter,null,'an actual encounter interrupts finite care');}
function canonical(c){const n=structuredClone(c);for(const key of ['sectorStates','sceneStates'])if(n[key])n[key]=Object.fromEntries(Object.entries(n[key]).map(([id,scene])=>[id,expandCellScene(scene)]));return n;}
function restored(pair){const raw=encodeSave(pair.campaign,pair.battle),r=decodeSave(raw);assert.deepEqual(canonical(r.campaign),canonical(pair.campaign));assert.deepEqual(r.battle,pair.battle);return r;}
function apply(pair,event,check=true){let n;
 if(event.kind==='campaign'){const c=dispatchCampaign(pair.campaign,event.action);assert.equal(c.lastError,null,JSON.stringify(event.action)+': '+c.lastError);n={campaign:c,battle:event.action.type==='visitSector'?enterSector(c.pendingBattle,c.sectorStates[c.location]):pair.battle};}
 else if(event.kind==='enter')n={campaign:pair.campaign,battle:enterSector(pair.campaign.pendingBattle,pair.campaign.sectorStates[pair.campaign.location])};
 else if(event.kind==='tactical'){const before=structuredClone(pair.battle),b=actBattle(pair.battle,event.action);assert.equal(b.lastError,null,JSON.stringify(event.action)+': '+b.lastError);assert.deepEqual(presentedActBattle(pair.battle,event.action).state,b);assert.deepEqual(pair.battle,before);const sync=syncBattleTime(pair.campaign,b);assert.equal(sync.error,null,sync.error);n={campaign:sync.campaign,battle:sync.battle};}
 else if(event.kind==='leave'){const c=dispatchCampaign(pair.campaign,{type:'leaveSector',battleId:pair.campaign.pendingBattle.id,sectorState:pair.battle,survivors:pair.battle.units.filter(u=>u.side==='player')});assert.equal(c.lastError,null,c.lastError);n={campaign:c,battle:null};}
 else throw Error('unknown event');
 invariant(n);return check?restored(n):n;
}
function issue(event){const before=[p.campaign.hour,p.campaign.secondOfHour],prior=p;p=apply(p,event);history.push(event);console.log('ORDER',JSON.stringify({n:history.length,event,clockBefore:before,clockAfter:[p.campaign.hour,p.campaign.secondOfHour],patients:[127,144,9,122,129].map(id=>({id,hp:p.campaign.operativeState[id].hp,bleeding:p.campaign.operativeState[id].bleeding,location:p.campaign.operativeState[id].location,medkits:p.campaign.operativeState[id].medkits}))}));return prior;}
const order=action=>issue({kind:'campaign',action}),tactical=action=>issue({kind:'tactical',action}),unit=id=>p.battle.units.find(u=>u.id===String(id));
function checkpoint(stage){p=restored(p);const path=`${directory}/stock-mendoza-care-strategic-${stage}.save.json`;fs.writeFileSync(path,encodeSave(p.campaign,p.battle));const note={stage,path,hour:p.campaign.hour,second:p.campaign.secondOfHour,treasury:p.campaign.resources.treasury,history:history.length,patients:[127,144,9,122,129].map(id=>({id,hp:p.campaign.operativeState[id].hp,bleeding:p.campaign.operativeState[id].bleeding,location:p.campaign.operativeState[id].location,medkits:p.campaign.operativeState[id].medkits}))};notes.push(note);console.log('CHECKPOINT',JSON.stringify(note));}
function renew(horizonHours=1){const until=now(p.campaign)+horizonHours*3600;for(const id of serving){let expiry=contractExpiresSeconds(p.campaign.contracts[id]);while(expiry!==null&&expiry<=until){const op=rosterFor(p.campaign).find(o=>o.id===id),contract=p.campaign.contracts[id],quote=contractQuote(p.campaign,op,'day'),cash=p.campaign.resources.treasury;assert.ok(quote.available&&cash>=quote.price);order({type:'renewContract',id,term:'day',expectedExpiresAt:contract.expiresAt,expectedExpiresSecond:contract.expiresSecond??0});assert.equal(p.campaign.resources.treasury,cash-quote.price);assert.equal(contractExpiresSeconds(p.campaign.contracts[id]),expiry+86400);expiry=contractExpiresSeconds(p.campaign.contracts[id]);}}}
function enter(){order({type:'visitSector'});}
function treat(doctorId,patientId){const u=unit(doctorId);if(u.activeSlot!=='medical')tactical({type:'weapon',unitId:u.id,slot:'medical'});const preview=itemUsePreview(p.battle,unit(doctorId),unit(patientId));console.log('CLINICAL_PLAN',JSON.stringify({doctorId,patientId,preview}));assert.ok(preview?.valid,preview?.reason);const before={kit:unit(doctorId).medkits,hp:unit(patientId).hp,bleed:unit(patientId).bleeding};tactical({type:'useItem',unitId:String(doctorId),targetId:String(patientId)});assert.equal(unit(doctorId).medkits,before.kit-1);assert.ok(unit(patientId).hp>before.hp||unit(patientId).bleeding<before.bleed);assert.ok(unit(patientId).hp>=15);assert.equal(unit(patientId).bleeding,0);}

console.log('SOURCE',JSON.stringify(identity));
history.push(...JSON.parse(fs.readFileSync(`${directory}/stock-mendoza-care-strategic-history.json`,'utf8')));assert.equal(history.length,23);
p=decodeSave(fs.readFileSync(`${directory}/stock-mendoza-care-strategic-rural-bandaged.save.json`,'utf8'));
for(const id of [144,127,9]){assert.ok(unit(id).hp>=15);assert.equal(unit(id).bleeding,0);}assert.equal(unit(146).medkits,0);
issue({kind:'leave'});checkpoint('accepted');
for(const id of [122,129,127,144,9]){assert.ok(p.campaign.operativeState[id].hp>=15);assert.equal(p.campaign.operativeState[id].bleeding,0);}
fs.writeFileSync(`${directory}/stock-mendoza-care-strategic-history.json`,JSON.stringify(history,null,2));
let replay={campaign:structuredClone(original),battle:null};for(const event of history)replay=apply(replay,event);assert.deepEqual(replay,p);assert.deepEqual(original,unchanged);assert.equal((await buildIdentity(process.cwd())).source,identity.source);
const medical=c=>serving.reduce((n,id)=>n+(c.operativeState[id].medkits??0),0),kits=c=>expandCellScene(c.sectorStates.mendoza).units.find(u=>u.id==='136').medkits;
const beforeMed=medical(original),afterMed=medical(p.campaign);assert.equal(beforeMed,29);assert.equal(afterMed,26);assert.equal(kits(original),6);assert.equal(kits(p.campaign),2);assert.equal(beforeMed+kits(original)-(afterMed+kits(p.campaign)),7);
const changed=[...serving].filter(id=>JSON.stringify(original.operativeState[id])!==JSON.stringify(p.campaign.operativeState[id]));
for(const id of serving){const before=original.operativeState[id],after=p.campaign.operativeState[id];for(const key of ['inventory','condition','rations','torches','boleadoras','weaponFittings','bladeMetadata','weaponMetadata','headwear','outfit','legwear','ammo','carriedAmmo','carriedLoaded','jammed'])assert.deepEqual(after[key],before[key],`nonmedical owned ${id}/${key} must remain exact`);assert.deepEqual(p.campaign.contracts[id],original.contracts[id]);}
const note={source,identity,accepted:`${directory}/stock-mendoza-care-strategic-accepted.save.json`,history:`${directory}/stock-mendoza-care-strategic-history.json`,events:history.length,fullReplay:true,ordinaryPresentedEqual:true,officialSaveEqualAfterLosslessCellExpansion:true,clock:{before:[original.hour,original.secondOfHour],after:[p.campaign.hour,p.campaign.secondOfHour]},cash:{before:original.resources.treasury,after:p.campaign.resources.treasury},care:{hourlyDressings:2,tacticalDressings:5,tacticalClinicalPA:100,actualSource:{body:'136',before:6,taken:4,remaining:2},livingDressingsBefore:beforeMed,livingDressingsAfter:afterMed},people:[122,129,127,144,9,146,107].map(id=>({id,hp:p.campaign.operativeState[id].hp,bleeding:p.campaign.operativeState[id].bleeding,bandaged:p.campaign.operativeState[id].bandaged,location:p.campaign.operativeState[id].location,medkits:p.campaign.operativeState[id].medkits,energy:p.campaign.operativeState[id].energy,practiceSeed:p.campaign.operativeState[id].practiceSeed})),priorDeaths:dead,noAdditionalDeath:true,contractsUnchanged:true,allNonmedicalOwnedEquipmentUnchanged:true,changed};
fs.writeFileSync(`${directory}/stock-mendoza-care-strategic-accepted.note.json`,JSON.stringify(note,null,2));console.log('DONE',JSON.stringify(note));
