import fs from 'node:fs';import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {execFileSync} from 'node:child_process';
import {canonicalContent} from '../game/content-identity.js';
import {buildIdentity} from '../tools/build-identity.mjs';import {decodeSave,encodeSave} from '../game/save.js';import {rosterFor,operativeLocation} from '../game/campaign.js';import {sectorInventoryModel} from '../game/sector-inventory.js';import {carriedAmmunition} from '../game/campaign-ammunition.js';import {unitAmmunitionByType,stackAmmunitionByType,addAmmoCounts} from '../game/physical-ammunition.js';import {ammoCount} from '../game/ammo-types.js';import {WEAPONS} from '../game/tactical.js';import {extractItemQuantity,handRecord} from '../game/tactical-inventory.js';import {contractExpiresSeconds} from '../game/contracts.js';
const dir='/tmp/granaderos-stock-ending/',sha=t=>createHash('sha256').update(t).digest('hex'),input=dir+'stock-public-projects-accepted.save.json',output=dir+'stock-ensenada-preparation-ready-accepted.save.json',inputText=fs.readFileSync(input),outputText=fs.readFileSync(output),a=decodeSave(inputText.toString()),b=decodeSave(outputText.toString());assert.equal(sha(inputText),'acf5b17c5b96fa9d0638aab4b203d7c99cee171420dc13e3cacd682df7cbf017');assert.equal(sha(outputText),'35299b38e92affa4eeabb800ace2d039df3b3b5c9a3c894ad2a2ef3f0834dec4');assert.deepEqual(decodeSave(encodeSave(b.campaign,b.battle)),b);
const serving=a.campaign.recruited.filter(id=>a.campaign.operativeState[id].alive&&!a.campaign.operativeState[id].captured),dead=Object.keys(a.campaign.operativeState).map(Number).filter(id=>!a.campaign.operativeState[id].alive),force=[0,3,4,10,117,146],clock=s=>s.hour*3600+s.secondOfHour;
function custody(s){const roster=rosterFor(s),ammunition={},gunProfiles=[];let dressings=0,ownedFirearms=0,knownFirearms=0;for(const id of serving){const m=sectorInventoryModel(s,operativeLocation(s,id),roster,id),u=carriedAmmunition(roster.find(o=>o.id===id),s.operativeState[id]);addAmmoCounts(ammunition,unitAmmunitionByType(u));dressings+=s.operativeState[id].medkits;for(const row of m.carried){const stack=extractItemQuantity(m.personal,row.item,row.count).stack;if(WEAPONS[stack.weapon]?.capacity>0){ownedFirearms+=stack.count;const normalized=structuredClone(stack);delete normalized.item;delete normalized.loaded;gunProfiles.push(canonicalContent(normalized));}}}for(const row of sectorInventoryModel(s,'cordoba',roster,0).entries){const stack=JSON.parse(row.expected);addAmmoCounts(ammunition,stackAmmunitionByType(stack));if(stack.item==='medkits')dressings+=stack.count;if(WEAPONS[stack.weapon]?.capacity>0){knownFirearms+=stack.count;const normalized=structuredClone(stack);delete normalized.item;delete normalized.loaded;gunProfiles.push(canonicalContent(normalized));}}return {ammunition,dressings,ownedFirearms,knownFirearms,totalFirearms:ownedFirearms+knownFirearms,gunProfiles:gunProfiles.sort()};}
const before=custody(a.campaign),after=custody(b.campaign);assert.deepEqual(before.ammunition,after.ammunition);assert.equal(before.dressings,after.dressings);assert.equal(before.totalFirearms,after.totalFirearms);assert.deepEqual(before.gunProfiles,after.gunProfiles,'Full metadata/condition gun multiset stays exact; loaded cartridges are accounted separately.');assert.equal(before.totalFirearms,48);assert.equal(before.ownedFirearms,8);assert.equal(after.ownedFirearms,10);assert.equal(after.knownFirearms,38);
for(const id of dead)assert.deepEqual(a.campaign.operativeState[id],b.campaign.operativeState[id]);assert.equal(dead.length,40);assert.deepEqual(a.campaign.operativeState[105],b.campaign.operativeState[105]);assert.equal(a.campaign.seed,b.campaign.seed);for(const key of ['phase','flags','completed','defeated','artilleryDepot','equipmentShipments'])assert.deepEqual(a.campaign[key],b.campaign[key]);
const contracts=serving.map(id=>{const old=contractExpiresSeconds(a.campaign.contracts[id]),next=contractExpiresSeconds(b.campaign.contracts[id]),expected=[116,117,146,127,144].includes(id)&&old!==null?old+86400:old;assert.equal(next,expected);assert.ok(next===null||next>clock(b.campaign));return {id,oldExpirySeconds:old,currentExpirySeconds:next,remainingSeconds:next===null?null:next-clock(b.campaign)};});
const roster=rosterFor(b.campaign),field=force.map(id=>{const op=roster.find(o=>o.id===id),r=b.campaign.operativeState[id],u=carriedAmmunition(op,r);assert.ok(u.loaded>0&&!u.weaponDropped);return {id,name:op.name,location:operativeLocation(b.campaign,id),hp:r.hp,maxHp:r.maxHp,bleeding:r.bleeding,bandaged:r.bandaged,energy:r.energy,fatigue:r.fatigue,morale:r.morale,medical:op.medical,weapon:u.weapon,condition:u.condition,loaded:u.loaded,loose:ammoCount(u),typedAmmunition:unitAmmunitionByType(u),dressings:r.medkits,assignment:r.assignment,activeSlot:r.activeSlot};});assert.equal(field.reduce((sum,r)=>sum+r.loaded+r.loose,0),54);assert.equal(field.reduce((sum,r)=>sum+r.dressings,0),11);
const health=serving.map(id=>({id,before:{hp:a.campaign.operativeState[id].hp,energy:a.campaign.operativeState[id].energy,fatigue:a.campaign.operativeState[id].fatigue,morale:a.campaign.operativeState[id].morale},after:{hp:b.campaign.operativeState[id].hp,energy:b.campaign.operativeState[id].energy,fatigue:b.campaign.operativeState[id].fatigue,morale:b.campaign.operativeState[id].morale}}));
const receipt=JSON.parse(fs.readFileSync(dir+'stock-ensenada-preparation-ready-receipt.json','utf8')),source=await buildIdentity(process.cwd());assert.deepEqual(source,receipt.source);const files=[...new Set(execFileSync('git',['ls-files','--cached','--others','--exclude-standard','-z','--','tests'],{encoding:'utf8'}).split('\0').filter(Boolean))].sort(),h=createHash('sha256');for(const path of files){h.update(path);h.update('\0');h.update(fs.readFileSync(path));h.update('\0');}assert.equal(files.length,883);assert.equal(h.digest('hex'),receipt.tests.digest);
const reports=['stock-ensenada-preparation-stopped.receipt.json','stock-ensenada-preparation-source-index-readonly-audit.receipt.json','stock-ensenada-preparation-continuation-stopped.receipt.json','stock-ensenada-preparation-continuation-packed-load-readonly-audit.receipt.json','stock-ensenada-preparation-ready-receipt.json'].map(path=>({path:dir+path,sha256:sha(fs.readFileSync(dir+path))}));
const audit={readOnly:true,input,output,inputHash:sha(inputText),outputHash:sha(outputText),source,tests:receipt.tests,fullReplay:receipt.fullReplay,preparationOrders:26,cost:548,timeSeconds:14400,clock:{hour:b.campaign.hour,second:b.campaign.secondOfHour},cash:{before:a.campaign.resources.treasury,after:b.campaign.resources.treasury},before,after,field,contracts,health,priorDead:dead,captive105Exact:true,seedUnchanged:true,fieldCompatibleRounds:54,fieldDressings:11,nextKnownSupplyNeedForTwelveEach:{musket_75:17,pistol_69:1},freeStrategicLoads:{Dorrego:2,Paroissien:1,Bellanger:1,paidAP:0,paidSeconds:0},restFacts:'Four ordinary hours; fatigue capacity caps Bellanger energy at84. Actual passive +1HP occurs for9/117/128/145, with no dressing spend. No clinical or full-health grant is claimed.',reports,limits:'Friendly Córdoba preparation only. No travel, combat, new supplies, weapon slope fields, shop, hire or cannon order. Both original checker stops are retained. This stage does not prove Ensenada victory or full ending.'};assert.equal(audit.cash.before-audit.cash.after,548);const file=dir+'stock-ensenada-preparation-terminal-audit.receipt.json';assert.equal(fs.existsSync(file),false);fs.writeFileSync(file,JSON.stringify(audit,null,2)+'\n');console.log(JSON.stringify({file,sha256:sha(fs.readFileSync(file)),outputHash:audit.outputHash,before:{ammunition:before.ammunition,dressings:before.dressings,knownFirearms:before.knownFirearms,ownedFirearms:before.ownedFirearms},after:{ammunition:after.ammunition,dressings:after.dressings,knownFirearms:after.knownFirearms,ownedFirearms:after.ownedFirearms},field,contracts,health,source,tests:receipt.tests,fullReplay:receipt.fullReplay},null,2));
