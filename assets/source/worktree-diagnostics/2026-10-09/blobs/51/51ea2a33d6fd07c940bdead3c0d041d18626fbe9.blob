import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createHash} from 'node:crypto';
import {buildIdentity} from '../tools/build-identity.mjs';
import {decodeSave,encodeSave} from '../game/save.js';
import {dispatchCampaign,rosterFor,operativeLocation} from '../game/campaign.js';
import {contractQuote,contractExpiresSeconds} from '../game/contracts.js';
import {sectorInventoryModel} from '../game/sector-inventory.js';
import {carriedAmmunition,ammunitionOrderQuote} from '../game/campaign-ammunition.js';
import {AMMO_KEYS,ammoTypeFor,ammoCount} from '../game/ammo-types.js';
import {AMMUNITION_FAMILIES} from '../game/ammunition-families.js';
import {addAmmoCounts,unitAmmunitionByType,fieldAmmunitionByType} from '../game/physical-ammunition.js';
import {applyItemQuantity} from '../game/tactical-inventory.js';
import {weaponSpecification} from '../game/weapon-definition.js';
import {enterSector} from '../game/world.js';
import {syncBattleTime} from '../game/time.js';
import {actBattle,presentedActBattle,reloadCost} from '../game/tactical.js';

const root=process.cwd(),input='/tmp/granaderos-stock-ending/stock-tucuman-aid-accepted.save.json',canonicalPrefix='/tmp/granaderos-stock-ending/stock-salta-recapture',resuming=process.argv[2]==='continue',prefix=canonicalPrefix+(resuming?'-continuation':'');
const inputText=fs.readFileSync(input,'utf8'),sha=value=>createHash('sha256').update(value).digest('hex'),inputHash=sha(inputText);
const initial=decodeSave(inputText),source=await buildIdentity(root),files=[];
function collect(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const f=path.join(dir,e.name);if(e.isDirectory())collect(f);else if(e.isFile())files.push(path.relative(root,f));}}
collect(path.join(root,'tests'));files.sort();const testDigest=()=>{const h=createHash('sha256');for(const f of files){h.update(f);h.update('\0');h.update(fs.readFileSync(path.join(root,f)));h.update('\0');}return h.digest('hex');};
const tests=testDigest();assert.equal(source.source,'b6d0d4ffc4ec228c2c8684f88d2ad247f8b2e63d694a324f83502abe47c71848');assert.equal(files.length,880);assert.equal(tests,'ea274572be1264a7be6744d9f5dd5d89d9081a1b9018f56c7fe5331374970f0a');
assert.equal(initial.battle,null);assert.equal(fs.existsSync(prefix+'-prepared.save.json'),false,'A successful admitted result is immutable.');
const old=initial.campaign,serving=old.recruited.filter(id=>old.operativeState[id].alive&&!old.operativeState[id].captured),dead=Object.keys(old.operativeState).map(Number).filter(id=>!old.operativeState[id].alive);
assert.equal(serving.length,21);assert.equal(dead.length,29);
const mendoza=[2,101,102,108,121,122,126,129,139],local=[105,109,130],field=[...mendoza,...local];
const stopped=resuming?JSON.parse(fs.readFileSync(canonicalPrefix+'-stopped.receipt.json','utf8')):null;
let pair=resuming?decodeSave(fs.readFileSync(canonicalPrefix+'-stopped.save.json','utf8')):structuredClone(initial),history=stopped?.history??[],events=stopped?.events??[],renewalCost=stopped?.renewalCost??0,frames=stopped?.frames??0,lastStage='before';
if(resuming){assert.equal(history.length,7);assert.equal(stopped.replayError,null);assert.equal(stopped.savedError,null);assert.equal(stopped.inputHash,inputHash);assert.equal(pair.campaign.hour,old.hour);assert.equal(pair.campaign.secondOfHour,old.secondOfHour);}
const c=()=>pair.campaign,clock=s=>s.hour*3600+(s.secondOfHour??0),r=id=>c().operativeState[id],op=id=>rosterFor(c()).find(o=>o.id===id),carried=id=>carriedAmmunition(op(id),r(id));
const unit=id=>pair.battle?.units.find(u=>u.side==='player'&&u.id===String(id));
const short=()=>({hour:c().hour,second:c().secondOfHour??0,cash:c().resources.treasury,location:c().location,pendingBattle:c().pendingBattle?.id??null,pendingEncounter:c().pendingEncounter,field:field.map(id=>{const u=unit(id)??carried(id);return{id,at:operativeLocation(c(),id),hp:u.hp,maxHp:u.maxHp,bleeding:u.bleeding??0,morale:u.morale,energy:u.energy,assignment:r(id).assignment,weapon:u.weapon,dropped:!!u.weaponDropped,condition:u.condition,loaded:u.loaded,ammo:ammoCount(u,ammoTypeFor(u)),family:ammoTypeFor(u),medkits:u.medkits,expiresAt:c().contracts[id]?.expiresAt??null,expiresSecond:c().contracts[id]?.expiresSecond??0};})});
function ledger(state){const ids=new Set(state.recruited.filter(id=>state.operativeState[id].alive&&!state.operativeState[id].captured).map(String)),total={};for(const id of ids){const o=rosterFor(state).find(o=>o.id===Number(id));addAmmoCounts(total,unitAmmunitionByType(carriedAmmunition(o,state.operativeState[id])));}for(const b of [...Object.values(state.sectorStates??{}),...Object.values(state.sceneStates??{})]){addAmmoCounts(total,fieldAmmunitionByType(b));for(const u of b.units??[])if(!ids.has(u.id))addAmmoCounts(total,unitAmmunitionByType(u));}for(const d of Object.values(state.ammunitionStores??{}))for(const [f,n]of Object.entries(d))addAmmoCounts(total,{[AMMUNITION_FAMILIES[f].type]:n});return Object.fromEntries(Object.values(AMMUNITION_FAMILIES).map(f=>[f.type,total[f.type]??0]));}
function dressings(state){const ids=new Set(state.recruited.filter(id=>state.operativeState[id].alive&&!state.operativeState[id].captured).map(String));let n=[...ids].reduce((n,id)=>n+(state.operativeState[id].medkits??0),0);for(const b of [...Object.values(state.sectorStates??{}),...Object.values(state.sceneStates??{})]){for(const u of b.units??[])if(!ids.has(u.id))n+=u.medkits??0;for(const g of b.groundItems??[])if(!g.heldBy)n+=g.type==='medkits'?g.count:g.item==='medkits'?g.count:0;for(const p of [...(b.props??[]),...(b.npcs??[])])for(const item of [...(p.contents??[]),...(p.questGifts??[])])if(item.item==='medkits')n+=item.count;}return n;}
const initialAmmo=ledger(old),initialDressings=dressings(old),initialGuns=structuredClone({depots:old.artilleryDepots,transfers:old.artilleryTransfers,stock:Object.fromEntries(Object.entries(old.sectorStates).map(([at,b])=>[at,b.artillery]))});
const native=new Map(field.map(id=>{const u=carriedAmmunition(rosterFor(old).find(o=>o.id===id),old.operativeState[id]);let sourceStack=null;if(u.weaponDropped){const m=sectorInventoryModel(old,operativeLocation(old,id),rosterFor(old),id),row=m.entries.find(e=>{const stack=JSON.parse(e.expected);return e.reachable&&stack.weapon===u.weapon&&stack.condition===u.condition;});assert.ok(row,'The replacement must have an original known finite matching source.');sourceStack=JSON.parse(row.expected);}return [id,{weapon:u.weapon,profile:weaponSpecification(sourceStack??u),condition:u.condition,...(sourceStack?{sourceStack}:{})}];}));
function save(stage){const text=encodeSave(c(),pair.battle),decoded=decodeSave(text);assert.deepEqual(decoded,pair);fs.writeFileSync(prefix+'-'+stage+'.save.json',text);fs.writeFileSync(prefix+'-latest.save.json',text);fs.writeFileSync(prefix+'-history.json',JSON.stringify(history,null,2));lastStage=stage;return decoded;}
function safe(){assert.equal(c().pendingEncounter,null,'An actual encounter stops preparation.');for(const id of dead)assert.equal(r(id).alive,false,`Prior casualty ${id} stays dead.`);for(const id of serving){assert.ok(c().recruited.includes(id)&&r(id).alive&&!r(id).captured,`Actual loss/service departure ${id} stops preparation.`);const u=unit(id)??r(id);assert.ok(u.hp>=15&&!u.bleeding,`Actual acute patient ${id} stops waits.`);const expiry=contractExpiresSeconds(c().contracts[id]);assert.ok(expiry===null||expiry>clock(c()),`Actual term ${id} expired.`);}}
function emit(kind,action,before){const after=short(),event={event:'acceptedOrder',kind,index:history.length,action:structuredClone(action),before,after};events.push(event);save('accepted');if(action.type==='wait'||action.type==='travel'||action.type==='attack'||kind==='leave'||action.type==='beginAssault')console.log(JSON.stringify({event:'accepted',kind,index:history.length,type:action.type,hour:after.hour,second:after.second,cash:after.cash,at:after.location,pending:after.pendingBattle}));}
function raw(action){assert.equal(pair.battle,null);const before=short(),next=dispatchCampaign(c(),action);assert.equal(next.lastError,null,JSON.stringify(action)+': '+next.lastError);pair={campaign:next,battle:next.pendingBattle?enterSector(next.pendingBattle,next.sectorStates[next.pendingBattle.sector]):null};history.push({kind:'campaign',action:structuredClone(action)});emit('campaign',action,before);safe();return c();}
function retain(seconds=3600){assert.equal(pair.battle,null);safe();for(const id of serving){let expiry=contractExpiresSeconds(c().contracts[id]);while(expiry!==null&&expiry<=clock(c())+seconds+1){const q=contractQuote(c(),op(id),'day'),oldExpiry=expiry,contract=c().contracts[id],money=c().resources.treasury;assert.ok(q.available&&money>=q.price,`Renewal ${id}: ${q.reason??'insufficient funds'}`);raw({type:'renewContract',id,term:'day',expectedExpiresAt:contract.expiresAt,expectedExpiresSecond:contract.expiresSecond??0});assert.equal(c().resources.treasury,money-q.price);assert.equal(contractExpiresSeconds(c().contracts[id]),oldExpiry+86400);renewalCost+=q.price;events.push({event:'paidRenewal',id,price:q.price,oldExpiry,newExpiry:contractExpiresSeconds(c().contracts[id])});expiry=contractExpiresSeconds(c().contracts[id]);}}}
function order(action){retain(action.type==='wait'?(action.hours??1)*3600:3600);return raw(action);}
function tactical(action){safe();for(const id of serving){const expiry=contractExpiresSeconds(c().contracts[id]);assert.ok(expiry===null||expiry>clock(c())+180,'A field order needs a quiet paid extension.');}const before=short(),original=structuredClone(pair.battle),ordinary=actBattle(pair.battle,action),shown=presentedActBattle(pair.battle,action);assert.equal(ordinary.lastError,null,JSON.stringify(action)+': '+ordinary.lastError);assert.deepEqual(shown.state,ordinary);assert.deepEqual(pair.battle,original);frames+=shown.frames.length;const synced=syncBattleTime(c(),ordinary);assert.equal(synced.error,null,synced.error);pair={campaign:synced.campaign,battle:synced.battle};history.push({kind:'tactical',action:structuredClone(action)});emit('tactical',action,before);safe();}
function leave(){const before=short(),action={type:'leaveSector',battleId:c().pendingBattle.id,sectorState:pair.battle,survivors:pair.battle.units.filter(u=>u.side==='player')},next=dispatchCampaign(c(),action);assert.equal(next.lastError,null,next.lastError);pair={campaign:next,battle:null};history.push({kind:'leave'});emit('leave',{type:'leaveSector'},before);safe();}
function select(id){order({type:'selectSquad',id});}
function model(at,id){const m=sectorInventoryModel(c(),at,rosterFor(c()),id);assert.equal(m.operativeId,id);assert.equal(m.reason,null,m.reason);return m;}
function rows(at,id,test){return model(at,id).entries.filter(row=>row.reachable&&test(JSON.parse(row.expected)));}
function pick(at,id,test,quantity,tag){while(quantity){const m=model(at,id),row=m.entries.find(row=>row.reachable&&test(JSON.parse(row.expected)));assert.ok(row,`Known finite ${tag} source exhausted at ${at}.`);const stack=JSON.parse(row.expected),n=Math.min(quantity,row.count);applyItemQuantity(m.personal,{...stack,count:n});const sourceBefore=m.entries.filter(e=>test(JSON.parse(e.expected))).reduce((n,e)=>n+e.count,0);order({type:'sectorInventory',sector:at,operativeId:id,direction:'take',sourceKey:row.key,expected:row.expected,count:n});const sourceAfter=model(at,id).entries.filter(e=>test(JSON.parse(e.expected))).reduce((n,e)=>n+e.count,0);assert.equal(sourceAfter,sourceBefore-n);events.push({event:'finitePickup',tag,at,id,count:n,sourceKey:row.key,stack,sourceBefore,sourceAfter});quantity-=n;}}
function pickAmmo(at,id,family,n){pick(at,id,stack=>stack.kind==='ammunition'&&stack.ammoType===AMMUNITION_FAMILIES[family].type,n,family);}
function transfer(id,family,n,direction){if(!n)return;const before=ammoCount(carried(id),family),stock=c().ammunitionStores[c().location]?.[family]??0,q=ammunitionOrderQuote(c(),op(id),family,n,direction,true);assert.ok(q.available,q.reason);order({type:'ammunition',operativeId:id,family,quantity:n,direction});assert.equal(ammoCount(carried(id),family),before+(direction==='take'?n:-n));assert.equal(c().ammunitionStores[c().location][family],stock+(direction==='take'?-n:n));events.push({event:'finiteDepotTransfer',id,family,n,direction,at:c().location});}
function topUp(id,at,{required=false}={}){const family=ammoTypeFor(carried(id));let need=Math.max(0,12-carried(id).loaded-ammoCount(carried(id),family));const depot=Math.min(need,c().ammunitionStores[at]?.[family]??0);if(depot){transfer(id,family,depot,'take');need-=depot;}const known=rows(at,id,s=>s.kind==='ammunition'&&s.ammoType===AMMUNITION_FAMILIES[family].type).reduce((n,e)=>n+e.count,0),take=Math.min(need,known);if(take)pickAmmo(at,id,family,take);if(required)assert.ok(carried(id).loaded+ammoCount(carried(id),family)>=12,`Actual compatible rounds missing for ${id}.`);}
function rearm(id){if(!r(id).weaponDropped)return;const at=operativeLocation(c(),id),original=carried(id),m=model(at,id),row=m.entries.find(row=>{const s=JSON.parse(row.expected);return row.reachable&&s.weapon===original.weapon&&s.condition===original.condition;});assert.ok(row,`Known matching native firearm missing for ${id}.`);const stack=JSON.parse(row.expected);order({type:'sectorInventory',sector:at,operativeId:id,direction:'take',sourceKey:row.key,expected:row.expected,count:1});const held=model(at,id).carried.find(e=>e.expected&&JSON.parse(e.expected).weapon===original.weapon&&e.equip?.some(a=>a.slot==='primary'&&a.valid));assert.ok(held,'The recovered actual gun must be equipable.');order({type:'sectorInventory',sector:at,operativeId:id,direction:'equip',inventoryKey:held.inventoryKey,expected:held.expected,slot:'primary'});assert.equal(carried(id).weapon,original.weapon);assert.equal(carried(id).condition,original.condition);assert.equal(carried(id).weaponDropped,false);assert.deepEqual(weaponSpecification(carried(id)),native.get(id).profile);events.push({event:'nativeGunRecovered',id,at,sourceKey:row.key,stack});}
function ready(ids){for(const id of ids){if(r(id).asleep)order({type:'setSleep',operativeId:id,asleep:false});if(r(id).assignment!=='active')order({type:'assignCare',operativeId:id,assignment:'active'});}}
function travel(squadIds,destination,intent='travel'){for(const id of squadIds){select(id);ready(c().squad);retain(4*3600);order({type:intent==='attack'?'attack':'travel',sector:destination,mode:'posta',queue:true});}for(let h=0;h<12;h++){const qs=squadIds.map(id=>c().squads.find(q=>q.id===id));if(qs.every(q=>intent==='attack'?q.journey?.status==='ready':q.location===destination&&!q.journey))return;assert.ok(qs.every(q=>!q.journey||['moving','ready'].includes(q.journey.status)),'An actual paused journey stops preparation.');order({type:'wait',hours:1});}throw Error('The bounded four-hour road stage did not finish.');}
function reloadSquad(id){select(id);ready(c().squad);const need=c().squad.filter(id=>{const u=carried(id);return u.jammed||u.loaded<weaponSpecification(u).capacity;});if(!need.length)return;retain(3600);order({type:'visitSector'});assert.equal(pair.battle.mode,'exploration');for(const id of need){let u=unit(id);if(u.activeSlot!=='primary')tactical({type:'weapon',unitId:u.id,slot:'primary'});u=unit(id);if(u.jammed)tactical({type:'reprime',unitId:u.id});u=unit(id);if(u.loaded<weaponSpecification(u).capacity){const cost=reloadCost(u,pair.battle),total=u.loaded+u.ammo;assert.ok(cost>0,'An actual empty primary must have a paid reload.');tactical({type:'reload',unitId:u.id});assert.equal(unit(id).loaded+unit(id).ammo,total);assert.equal(unit(id).reloadProgress,undefined);events.push({event:'paidReload',id,profilePA:cost,loaded:unit(id).loaded,ammo:unit(id).ammo});}}leave();}
function finalInvariants(){safe();assert.deepEqual(ledger(c()),initialAmmo,'All physical ammunition families stay conserved.');assert.equal(dressings(c()),initialDressings,'All finite dressings stay conserved.');assert.deepEqual({depots:c().artilleryDepots,transfers:c().artilleryTransfers,stock:Object.fromEntries(Object.entries(c().sectorStates).map(([at,b])=>[at,b.artillery]))},initialGuns,'Preparation does not move or refill a gun.');for(const id of serving){assert.equal(r(id).hp,old.operativeState[id].hp,'Preparation preserves all actual HP.');assert.equal(r(id).bleeding,old.operativeState[id].bleeding);for(const slot of ['headwear','outfit','legwear'])assert.deepEqual(r(id)[slot],old.operativeState[id][slot]);}for(const id of field){const u=carried(id),n=native.get(id);assert.equal(u.weapon,n.weapon);assert.equal(u.condition,n.condition);assert.deepEqual(weaponSpecification(u),n.profile,'Old pinned load metadata remains unchanged.');assert.ok(!u.weaponDropped&&u.loaded+ammoCount(u,ammoTypeFor(u))>=12);assert.equal(weaponSpecification(u).materialRangeSlope,undefined,'Do not add new authored penetration slopes.');}}
async function verifyReplay(){let p=decodeSave(inputText);for(const step of history){if(step.kind==='campaign'){const n=dispatchCampaign(p.campaign,step.action);assert.equal(n.lastError,null,JSON.stringify(step.action)+': '+n.lastError);p={campaign:n,battle:n.pendingBattle?enterSector(n.pendingBattle,n.sectorStates[n.pendingBattle.sector]):null};}else if(step.kind==='tactical'){const n=actBattle(p.battle,step.action);assert.equal(n.lastError,null);const s=syncBattleTime(p.campaign,n);assert.equal(s.error,null);p={campaign:s.campaign,battle:s.battle};}else{const n=dispatchCampaign(p.campaign,{type:'leaveSector',battleId:p.campaign.pendingBattle.id,sectorState:p.battle,survivors:p.battle.units.filter(u=>u.side==='player')});assert.equal(n.lastError,null);p={campaign:n,battle:null};}assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);}assert.deepEqual(p,pair);assert.equal(sha(fs.readFileSync(input,'utf8')),inputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests);return true;}
try{
 safe();save('before');if(!resuming)retain(4*3600);
 assert.ok(mendoza.every(id=>operativeLocation(c(),id)==='mendoza'&&r(id).hp===r(id).maxHp));assert.ok(local.every(id=>operativeLocation(c(),id)==='tucuman'&&r(id).hp===r(id).maxHp));
 if(!resuming){select(c().squads.find(q=>q.location==='mendoza'&&q.members.length).id);order({type:'squad',ids:mendoza.slice(0,6),returnToService:true});order({type:'configureArtillery',types:[]});}else assert.deepEqual(c().squad,mendoza.slice(0,6));const main=c().activeSquadId;
 rearm(122);for(const id of c().squad)topUp(id,'mendoza');pickAmmo('mendoza',2,'ammoRifle',5);
 order({type:'createSquad',name:'Apoyo real a Salta',ids:mendoza.slice(6),sector:'mendoza',returnToService:true});const second=c().activeSquadId;rearm(129);for(const id of c().squad)topUp(id,'mendoza');
 save('mendoza-equipped');console.log(JSON.stringify({event:'mendozaReady',main,second,...short()}));
 travel([main,second],'cordoba');for(const q of[main,second]){select(q);for(const id of c().squad)topUp(id,'cordoba');}save('cordoba-equipped');
 travel([main,second],'tucuman');select(main);transfer(2,'ammoRifle',5,'store');select(second);order({type:'squad',ids:[...mendoza.slice(6),...local],returnToService:true});
 for(const q of[main,second]){select(q);ready(c().squad);for(const id of c().squad)topUp(id,'tucuman',{required:true});}
 for(const id of[139,122]){const q=c().squads.find(q=>q.members.includes(id));select(q.id);const missing=Math.max(0,5-(r(id).medkits??0));if(missing)pick('tucuman',id,s=>s.item==='medkits',missing,'dressings');assert.ok(r(id).medkits>=5);}
 reloadSquad(main);reloadSquad(second);save('tucuman-ready');
 for(const q of[main,second]){select(q);for(const id of c().squad)order({type:'assignCare',operativeId:id,assignment:'rest'});}
 for(let h=0;!((c().hour+4)%24>=7&&(c().hour+4)%24<19);h++){assert.ok(h<24,'The bounded daylight wait was exceeded.');order({type:'wait',hours:1});}
 travel([main,second],'salta','attack');select(main);retain(4*3600);order({type:'beginAssault',sector:'salta'});
 assert.ok(pair.battle&&c().pendingBattle);assert.equal(pair.battle.night,false);assert.deepEqual(new Set(c().pendingBattle.squad.map(u=>u.id)),new Set(field));assert.equal(pair.battle.elapsedSeconds,0);assert.equal(pair.battle.status,'active');
 finalInvariants();save('prepared');const replay=await verifyReplay();if(resuming){assert.equal(fs.existsSync(canonicalPrefix+'-prepared.save.json'),false);fs.copyFileSync(prefix+'-prepared.save.json',canonicalPrefix+'-prepared.save.json');}const cash=events.filter(e=>e.event==='acceptedOrder').reduce((n,e)=>n+e.after.cash-e.before.cash,0);assert.equal(c().resources.treasury,old.resources.treasury+cash);
 fs.writeFileSync(prefix+'-preparation.receipt.json',JSON.stringify({source,testsDigest:tests,testFiles:files.length,input,inputHash,continuedFrom:resuming?canonicalPrefix+'-stopped.save.json':null,proofCorrection:resuming?'Recovered source metadata is authoritative; lost unowned fallback is not.':null,orders:history.length,frames,renewalCost,elapsedSeconds:clock(c())-clock(old),cashDelta:cash,initialCash:old.resources.treasury,final:short(),priorDeaths:dead,serving,field,initialAmmo,finalAmmo:ledger(c()),initialDressings,finalDressings:dressings(c()),gunCustodyUnchanged:true,nativeLoadProfilesUnchanged:true,ordinaryPresentedEqual:true,officialReplayEqual:replay,events,history},null,2));
 console.log(JSON.stringify({event:'saltaAdmissionAccepted',orders:history.length,frames,renewalCost,elapsedSeconds:clock(c())-clock(old),source:source.id,...short()}));
}catch(error){
 let savedError=null;try{save('stopped');}catch(e){savedError=e.stack;console.error('Stopped pair admission failed: '+e.message);}
 let replayError=null;try{await verifyReplay();}catch(e){replayError=e.stack;}
 fs.writeFileSync(prefix+'-stopped.receipt.json',JSON.stringify({source,testsDigest:tests,input,inputHash,stage:lastStage,error:error.stack,savedError,replayError,orders:history.length,renewalCost,frames,priorDeaths:dead,serving,summary:short(),events,history},null,2));console.error(error.stack);process.exitCode=1;
}
