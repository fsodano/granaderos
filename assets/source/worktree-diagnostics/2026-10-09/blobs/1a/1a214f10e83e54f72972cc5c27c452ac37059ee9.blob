import assert from 'node:assert/strict';
import fs from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {dispatchCampaign} from '../game/campaign.js';
import {encodeSave,decodeSave} from '../game/save.js';
import {expandSaveTerrain} from '../game/save-terrain.js';
import {buildIdentity} from '../tools/build-identity.mjs';
const root=process.cwd(),dir='/tmp/granaderos-stock-ending/',out=dir+'stock-squad-notice-main-compatibility';
const paths={start:dir+'stock-salta-recapture-battle-continuation-settled.save.json',nine:dir+'stock-controlled-recovery-nine-orders-valid.save.json',oldTen:dir+'stock-controlled-recovery-unadmitted-stopped.save.json',history:dir+'stock-controlled-recovery-ten-orders-history.json'};
const sha=data=>createHash('sha256').update(data).digest('hex');
const raw=Object.fromEntries(Object.entries(paths).map(([key,path])=>[key,fs.readFileSync(path,'utf8')]));
const hashes=Object.fromEntries(Object.entries(raw).map(([key,value])=>[key,sha(value)]));
assert.equal(hashes.start,'e8898c6bd62eb60c4962481d69ed3e2efd4a191df8a11ed30fb203c01651d451');
assert.equal(hashes.nine,'12cf99e8dfac3f51db72df418f36f028041918de1d8ba808201bf87bbd956881');
assert.equal(hashes.oldTen,'b22eb9871aa2e9fe9eab8f2a4d4a51b55d604bcaa0063c6751a60dd2f297dc1a');
const source=await buildIdentity(root);assert.equal(source.source,'7c9b603b2c65c3cd3c62a0ae97cb3a7885627380ffbdfb9eb5c1db18b23df07e');
const testPaths=execFileSync('rg',['--files','tests'],{encoding:'utf8'}).trim().split('\n').sort();
const digest=()=>{const h=createHash('sha256');for(const path of testPaths){h.update(path);h.update('\0');h.update(fs.readFileSync(path));h.update('\0');}return h.digest('hex');};
const tests={count:testPaths.length,digest:digest()};assert.equal(tests.count,883);assert.equal(tests.digest,'003daf7b2d8a5d4ab59beb534efd19a0042577ca4d85c3cd30b55dddf59b2b46');
const nine=decodeSave(raw.nine),before=structuredClone(nine),history=JSON.parse(raw.history);
assert.equal(history.length,10);assert.ok(history.every(event=>event.kind==='campaign'));
const action=history[9].action;
assert.deepEqual(action,{type:'createSquad',name:'Contactos de retaguardia',ids:[0],sector:'cordoba'});
const next=dispatchCampaign(nine.campaign,action);assert.equal(next.lastError,null);assert.deepEqual(nine,before);
const candidateText=encodeSave(next,nine.battle),candidate=decodeSave(candidateText);assert.deepEqual(candidate,{campaign:next,battle:nine.battle});
assert.deepEqual(candidate.campaign.operativeState,nine.campaign.operativeState);
assert.deepEqual(candidate.campaign.resources,nine.campaign.resources);assert.equal(candidate.campaign.hour,nine.campaign.hour);assert.equal(candidate.campaign.secondOfHour,nine.campaign.secondOfHour);assert.equal(candidate.campaign.seed,nine.campaign.seed);
assert.deepEqual(candidate.campaign.log,nine.campaign.log);
assert.deepEqual(candidate.campaign.travelNotice,{...nine.campaign.travelNotice,events:nine.campaign.travelNotice.events.filter(event=>event.squadId!=='squad-34')});
assert.deepEqual(candidate.campaign.squads.find(q=>q.id==='squad-35'),nine.campaign.squads.find(q=>q.id==='squad-35'));
assert.throws(()=>decodeSave(raw.oldTen),/aviso de marcha/);
const expected=JSON.parse(raw.oldTen),actualRaw=JSON.parse(candidateText);
if(expected.schema===2)expandSaveTerrain(expected);if(actualRaw.schema===2)expandSaveTerrain(actualRaw);
expected.campaign.travelNotice={...expected.campaign.travelNotice,events:expected.campaign.travelNotice.events.filter(event=>event.squadId!=='squad-34')};
delete expected.savedAt;delete actualRaw.savedAt;
assert.deepEqual(actualRaw,expected,'Only the retired notice entry may differ from the original unadmitted output.');
let replay=decodeSave(raw.start);
for(let i=0;i<history.length;i++){
 const accepted=dispatchCampaign(replay.campaign,history[i].action);assert.equal(accepted.lastError,null,`order${i+1}`);
 replay=decodeSave(encodeSave(accepted,replay.battle));assert.deepEqual(replay.campaign,accepted);
 if(i===8)assert.deepEqual(replay,nine,'The original nine accepted orders remain unchanged.');
}
assert.deepEqual(replay,candidate);
const acceptedOriginal=fs.readFileSync(dir+'squad-travel-notice-hotfix.save.json','utf8');assert.equal(sha(acceptedOriginal),'bc634f4b73e250b9b2a96eb5abb5d83c7d4220928b4131d44cf107e6dd6d0125');assert.deepEqual(candidate,decodeSave(acceptedOriginal));
assert.equal(hashes.history,'d4d58d3b56f6fb4f80a5c85286ae95e41ded69e35213ce9d2ff9ed718c582fcd');
for(const [key,path]of Object.entries(paths))assert.equal(sha(fs.readFileSync(path)),hashes[key]);
assert.deepEqual(await buildIdentity(root),source);assert.equal(digest(),tests.digest);
const dead=Object.entries(candidate.campaign.operativeState).filter(([,r])=>!r.alive).map(([id])=>Number(id));
const serving=candidate.campaign.recruited.filter(id=>candidate.campaign.operativeState[id].alive&&!candidate.campaign.operativeState[id].captured);
const receipt={kind:'exact-ten-order-stock-hotfix-replay',paths,hashes,source,tests,action,acceptedOrders:10,officialSaveAdmitted:true,fullTenOrderReplayEqual:true,originalNineEqual:true,onlyOldOutputDifference:'travelNotice.events retired squad-34 removed',output:out+'.save.json',outputHash:sha(candidateText),hour:candidate.campaign.hour,secondOfHour:candidate.campaign.secondOfHour,cash:candidate.campaign.resources.treasury,renewalDebit:decodeSave(raw.start).campaign.resources.treasury-candidate.campaign.resources.treasury,dead,serving,preserved:['all personal HP/bleeding/equipment/ammunition/RNG/terms after the original renewals','captivity','all retained scenes and finite custody','campaign log','squad-35 record','original surviving notice timestamp/text'],noFurtherGameplay:true};
assert.equal(fs.existsSync(out+'.save.json'),false);assert.equal(fs.existsSync(out+'.receipt.json'),false);fs.writeFileSync(out+'.save.json',candidateText);fs.writeFileSync(out+'.receipt.json',JSON.stringify(receipt,null,2)+'\n');
console.log(JSON.stringify(receipt,null,2));
