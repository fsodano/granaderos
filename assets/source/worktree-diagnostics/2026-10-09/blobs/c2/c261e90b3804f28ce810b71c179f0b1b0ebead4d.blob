const root=process.cwd(),dir='/tmp/granaderos-stock-ending/',input=dir+'stock-salta-recapture-reassignment-stopped.save.json',resumeInput=dir+'stock-salta-recapture-battle-stopped.save.json',priorProof=dir+'stock-salta-recapture-battle-stopped.receipt.json',prefix=dir+'stock-salta-recapture-battle-continuation',origin=dir+'stock-tucuman-aid-accepted.save.json',historyPath=dir+'stock-salta-recapture-reassignment-history.json',sha=x=>createHash('sha256').update(x).digest('hex');
assert.equal(fs.existsSync(prefix+'-terminal.save.json'),false,'This one battle must not restart an existing terminal result.');assert.equal(fs.existsSync(prefix+'-active.save.json'),false,'This one battle must not restart an existing accepted prefix.');
const text=fs.readFileSync(input,'utf8'),inputHash=sha(text);assert.equal(inputHash,'f2b41cbc1fa14b5193961af92e510e698cd9adb015558a24b5feceab764e5c76');
const start=decodeSave(text),original=structuredClone(start),source=await buildIdentity(root);assert.equal(source.source,'b6d0d4ffc4ec228c2c8684f88d2ad247f8b2e63d694a324f83502abe47c71848');
const files=[];function collect(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const f=path.join(dir,e.name);if(e.isDirectory())collect(f);else if(e.isFile())files.push(path.relative(root,f));}}collect(path.join(root,'tests'));files.sort();const digest=()=>{const h=createHash('sha256');for(const f of files){h.update(f);h.update('\0');h.update(fs.readFileSync(path.join(root,f)));h.update('\0');}return h.digest('hex');};assert.equal(files.length,880);const tests=digest();assert.equal(tests,'ea274572be1264a7be6744d9f5dd5d89d9081a1b9018f56c7fe5331374970f0a');
const prefixHistory=JSON.parse(fs.readFileSync(historyPath,'utf8'));assert.equal(prefixHistory.length,128);const prior=JSON.parse(fs.readFileSync(priorProof,'utf8')),resumeText=fs.readFileSync(resumeInput,'utf8'),resumeHash=sha(resumeText);assert.equal(resumeHash,'9e8d08a35b130c1ec0b860a9907f2467289b2ad4c745c849331d227e4caaf804');assert.equal(prior.savedError,null);assert.equal(prior.replayError,null);assert.equal(prior.orders,142);assert.equal(prior.actions,14);const resumeOriginal=decodeSave(resumeText);let pair=structuredClone(resumeOriginal),history=structuredClone(prior.history),events=structuredClone(prior.events),actions=prior.actions,turnOrders=prior.turnOrders,frames=prior.frames,lastStage='saved-cursor',lastAttempt=null,settled=false,replayVerified=false;assert.deepEqual(history.slice(0,128),prefixHistory);
const priorDead=Object.keys(start.campaign.operativeState).map(Number).filter(id=>!start.campaign.operativeState[id].alive),issued=new Set(start.campaign.pendingBattle.squad.map(u=>String(u.id))),intended=start.campaign.recruited.filter(id=>start.campaign.operativeState[id].alive&&!start.campaign.operativeState[id].captured);assert.equal(priorDead.length,29);assert.equal(intended.length,21);assert.equal(issued.size,12);
const clock=c=>c.hour*3600+(c.secondOfHour??0),dead=c=>Object.keys(c.operativeState).map(Number).filter(id=>!c.operativeState[id].alive);
function ammo(b){const n=fieldAmmunitionByType(b);for(const u of b.units)addAmmoCounts(n,unitAmmunitionByType(u));return Object.fromEntries(Object.values(AMMUNITION_FAMILIES).map(f=>[f.type,n[f.type]??0]));}
function cloth(b){let n=b.units.reduce((n,u)=>n+(u.medkits??0),0);for(const g of b.groundItems??[])if(!g.heldBy)n+=g.type==='medkits'?g.count:g.item==='medkits'?g.count:0;for(const owner of[...(b.props??[]),...(b.npcs??[])])for(const s of[...(owner.contents??[]),...(owner.questGifts??[])])if(s.item==='medkits')n+=s.count;return n;}
function players(b){return b.units.filter(u=>issued.has(u.id)).map(u=>({id:u.id,hp:u.hp,maxHp:u.maxHp,bleeding:u.bleeding??0,bandaged:u.bandaged??0,energy:u.energy,ap:u.ap,morale:u.morale,shock:u.shock,medical:u.medical,medkits:u.medkits,weapon:u.weapon,condition:u.condition,weaponDropped:!!u.weaponDropped,loaded:u.loaded,ammo:u.ammo,routed:!!u.routed,fled:!!u.fled,unconscious:!!u.unconscious,surrendered:!!u.surrendered,departure:u.departure??null}));}
function summary(){const c=pair.campaign,b=pair.battle;return{hour:c.hour,second:c.secondOfHour??0,cash:c.resources.treasury,location:c.location,pendingBattle:c.pendingBattle?.id??null,pendingEncounter:c.pendingEncounter,status:b?.status??null,turn:b?.turn??null,elapsedSeconds:b?.elapsedSeconds??null,players:b?players(b):intended.map(id=>{const r=c.operativeState[id],u=carriedAmmunition(rosterFor(c).find(o=>o.id===id),r);return{id,at:operativeLocation(c,id),hp:r.hp,bleeding:r.bleeding??0,energy:r.energy,medkits:r.medkits,alive:r.alive,captured:r.captured,weapon:u.weapon,condition:u.condition,loaded:u.loaded,ammo:u.ammo,weaponDropped:!!u.weaponDropped};}),deaths:dead(c),guns:b?.artillery?.map(g=>({id:g.id,type:g.type,side:g.side,loaded:g.loaded,ammo:g.ammo,condition:g.condition,x:g.x,y:g.y}))??null};}
function save(stage){fs.writeFileSync(prefix+'-history.json',JSON.stringify(history,null,2));fs.writeFileSync(prefix+'-events.json',JSON.stringify(events,null,2));const text=encodeSave(pair.campaign,pair.battle),p=decodeSave(text);assert.deepEqual(p,pair);fs.writeFileSync(prefix+'-'+stage+'.save.json',text);fs.writeFileSync(prefix+'-latest.save.json',text);lastStage=stage;return p;}
function termGuard(){for(const id of intended){const r=pair.campaign.operativeState[id];if(!r.alive||r.captured)continue;assert.ok(pair.campaign.recruited.includes(id),'An actual unanticipated service departure stops this battle proof.');const expiry=contractExpiresSeconds(pair.campaign.contracts[id]);assert.ok(expiry===null||expiry>clock(pair.campaign)+180,'The actual paid term must cover the next tactical action.');}for(const id of priorDead)assert.equal(pair.campaign.operativeState[id].alive,false);assert.equal(pair.campaign.pendingEncounter,null,'An actual strategic encounter stops this proof.');}
const initialAmmo=ammo(start.battle),initialCloth=cloth(start.battle),spent=structuredClone(prior.spent);let usedCloth=prior.usedCloth;assert.equal(usedCloth,0);for(const f of Object.keys(spent))assert.equal(spent[f],0);assert.deepEqual(ammo(pair.battle),initialAmmo);assert.equal(cloth(pair.battle),initialCloth);
function accept(action){lastAttempt=structuredClone(action);termGuard();const before=pair.battle,frozen=structuredClone(before),beforeAmmo=ammo(before),beforeCloth=cloth(before),oldClock=clock(pair.campaign);
 // Actual action runs once for gameplay. Presented execution and recorded
 // replay are deterministic validation of that accepted order, never a new tactic.
 const ordinary=action.type==='endTurn'?endTurn(before):actBattle(before,action);assert.equal(ordinary.lastError,null,JSON.stringify(action)+': '+ordinary.lastError);
 history.push({kind:'tactical',action:structuredClone(action)});actions+=action.type!=='endTurn';turnOrders+=action.type==='endTurn';const sync=syncBattleTime(pair.campaign,ordinary);
 if(sync.error){pair={campaign:pair.campaign,battle:ordinary};fs.writeFileSync(prefix+'-accepted-unsynced.campaign-diagnostic.json',JSON.stringify(pair,null,2));throw Error(sync.error);}
 pair={campaign:sync.campaign,battle:sync.battle};const afterAmmo=ammo(pair.battle),afterCloth=cloth(pair.battle),event={index:history.length,action:structuredClone(action),turn:pair.battle.turn,status:pair.battle.status,elapsedSeconds:pair.battle.elapsedSeconds,paidSeconds:clock(pair.campaign)-oldClock,ammoBefore:beforeAmmo,ammoAfter:afterAmmo,ammoConsumed:Object.fromEntries(Object.keys(spent).map(f=>[f,beforeAmmo[f]-afterAmmo[f]])),dressingsBefore:beforeCloth,dressingsAfter:afterCloth,players:players(pair.battle)};events.push(event);save('active');
 const shown=action.type==='endTurn'?presentedEndTurn(before):presentedActBattle(before,action);assert.deepEqual(shown.state,ordinary);assert.deepEqual(before,frozen);frames+=shown.frames.length;
 for(const f of Object.keys(spent)){assert.ok(afterAmmo[f]<=beforeAmmo[f],`Finite active ${f} must not be created by an ordinary field order.`);spent[f]+=beforeAmmo[f]-afterAmmo[f];}assert.ok(afterCloth<=beforeCloth);usedCloth+=beforeCloth-afterCloth;
 termGuard();if(actions%25===0||action.type==='endTurn'||pair.battle.status!=='active')console.log(JSON.stringify({event:'battleProgress',actions,turnOrders,turn:pair.battle.turn,status:pair.battle.status,seconds:pair.battle.elapsedSeconds,players:players(pair.battle).map(({id,hp,bleeding,routed,fled,loaded,ammo})=>({id,hp,bleeding,routed,fled,loaded,ammo}))}));
}
async function replay(){let p=decodeSave(fs.readFileSync(origin,'utf8'));for(let i=0;i<history.length;i++){const step=history[i];if(step.kind==='campaign'){const c=dispatchCampaign(p.campaign,step.action);assert.equal(c.lastError,null);p={campaign:c,battle:c.pendingBattle?enterSector(c.pendingBattle,c.sectorStates[c.pendingBattle.sector]):null};}else if(step.kind==='tactical'){const b=step.action.type==='endTurn'?endTurn(p.battle):actBattle(p.battle,step.action);assert.equal(b.lastError,null);const sync=syncBattleTime(p.campaign,b);assert.equal(sync.error,null);p={campaign:sync.campaign,battle:sync.battle};}else if(step.kind==='leave'){const c=dispatchCampaign(p.campaign,{type:'leaveSector',battleId:p.campaign.pendingBattle.id,sectorState:p.battle,survivors:p.battle.units.filter(u=>u.side==='player')});assert.equal(c.lastError,null);p={campaign:c,battle:null};}else if(step.kind==='battleResult'){const c=dispatchCampaign(p.campaign,{type:'battleResult',battleId:p.campaign.pendingBattle.id,outcome:p.battle.status,sectorState:p.battle,survivors:p.battle.units.filter(u=>u.side==='player')});assert.equal(c.lastError,null);p={campaign:c,battle:null};}else throw Error('Unrecognized recorded order.');assert.deepEqual(decodeSave(encodeSave(p.campaign,p.battle)),p);if((i+1)%100===0)console.log(JSON.stringify({event:'fullRecordedReplay',through:i+1,total:history.length}));}assert.deepEqual(p,pair);replayVerified=true;}
async function immutable(){assert.deepEqual(start,original);assert.equal(sha(fs.readFileSync(input,'utf8')),inputHash);assert.equal(sha(fs.readFileSync(resumeInput,'utf8')),resumeHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(digest(),tests);}
try{
 assert.deepEqual(enterSector(start.campaign.pendingBattle,start.campaign.sectorStates.salta),start.battle,'The official admitted initial battlefield must be the real issued scene.');assert.equal(start.battle.elapsedSeconds,0);assert.equal(pair.battle.elapsedSeconds,31);assert.equal(pair.battle.night,false);save('before');termGuard();
 console.log(JSON.stringify({event:'sameActualSaltaBattleContinued',resumeInput,resumeHash,resumeCursor:{window:0,attempt:2,idIndex:0},source:source.id,testFiles:files.length,inputHash,initial:summary()}));
 for(let window=0;window<600&&pair.battle.turn<=80&&pair.battle.status==='active';window++){
  const ids=pair.battle.units.filter(u=>u.side==='player'&&!u.militia).sort((a,b)=>b.marksmanship-a.marksmanship).map(u=>u.id);
  for(let attempt=window===0?2:0;attempt<16&&pair.battle.status==='active';attempt++){let acted=false;for(const id of ids){if(pair.battle.status!=='active')break;const u=pair.battle.units.find(u=>u.id===id);if(!interruptAvailable(pair.battle,u)||u.ap<3)continue;const action=cautiousCombatOrder(pair.battle,u);if(!action)continue;if(action.type==='fire'){const target=pair.battle.units.find(v=>v.id===action.targetId);const observers=target?pair.battle.units.filter(o=>o.side===u.side&&fieldCapable(o)&&!o.routed&&!isUnconscious(o)&&!o.asleep&&!o.captured&&!o.captive&&canSee(pair.battle,o,target)):[];assert.ok(target&&teamCanSee(pair.battle,u.side,target)&&hasLineOfSight(pair.battle,u,target)&&observers.length>0,'A chosen aimed shot must use actual shared military observation and line of fire.');fs.appendFileSync(prefix+'-shared-fire-audit.jsonl',JSON.stringify({nextOrder:history.length+1,action,personalSight:canSee(pair.battle,u,target),sharedSight:true,lineOfFire:true,actualObservers:observers.map(o=>o.id)})+'\n');}accept(action);acted=true;}if(!acted)break;}
  if(pair.battle.status==='active')accept({type:'endTurn'});
 }
 save('terminal');const terminal=summary();assert.ok(['victory','defeat','retreat'].includes(pair.battle.status),'A bounded active battle stops without forcing an outcome.');for(const f of Object.keys(spent))assert.equal(initialAmmo[f]-ammo(pair.battle)[f],spent[f]);assert.equal(initialCloth-cloth(pair.battle),usedCloth);
 const outcome=pair.battle.status,actualBattle=structuredClone(pair.battle),cashBefore=pair.campaign.resources.treasury,action={type:'battleResult',battleId:pair.campaign.pendingBattle.id,outcome,sectorState:pair.battle,survivors:pair.battle.units.filter(u=>u.side==='player')};lastAttempt={type:'battleResult',outcome};const returned=dispatchCampaign(pair.campaign,action);assert.equal(returned.lastError,null,returned.lastError);pair={campaign:returned,battle:null};history.push({kind:'battleResult'});settled=true;save('settled');
 for(const id of priorDead)assert.equal(returned.operativeState[id].alive,false);assert.equal(returned.pendingBattle,null);for(const u of actualBattle.units.filter(u=>issued.has(u.id)&&u.hp<=0))assert.equal(returned.operativeState[Number(u.id)].alive,false);
 console.log(JSON.stringify({event:'actualSaltaSettlement',outcome,actions,turnOrders,turns:actualBattle.turn,elapsedSeconds:actualBattle.elapsedSeconds,cashDelta:returned.resources.treasury-cashBefore,summary:summary()}));await replay();await immutable();
 const final={source,testsDigest:tests,testFiles:files.length,input,inputHash,resumeInput,resumeHash,originalStop:priorProof,resumedAt:{window:0,attempt:2,idIndex:0},prefixOrigin:origin,preparedOrders:prefixHistory.length,battleActions:actions,endTurnOrders:turnOrders,totalRecordedOrders:history.length,frames,outcome,turns:actualBattle.turn,elapsedSeconds:actualBattle.elapsedSeconds,campaignElapsedSeconds:clock(returned)-clock(start.campaign),initialActiveAmmo:initialAmmo,finalActiveAmmo:ammo(actualBattle),activeAmmoConsumed:spent,initialActiveDressings:initialCloth,finalActiveDressings:cloth(actualBattle),dressingsConsumed:usedCloth,ammoAccounting:'Actual active battle owners and field stacks, including typed departure receipts until settlement. No stale personal/retained scene mirrors; no newly issued enemy counts inferred into the global campaign baseline.',priorDeaths:priorDead,newDeaths:dead(returned).filter(id=>!priorDead.includes(id)),initialPlayers:players(start.battle),terminalPlayers:players(actualBattle),final:summary(),actualSceneGun:actualBattle.artillery.map(g=>({id:g.id,type:g.type,side:g.side,loaded:g.loaded,ammo:g.ammo,condition:g.condition,x:g.x,y:g.y})),campaignSceneGun:returned.sectorStates.salta.artillery,ordinaryPresentedEqual:true,officialSaveReplayEqual:replayVerified,settled,events,history};fs.writeFileSync(prefix+'-receipt.json',JSON.stringify(final,null,2));console.log(JSON.stringify({event:'oneActualSaltaBattleVerified',outcome,actions,turns:actualBattle.turn,elapsedSeconds:actualBattle.elapsedSeconds,orders:history.length,newDeaths:final.newDeaths,inputHash,source:source.id}));
}catch(error){let savedError=null,replayError=null;try{save('stopped');}catch(e){savedError=e.stack;fs.writeFileSync(prefix+'-stopped.campaign-diagnostic.json',JSON.stringify(pair,null,2));}try{await replay();await immutable();}catch(e){replayError=e.stack;}fs.writeFileSync(prefix+'-stopped.receipt.json',JSON.stringify({source,testsDigest:tests,testFiles:files.length,input,inputHash,resumeInput,resumeHash,originalStop:priorProof,lastStage,lastAttempt,error:error.stack,savedError,replayError,actions,turnOrders,frames,settled,orders:history.length,summary:summary(),spent,usedCloth,events,history},null,2));console.error(error.stack);process.exitCode=1;}
