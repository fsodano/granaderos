{
  "name": "granaderos",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/test-runner.mjs",
    "test:quick": "node tools/test-runner.mjs --suite quick",
    "test:extended": "node tools/test-runner.mjs --suite extended",
    "dev": "npm --prefix web run dev",
    "build": "node tools/build-web.mjs",
    "typecheck": "node web/node_modules/typescript/bin/tsc --project web/tsconfig.typecheck.json --noEmit",
    "audit:docs": "node tools/audit-docs.mjs",
    "docs:progress": "node tools/audit-docs.mjs --write",
    "audit:baseline": "node tools/audit-baseline.mjs",
    "campaign:new": "node tools/campaign-authoring.mjs scaffold",
    "campaign:check": "node tools/campaign-authoring.mjs check",
    "campaign:assets": "node tools/campaign-authoring.mjs assets",
    "test:core": "node tools/test-runner.mjs --suite core",
    "test:campaign": "node tools/test-runner.mjs --suite campaign"
  }
}
