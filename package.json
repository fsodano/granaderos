{
  "name": "granaderos",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tools/test-runner.mjs",
    "test:quick": "npm test",
    "dev": "npm --prefix apps/web run dev",
    "build": "node tools/build-web.mjs",
    "typecheck": "npm --prefix packages/game run typecheck && npm --prefix apps/web run typecheck && npm --prefix apps/campaign-editor run typecheck",
    "audit:docs": "node tools/audit-docs.mjs",
    "docs:progress": "node tools/audit-docs.mjs --write",
    "audit:baseline": "node tools/audit-baseline.mjs",
    "campaign:new": "node tools/campaign-authoring.mjs scaffold",
    "campaign:check": "node tools/campaign-authoring.mjs check",
    "campaign:assets": "node tools/campaign-authoring.mjs assets",
    "check:architecture": "node tools/check-architecture.mjs",
    "build:editor": "npm --prefix packages/campaign-format run build && npm --prefix apps/campaign-editor run build",
    "format:architecture": "npm run format",
    "check:format": "node tools/code-quality.mjs format:check",
    "lint": "node tools/code-quality.mjs lint",
    "lint:fix": "node tools/code-quality.mjs lint --fix",
    "lint:audit": "node tools/code-quality.mjs lint:audit",
    "format": "node tools/code-quality.mjs format"
  }
}
