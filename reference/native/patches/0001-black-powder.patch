 { 
-	OBJECTTYPE * pObj; 
+	OBJECTTYPE * pObj;
+#ifdef GRANADEROS
+	// Black-powder ignition applies to both armies, independent of modern jam settings.
+	pObj = pSoldier->GetUsedWeapon(&pSoldier->inv[pSoldier->ubAttackingHand]);
+	if (pObj && pObj->exists() && granaderos::isFirearm(pObj->usItem))
+	{
+		auto& gun = (*pObj)[0]->data.gun;
+		if (gun.bGunAmmoStatus < 0)
+		{
+			if (!EnoughPoints(pSoldier, granaderos::reprimeAP, 0, TRUE)) return TRUE;
+			DeductPoints(pSoldier, granaderos::reprimeAP, 0);
+			gun.bGunAmmoStatus *= -1;
+			DirtyMercPanelInterface(pSoldier, DIRTYLEVEL2);
+			return 255; // re-prime is an action, not a simultaneous shot
+		}
+		if (gun.ubGunShotsLeft == 0) return FALSE;
+		int rain = 0;
+		int humidity = 0;
+		if (!pSoldier->bSectorZ)
+		{
+			const auto weather = SectorInfo[SECTOR(pSoldier->sSectorX, pSoldier->sSectorY)].usWeather;
+			if (weather == WEATHER_FORECAST_RAIN) rain = 40;
+			if (weather == WEATHER_FORECAST_THUNDERSHOWERS) rain = 80;
+			if (weather == WEATHER_FORECAST_SNOW) rain = 20;
+			// Eastern river sectors are humid even without active rain.
+			if (pSoldier->sSectorX >= 7) humidity = 5;
+		}
+		const int chance = granaderos::misfirePercent(gun.bGunStatus, rain, humidity);
+		if ((INT32)PreRandom(100) < chance || gfNextFireJam)
+		{
+			gfNextFireJam = FALSE;
+			// Only the flashpan burns. Preserve the loaded main charge and cartridge.
+			gun.bGunAmmoStatus = -__max(1, gun.bGunAmmoStatus);
+			DeductPoints(pSoldier, CalcTotalAPsToAttack(pSoldier, pSoldier->sTargetGridNo, FALSE, pSoldier->aiData.bAimTime), 0);
+			if (pSoldier->bTeam == gbPlayerNum)
+				ScreenMsg(FONT_MCOLOR_LTYELLOW, MSG_INTERFACE, L"Fallo de encendido. Cebar la llave: 15 PA.");
+			DirtyMercPanelInterface(pSoldier, DIRTYLEVEL2);
+			return TRUE;
+		}
+		return FALSE;
+	}
+#endif
