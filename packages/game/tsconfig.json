{
  "extends": "../../tsconfig.strict.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "typeRoots": ["../../apps/web/node_modules/@types"],
    "allowJs": true
  },
  "include": [
    "domain/**/*.ts",
    "application/**/*.ts",
    "infrastructure/**/*.ts",
    "public/**/*.ts",
    "*.ts"
  ]
}
