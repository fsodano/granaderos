  for value in x:update(value)
update(manifest);(out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
proof={'baselineSha256':hashlib.sha256(raw).hexdigest(),'candidateSha256':hashlib.sha256(result).hexdigest(),'binaryPayloadUnchanged':binary==result[28+len(encoded):],'changed':'3 head-only texture maps; same geometry, UVs, rig, skin weights, material factor and motions','normalSlopeDegrees':list(np.percentile(np.degrees(np.arctan2(np.linalg.norm(normout[:,:,:2],axis=-1),normout[:,:,2]))[blend>.99],[50,95,99])),'headCavityMultiplier':list(np.percentile(cavity[blend>.99],[0,1,50,99]))}
(root/'preservation.json').write_text(json.dumps(proof,indent=2)+'\n');print(json.dumps(proof,indent=2))
