colour=load(colourindex)
ao=np.asarray(Image.open(root/'head-cavity.png').convert('L').filter(ImageFilter.GaussianBlur(.35))).astype(float)/255
# Short-range cavity only. No hat/light/directional shadow was part of the bake.
cavity=1-.42*(1-ao)*blend
# Work in linear colour. The source chroma and all hand pixels are retained.
linear=np.where(colour<=.04045,colour/12.92,((colour+.055)/1.055)**2.4)*cavity[:,:,None]
colour=np.where(linear<=.0031308,linear*12.92,1.055*linear**(1/2.4)-.055)
normal_pixels=normout*.5+.5
normal_pixels[blend==0]=load(normalindex)[blend==0]
images=[(normalindex,normal_pixels),(roughindex,rough),(colourindex,colour)]
for index,pixels in images:
 img=image_for(index);tmp=root/(img['name']+'-pilot.png');Image.fromarray(np.round(np.clip(pixels,0,1)*255).astype(np.uint8)).save(tmp)
 digest=hashlib.sha256(tmp.read_bytes()).hexdigest();uri='textures/'+digest[:20]+'.png';shutil.copy2(tmp,out/uri);img['uri']=uri
encoded=json.dumps(doc,separators=(',',':')).encode();encoded+=b' '*(-len(encoded)%4)
result=struct.pack('<III',0x46546c67,2,28+len(encoded)+len(binary))+struct.pack('<II',len(encoded),0x4e4f534a)+encoded+struct.pack('<II',len(binary),0x004e4942)+binary
(out/'granadero-lod0.glb').write_bytes(result)
manifest=json.loads((out/'manifest.json').read_text())
def update(x):
 if isinstance(x,dict):
  if x.get('url')=='/models/characters/granadero-lod0.glb':x.update(bytes=len(result),sha256=hashlib.sha256(result).hexdigest())
  for value in x.values():update(value)
