  const evaluate=blend(f,guard,gesture,direction,phase);let previous,previousRaw;const frameCount=16;
  for(let frame=0;frame<=frameCount;frame++){
   const t=.12*frame/frameCount;evaluate(t,frame/frameCount);const body=pose(f.model),raw=points(f.mesh),footGoals=['l','r'].map(side=>({p:f.model.getObjectByName('foot_'+side).getWorldPosition(new Vector3()),q:f.model.getObjectByName('foot_'+side).getWorldQuaternion(new Quaternion())}));
   const lengthBefore=['l','r'].map(side=>{const a=f.model.getObjectByName('thigh_'+side).getWorldPosition(new Vector3()),b=f.model.getObjectByName('calf_'+side).getWorldPosition(new Vector3()),c=f.model.getObjectByName('foot_'+side).getWorldPosition(new Vector3());return[a.distanceTo(b),b.distanceTo(c)];});const time=f.mixer.time;f.helper.apply(t);assert.equal(f.mixer.time,time,'Mixer clock remains exact');assertPose(body,true);assert.equal(f.helper.rejectedFits,0,'Admitted native fit must succeed');const full=points(f.mesh);lowest=Math.min(lowest,...full.map(p=>p.y));rawLowest=Math.min(rawLowest,...raw.map(p=>p.y));largestLift=Math.max(largestLift,f.helper.maximumAdjustment);if(f.helper.maximumAdjustment)active++;
   for(let i=0;i<full.length;i++){if(previous){maxSpeed=Math.max(maxSpeed,full[i].distanceTo(previous[i])/(.12/frameCount));maxRawSpeed=Math.max(maxRawSpeed,raw[i].distanceTo(previousRaw[i])/(.12/frameCount));}if(f.mesh.geometry.attributes.position.getY(i)<soleCutoff)maxSoleDrift=Math.max(maxSoleDrift,Math.hypot(full[i].x-raw[i].x,full[i].z-raw[i].z));}
