for(const anatomy of ['granadero','woman-scout'])for(const lod of [0,2])for(const fps of [30,120,240])test(`${anatomy} LOD${lod} at${fps}Hz: real fade frames, zero-delta handoff and reduced motion remain continuous`,async()=>{
 const asset=await publishedActor(anatomy,lod),visual={key:'unit:fine',id:'fine',kind:'unit',appearance:anatomy,skin:'light',side:'player',position:[0,0,0],yaw:0,tacticalLevel:0,posture:'standing',mounted:false,action:'idle',idleAction:'idle',equipment:'long-gun',items:[{id:'1800',reference:'primary',socket:'handRight'}],garments:{},selected:false,bodyHeights:{}},actor=new ActorRuntime(asset,visual),mesh=actor.model.getObjectByName('Human_footwear_LOD'+lod);let low=Infinity,peak=0,rawPeak=0,releaseSpeed=0,releaseCorrectionSpeed=0,previous,previousRaw,rawCurrent,priorActive=false;const apply=actor.gestureSupport.apply.bind(actor.gestureSupport);actor.gestureSupport.apply=(...args)=>{actor.root.updateMatrixWorld(true);rawCurrent=points(mesh);apply(...args);};
 // Exercise the real clip-aware production path at finite frame rates.
