 try{for(let i=0;i<Math.ceil(.5*fps);i++)actor.tick(1/fps,i*1000/fps,true);const start=1000,phaseMs=BATTLE_PLAYBACK.action,cue={id:'fine',action:'heal',phase:'prepare',startedAt:start,phaseStartedAt:start,phaseDurationMs:phaseMs,durationMs:phaseMs*2};actor.update({...visual,action:'heal',cue},start);let returned=false;
