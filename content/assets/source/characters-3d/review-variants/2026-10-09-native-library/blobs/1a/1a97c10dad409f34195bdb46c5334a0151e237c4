    assert.deepEqual(actor.root.position.toArray(),visual.position,'Keep saved world cell');assert.equal(actor.root.rotation.y,visual.yaw,'Keep body facing');if(support.maximumAdjustment)adjustedFrames++;if(frame===0||frame===50)endpointFits+=Number(support.maximumAdjustment>1e-9);
