   if(frame===0||frame===frameCount)assertPose(body,false);previous=full;previousRaw=raw;
  }
 }
 assert.ok(rawLowest<-.003,'Reproduce the weighted raw blend floor defect');assert.ok(lowest>.0009,'The whole boot stays above the floor '+lowest);assert.ok(largestLift<.007,'Only the measured blend needs a small fit '+largestLift);assert.ok(active>0);assert.ok(maxSoleDrift<.000001,'Native sole footprint stays fixed '+maxSoleDrift);assert.ok(maxSpeed<2.5,'Full boot speed includes shaft '+maxSpeed);assert.ok(maxSpeed<maxRawSpeed*1.4,'No high speed snap '+maxSpeed+' / '+maxRawSpeed);metrics.push({kind:'weighted-blend-grid',anatomy,lod,states:216,rawLowest,lowest,largestLift,maxSpeed,maxRawSpeed,maxSoleDrift});
