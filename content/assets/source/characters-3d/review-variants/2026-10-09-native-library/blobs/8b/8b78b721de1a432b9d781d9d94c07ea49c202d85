from pathlib import Path
import hashlib,json,struct
root=Path(__file__).resolve().parents[3]
base=root/'artifacts/character-anatomy-review'
old=base/'integration-candidate/models';new=base/'punch-wrist-candidate/models'
widths={'SCALAR':1,'VEC2':2,'VEC3':3,'VEC4':4,'MAT4':16};sizes={5121:1,5123:2,5125:4,5126:4}
def read(path):
 raw=path.read_bytes();n=struct.unpack_from('<I',raw,12)[0];doc=json.loads(raw[20:20+n]);buf=raw[28+n:]
 def access(i):
  a=doc['accessors'][i];v=doc['bufferViews'][a['bufferView']];width=widths[a['type']]*sizes[a['componentType']];offset=v.get('byteOffset',0)+a.get('byteOffset',0);stride=v.get('byteStride',width)
  assert 'sparse'not in a
  return (a['type'],a['componentType'],a['count'],a.get('normalized',False),b''.join(buf[offset+k*stride:offset+k*stride+width]for k in range(a['count'])))
 records={}
 for animation in doc['animations']:
  channels={}
  for channel in animation['channels']:
   s=animation['samplers'][channel['sampler']];target=channel['target'];key=(doc['nodes'][target['node']]['name'],target['path'])
   channels[key]=(s.get('interpolation','LINEAR'),access(s['input']),access(s['output']))
  records[animation['name']]=channels
 return records
report={}
for gender in ('male','female'):
 a=read(old/f'{gender}-animations.glb');b=read(new/f'{gender}-animations.glb');assert a.keys()==b.keys()
 changed=[name for name in a if a[name]!=b[name]];assert changed==['stand.punch.unarmed'],changed
 name=changed[0];assert a[name].keys()==b[name].keys();channels=[key for key in a[name]if a[name][key]!=b[name][key]]
 assert all(path=='rotation'and bone.startswith(('hand_','thumb_','index_','middle_','ring_','pinky_'))for bone,path in channels),channels
 ma=json.loads((old/'manifest.json').read_text())['animationLibraries'][gender];mb=json.loads((new/'manifest.json').read_text())['animationLibraries'][gender]
 ca=next(c for c in ma['clips']if c['name']==name);cb=next(c for c in mb['clips']if c['name']==name)
 for key in ('duration','markers','events','playbackRate','timingAuthority','loop','rootMotion'):assert ca[key]==cb[key],key
 report[gender]={'unselectedClipsPreserved':len(a)-1,'changedChannels':channels,'bodyAndArmTracksPreserved':True,'timingPreserved':True,'beforeSha256':hashlib.sha256((old/f'{gender}-animations.glb').read_bytes()).hexdigest(),'afterSha256':hashlib.sha256((new/f'{gender}-animations.glb').read_bytes()).hexdigest()}
(base/'punch-wrist-candidate/preservation.json').write_text(json.dumps(report,indent=2)+'\n')
print(json.dumps({g:{'unselectedClipsPreserved':r['unselectedClipsPreserved'],'changedChannels':len(r['changedChannels']),'bodyAndArmTracksPreserved':True,'timingPreserved':True}for g,r in report.items()},indent=2))
