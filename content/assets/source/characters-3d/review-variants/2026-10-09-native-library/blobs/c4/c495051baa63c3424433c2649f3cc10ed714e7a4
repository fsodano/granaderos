#!/usr/bin/env python3
"""Apply checked source deltas and regenerate only the current heal profile entries."""
from pathlib import Path
import argparse,hashlib,json,subprocess,shutil
CUT=Path(__file__).resolve().parents[1]
SOURCES=['game/battle-presentation.js','web/lib/three/presentation.ts','web/lib/three/animation-clock.ts','web/lib/three/action-timing.ts','web/lib/useEnemyPlayback.ts','tools/characters-3d/compile-locomotion-profile.mjs']
NEW=['tests/three-healing-presentation.test.mjs','docs/verification/healing-patient-cue-and-clock.md']
def digest(data):return hashlib.sha256(data).hexdigest()
def main():
 p=argparse.ArgumentParser();p.add_argument('--repo',type=Path,required=True);a=p.parse_args();root=a.repo.resolve();base=CUT/'support-evidence/groundwork-base'
 # Fail before writes if an overlapping source changed. Never copy old banks,
 # actor hooks, the manifest, or the complete generated profile into the caller.
 for f in SOURCES:
  raw=(root/f).read_bytes();assert raw in [(base/f).read_bytes(),(CUT/f).read_bytes()],f+' has an overlapping source change; compose its supplied narrow patch'
 for f in NEW:assert not(root/f).exists()or(root/f).read_bytes()==(CUT/f).read_bytes(),'Existing new source differs: '+f
 manifest=root/'web/public/models/characters/manifest.json';saved=manifest.read_bytes();profile=root/'web/lib/three/locomotion-profile.json';oldRaw=profile.read_bytes();old=json.loads(oldRaw);bankPins={root/'web/public/models/characters'/Path(v['url']).name:digest((root/'web/public/models/characters'/Path(v['url']).name).read_bytes())for v in json.loads(saved)['animationLibraries'].values()}
 for f in SOURCES+NEW:
  target=root/f;target.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(CUT/f,target)
 try:
  subprocess.run(['node',str(root/SOURCES[-1])],cwd=root,check=True)
  assert manifest.read_bytes()==saved,'Compiler changed the current manifest'
  assert all(digest(p.read_bytes())==pin for p,pin in bankPins.items()),'A native bank changed'
  new=json.loads(profile.read_text());expected={p+'.gesture.heal'for p in ['stand','crouch','prone','mounted']}
  for gender in ['male','female']:
   prior=old['banks'][gender]['actions'];next=new['banks'][gender]['actions'];assert set(next)==set(prior)|expected
   for name in expected:
    assert next[name]['duration']==1.4 and not next[name]['loop']
    if name not in prior:del next[name]
  assert new==old,'Unrelated profile values changed'
 except:
  manifest.write_bytes(saved);profile.write_bytes(oldRaw);raise
 print('HEAL_GROUNDWORK_INSTALLED',json.dumps({'manifestSHA256':digest(saved),'banksUnchanged':True,'profileOnlyHealEntries':True,'sourceHashes':{f:digest((root/f).read_bytes())for f in SOURCES+NEW}}))
if __name__=='__main__':main()
