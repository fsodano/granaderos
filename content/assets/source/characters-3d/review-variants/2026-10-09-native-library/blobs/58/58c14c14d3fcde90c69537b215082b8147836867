 'friar':dict(gender='male',title='Fraile',coat=(.093,.049,.022),trousers=(.093,.049,.022),headwear=None),
 'woman-scout':dict(gender='female',title='Exploradora',coat=(.105,.128,.069),trousers=(.30,.26,.18),headwear=None),
