+    for a,b,offset in ((shoulder,elbow,-(elbow-shoulder).length),(elbow,wrist,0)):
+        axis=(b-a).normalized();along=max(0,min((b-a).length,(point-a).dot(axis)))
+        centre=a+axis*along;candidates.append(((point-centre).length,offset+along,centre,axis))
+    return min(candidates,key=lambda a:a[0])
+
+
+def prepare_envelope(coat,heads):
+    before=[[float(c) for c in v.co] for v in coat.data.vertices]
+    def signature():
+        return {'polygons':[list(p.vertices) for p in coat.data.polygons],
+                'weights':[[(coat.vertex_groups[g.group].name,g.weight) for g in v.groups] for v in coat.data.vertices],
+                'uv':[[list(v.uv) for v in layer.data] for layer in coat.data.uv_layers]}
+    signatures=signature();mask=coat.data.attributes.new(name=ATTRIBUTE,type='FLOAT',domain='POINT')
+    edges={}
+    for p in coat.data.polygons:
+        ids=list(p.vertices)
+        for a,b in zip(ids,ids[1:]+ids[:1]):edge=tuple(sorted((a,b)));edges[edge]=edges.get(edge,0)+1
+    boundary={i for edge,n in edges.items() if n==1 for i in edge}
+    data=[]
+    for v in coat.data.vertices:
+        p=v.co.copy();radius,s,centre,axis=location(p,heads)
+        weight=sum(g.weight for g in v.groups if coat.vertex_groups[g.group].name in ('upperarm_l','lowerarm_l'))
+        amount=smooth(.72,.96,weight)*smooth(-.19,-.105,s)*(1-smooth(.095,.165,s))
+        amount*=smooth(.148,.215,(p-heads['upperarm_l']).length)*smooth(.095,.145,(p-heads['hand_l']).length)
+        if v.index in boundary or radius>.115 or p.x<.18:amount=0
+        mask.data[v.index].value=amount
