"""Private bounded cutout fringe. Original generated PNG is not edited."""
import math,random
from pathlib import Path
import bpy
from mathutils import Vector
from mathutils.bvhtree import BVHTree
from mathutils.geometry import barycentric_transform


def add_fringe(mesh,faces,points,assignments,hair,preset):
    triangles=[]
    for face in faces:
        ids=[i for i,uv in face]
        if min(points[i].z for i in ids)<1.60:continue
        for i in range(1,len(ids)-1):triangles.append((ids[0],ids[i],ids[i+1]))
    bvh=BVHTree.FromPolygons(points,triangles,all_triangles=True)
    hair_bvh=BVHTree.FromPolygons([v.co for v in hair.data.vertices],[list(p.vertices)for p in hair.data.polygons])
    def hair_layer(origin,direction,result,t):
        point,normal,weights=result
        h,hn,hi,hd=hair_bvh.ray_cast(Vector(origin),Vector(direction),.8)
        if h is not None and (h-point).length<.009:
            return h,normal,weights,.00008-.00085*max(0,1-t/.32)**2
        return point,normal,weights,.00025
    normals=[Vector() for p in points]
    for a,b,c in triangles:
        n=(points[b]-points[a]).cross(points[c]-points[a])
        for i in (a,b,c):normals[i]+=n
    for n in normals:
        if n.length:n.normalize()
    def fit(origin,direction):
        p,n,i,d=bvh.ray_cast(Vector(origin),Vector(direction),.8)
        if p is None:return None
        ids=triangles[i];bary=barycentric_transform(p,*[points[k]for k in ids],Vector((1,0,0)),Vector((0,1,0)),Vector((0,0,1)))
        w={}
        for k,b in zip(ids,bary):
            for bone,value in assignments[k].items():w[bone]=w.get(bone,0)+max(0,b)*value
        total=sum(w.values());n=sum((normals[k]*max(0,b)for k,b in zip(ids,bary)),Vector()).normalized()
        return p,n,{k:v/total for k,v in w.items()if v>1e-7}
    mat=bpy.data.materials.new('Short_Hair_Cutout');mat.use_nodes=True;mat.diffuse_color=(.53,.46,.43,1);mat.use_backface_culling=False;mat['preserve_cutout']=True
    p=mat.node_tree.nodes.get('Principled BSDF');p.inputs['Roughness'].default_value=.86;p.inputs['Specular IOR Level'].default_value=.20
    image=bpy.data.images.load(str(Path(__file__).parent/'generated/hair-strands-v1.png'),check_existing=True)
    tex=mat.node_tree.nodes.new('ShaderNodeTexImage');tex.image=image;tex.interpolation='Linear'
    multiply=mat.node_tree.nodes.new('ShaderNodeMix');multiply.data_type='RGBA';multiply.blend_type='MULTIPLY';multiply.inputs[0].default_value=1;multiply.inputs[7].default_value=(.53,.46,.43,1)
    mat.node_tree.links.new(tex.outputs['Color'],multiply.inputs[6]);mat.node_tree.links.new(multiply.outputs[2],p.inputs['Base Color'])
    clip=mat.node_tree.nodes.new('ShaderNodeMath');clip.operation='GREATER_THAN';clip.inputs[1].default_value=.38
    mat.node_tree.links.new(tex.outputs['Alpha'],clip.inputs[0]);mat.node_tree.links.new(clip.outputs[0],p.inputs['Alpha'])
    # Continue the same unchanged strand pigment across the fitted interior.
    # This rectangle is entirely above the alpha cutoff in the original PNG.
    # A continuous mirrored coordinate keeps the narrow dense domain seamless.
    hair.name='Fitted_Strand_Hair';hair.data.materials.clear();hair.data.materials.append(mat)
    layer=hair.data.uv_layers.active
    for polygon in hair.data.polygons:
        centre=sum((hair.data.vertices[i].co for i in polygon.vertices),Vector())/len(polygon.vertices)

        for li in polygon.loop_indices:
            point=hair.data.vertices[hair.data.loops[li].vertex_index].co
            u=.5+.5*math.sin(point.x*math.pi/.019)
            angle=math.atan2(point.z-1.655,-(point.y+.020))
            if angle<0:angle+=math.tau
            v=max(0,min(1,angle/math.pi))
            layer.data[li].uv=((76+58*u)/1254,1-(145+670*v)/1254)
    vv=[];ww=[];nn=[];ff=[];uv=[];rng=random.Random(1217)
    def card(sample,width,number):
        first=len(vv);rows=7;column=number%6
        for row in range(rows):
            t=row/(rows-1)
            for side in (-1,1):
                result=sample(t,side*width/2)
                if result is None:
                    del vv[first:];del ww[first:];del nn[first:];del uv[first:];return
                point,normal,weights,height=result
                vv.append(point+normal*height);nn.append(normal);ww.append(weights)
                uv.append(((column+(0.05 if side<0 else .95))/6,.94-.91*t))
        for row in range(rows-1):
            a=first+row*2;face=(a,a+1,a+3,a+2)
            if (vv[a+1]-vv[a]).cross(vv[a+2]-vv[a]).dot(nn[a])<0:face=tuple(reversed(face))
            ff.append(face)
    for number in range(47):
        x=-.069+.138*number/46+rng.uniform(-.0003,.0003)
        temple=max(0,min(1,(abs(x)-.061)/.021))
        hairline=1.710+.009*math.exp(-((abs(x)-.047)/.018)**2)-.044*temple**1.5
        length=rng.uniform(.016,.020);root=hairline+length-.004
        if preset=="friar":root=min(1.730,root);length=root-hairline+.004
        def sample(t,offset,x=x,root=root,length=length):
            fit_result=fit((x+offset,-.3,root-length*t),(0,1,0))
            if fit_result is None:return None
            return hair_layer((x+offset,-.3,root-length*t),(0,1,0),fit_result,t)
        card(sample,rng.uniform(.0042,.0053),number)
    if preset=='friar':
        for number in range(72):
            angle=math.tau*number/72
            def sample(t,offset,angle=angle):
                a=angle+offset/.065;z=1.722+.017*t
                fit_result=fit((.35*math.cos(a),.35*math.sin(a),z),(-math.cos(a),-math.sin(a),0))
                if fit_result is None:return None
                return hair_layer((.35*math.cos(a),.35*math.sin(a),z),(-math.cos(a),-math.sin(a),0),fit_result,t)
            card(sample,rng.uniform(.0040,.0050),number+47)
    obj=mesh('Native_Fitted_Hair_Fringe',vv,ff,mat,ww,[[uv[i]for i in f]for f in ff]);obj['preserve_cutout']=True
    return obj
