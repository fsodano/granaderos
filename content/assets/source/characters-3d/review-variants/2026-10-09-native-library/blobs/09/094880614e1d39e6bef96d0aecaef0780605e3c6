+/** Drive authored sleeve corrections from the final native elbow pose.
+ * Models without these optional morph targets are unchanged.
+ * @param {any} model A cloned, natively skinned character.
+ */
+export function createElbowCloth(model) {
+ const entries=[];
+ model.traverse(mesh=>{
+  if(!mesh.isSkinnedMesh||!mesh.morphTargetInfluences)return;
+  for(const side of ['l','r']){
+   const target=mesh.morphTargetDictionary?.['coat_elbow_'+side];
+   if(target===undefined)continue;
+   const names=['upperarm_'+side,'lowerarm_'+side,'hand_'+side];
+   const indices=names.map(name=>mesh.skeleton.bones.findIndex(bone=>bone.name===name));
+   if(indices.some(index=>index<0))throw Error('Elbow corrective lacks its native arm');
+   const bones=indices.map(index=>mesh.skeleton.bones[index]);
+   const rest=indices.map(index=>model.position.clone().setFromMatrixPosition(mesh.skeleton.boneInverses[index].clone().invert()));
+   const bind=rest[1].clone().sub(rest[0]).angleTo(rest[2].clone().sub(rest[1]));
+   const full=110*Math.PI/180;
+   if(!(full>bind))throw Error('Invalid elbow corrective range');
+   entries.push({mesh,target,bones,bind,range:full-bind});
+  }
+ });
+ const points=[model.position.clone(),model.position.clone(),model.position.clone()];
+ const upper=model.position.clone(),lower=model.position.clone();
+ return {apply(){
+  if(!entries.length)return;
+  model.updateWorldMatrix(true,true);
+  for(const {mesh,target,bones,bind,range}of entries){
+   for(let i=0;i<3;i++)points[i].setFromMatrixPosition(bones[i].matrixWorld);
+   upper.copy(points[1]).sub(points[0]);lower.copy(points[2]).sub(points[1]);
+   const angle=upper.lengthSq()>1e-12&&lower.lengthSq()>1e-12?upper.angleTo(lower):bind;
+   mesh.morphTargetInfluences[target]=Math.max(0,Math.min(1,(angle-bind)/range));
+  }
+ }};
+}
