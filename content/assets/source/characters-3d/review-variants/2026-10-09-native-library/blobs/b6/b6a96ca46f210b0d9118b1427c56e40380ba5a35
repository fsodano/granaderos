import json,sys,numpy as np
from pathlib import Path
P=Path(__file__).parent

def segment_triangle(a,b,tri):
 d=b-a;v0,v1,v2=tri;e1=v1-v0;e2=v2-v0;p=np.cross(d,e2);det=np.dot(e1,p)
 if abs(det)<1e-12:return None
 inv=1/det;tvec=a-v0;u=np.dot(tvec,p)*inv
 if u<0 or u>1:return None
 q=np.cross(tvec,e1);v=np.dot(d,q)*inv
 if v<0 or u+v>1:return None
 t=np.dot(e2,q)*inv
 if not 1e-7<t<1-1e-7:return None
 return a+t*d
tag=sys.argv[1]if len(sys.argv)>1 else'chest'
rows=[]
for label in ['baseline-models','models']:
 d=json.loads((P/(label+'-'+tag+'.json')).read_text());p=np.array(d['points']);r=np.array(d['rest']);uv=np.array(d['uv']);tri=np.array(d['tri']);tile=np.floor(uv[tri].mean(1)*4).astype(int);vest=tri[(tile[:,0]==1)&(tile[:,1]==3)];shirt=tri[(tile[:,0]==0)&(tile[:,1]==3)];s=p[shirt];low=s.min(1);high=s.max(1);pairs=[]
 for i,t in enumerate(vest):
  v=p[t];possible=np.where(np.all(high>=v.min(0),1)&np.all(low<=v.max(0),1))[0]
  for j in possible:
   q=s[j];hits=[]
   for a in range(3):
    h=segment_triangle(v[a],v[(a+1)%3],q)
    if h is not None:hits.append(h.tolist())
    h=segment_triangle(q[a],q[(a+1)%3],v)
    if h is not None:hits.append(h.tolist())
   if hits:
    normal=np.cross(q[1]-q[0],q[2]-q[0]);normal/=max(np.linalg.norm(normal),1e-12)
    signed=(v-q[0])@normal
    region='front-armhole'if abs(r[t].mean(0)[0])>.12 and r[t].mean(0)[2]>.025 and r[t].mean(0)[1]>1.26 else'other'
    pairs.append({'vest':t.tolist(),'shirt':shirt[j].tolist(),'hits':hits,'region':region,'localShirtPlaneSignedMm':(signed*1000).tolist()})
 row={'label':label,'clip':d.get('clip'),'time':d.get('time'),'bodySha256':d.get('bodySha256'),'bankSha256':d.get('bankSha256'),'pairs':len(pairs),'details':pairs};rows.append(row);print(label,len(vest),len(shirt),'crossings',len(pairs),flush=True)
(P/('surface-crossings-'+tag+'.json')).write_text(json.dumps(rows,indent=2)+'\n')
