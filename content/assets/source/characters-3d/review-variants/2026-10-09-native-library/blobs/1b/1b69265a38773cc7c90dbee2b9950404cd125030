+def fit_reduced_head(objects,lod):
+    """Fit the cutout layer outside the actual reduced scalp and underlayer."""
+    head=next(o for o in objects if o.name.startswith('Exposed_Human_Head'))
+    underlayer=next(o for o in objects if o.name.startswith('Short_Hair'))
+    scalp=BVHTree.FromPolygons([v.co for v in head.data.vertices],
+                              [list(p.vertices)for p in head.data.polygons])
+    # The native head can reduce outside the old hair surface. Keep the hidden
+    # layer very close to that head before fitting the visible alpha strands.
+    for vertex in underlayer.data.vertices:
+        q,n,i,d=scalp.find_nearest(vertex.co)
+        if q is not None and d<.006 and (vertex.co-q).dot(n)<.00020:
+            vertex.co=q+n*.00020
