                        help='Complete exported library, including manifest, banks, equipment and textures')
    parser.add_argument('--body-dir', type=Path, help='Use unpublished body GLBs from this directory; banks and equipment remain published')
    parser.add_argument('--lod', type=int, choices=[0,1,2], default=0, help='Exported character detail level; default 0')
    parser.add_argument('--skin', choices=['light','brown','dark'], help='Use the production runtime skin palette instead of the exported base factor')
