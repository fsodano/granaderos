def digest(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def skin_palette_linear(tone, reference=None):
    """Match game/skin-palette.js, including coloured-albedo compensation."""
    value=tone.lstrip('#')
    srgb=[int(value[i:i+2],16)/255 for i in (0,2,4)]
    linear=[v/12.92 if v<=.04045 else ((v+.055)/1.055)**2.4 for v in srgb]
    valid=isinstance(reference,list) and len(reference)==3 and all(
        type(v) in (int,float) and math.isfinite(v) and v>0 for v in reference)
    if valid:linear=[v/r for v,r in zip(linear,reference)]
    return linear+[1]


def parse_args():
