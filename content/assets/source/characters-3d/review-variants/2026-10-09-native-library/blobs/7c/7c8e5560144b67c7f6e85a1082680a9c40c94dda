def asset_path(url):
    prefix = '/models/characters/'
    if not url.startswith(prefix):
        raise ValueError('Asset outside character library: '+url)
    path = (LIBRARY / url[len(prefix):]).resolve()
    if not path.is_relative_to(LIBRARY.resolve()):
        raise ValueError('Asset outside character library: '+url)
    return path


def asset_record(spec, override=None):
    path = override or asset_path(spec['url'])
    actual = digest(path)
    if override is None and actual != spec['sha256']:
        raise ValueError('Manifest and file differ; finish the asset build first: '+str(path))
    result={'path': str(path.relative_to(ROOT)) if path.is_relative_to(ROOT) else str(path), 'sha256': actual, 'bytes': path.stat().st_size, 'published': override is None and LIBRARY.resolve() == (PUBLIC/'models/characters').resolve(), 'manifestVerified': override is None}
    raw=path.read_bytes();document=json.loads(raw[20:20+int.from_bytes(raw[12:16],'little')])
    result['textures']={image['uri']:digest(path.parent/image['uri']) for image in document.get('images',[]) if image.get('uri') and not image['uri'].startswith('data:')}
    result['texturePaths']={uri:str((path.parent/uri).resolve()) for uri in result['textures']}
    return result


def write_index(output, report):
    (output/'index.json').write_text(json.dumps(report, indent=2)+'\n')
    cards=[]
    for preset in report['presets']:
        groups={}
        for frame in report['frames']:
            if frame['preset']==preset:groups.setdefault(frame['clip'],[]).append(frame)
        rows=[]
        for clip, frames in groups.items():
            figures=''.join(f'<figure><a href="{html.escape(f["file"])}"><img loading="lazy" src="{html.escape(f["file"])}" alt="{html.escape(preset+": "+clip)}"></a><figcaption>{html.escape(f["phase"])} · {f.get("view","iso")} · {f["timeSeconds"]:.3f} s</figcaption></figure>' for f in frames)
            rows.append(f'<article><h3>{html.escape(clip)}</h3><div class="frames">{figures}</div></article>')
        cards.append(f'<section id="{preset}"><h2>{html.escape(preset)}</h2>{"".join(rows)}</section>')
    navigation=' '.join(f'<a href="#{p}">{p}</a>' for p in report['presets'])
    document='''<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Revisión anatómica · Granaderos</title><style>body{font:15px system-ui;margin:24px;background:#202622;color:#ecece4}a{color:#d4c290}nav{position:sticky;top:0;background:#202622;padding:12px 0;display:flex;gap:16px;flex-wrap:wrap}h2{border-top:1px solid #777;padding-top:24px}h3{font-size:14px;color:#c9cfbd}article{margin:22px 0}.frames{display:flex;gap:12px;flex-wrap:wrap}figure{margin:0;max-width:30%;min-width:220px}img{width:100%;display:block;background:#383b35}figcaption{padding:6px 0;color:#bac2ae}small{color:#b7c3b6}</style><h1>Revisión anatómica de los modelos exportados</h1><p>Fotogramas reales de los GLB, vista isométrica fija. Esta revisión no certifica una animación perfecta.</p><p><a href="index.json">Fuentes, versiones y tiempos exactos</a></p><small>Las correcciones de tela usan el peso estable de cada postura. Sin transición entre acciones. Sin efectos de disparo.</small><nav>'''+navigation+'</nav>'+''.join(cards)+'</html>'
    (output/'index.html').write_text(document)


