    parser.add_argument('--hand-details', action='store_true', help='Also render each individual hand for finger/contact review')
    parser.add_argument('--clips', nargs='+')
    parser.add_argument('--times', nargs='+', type=float,
                        help='Exact sample times in seconds; requires one selected clip')
    parser.add_argument('--pilot', action='store_true', help='Granadero and exploradora, four key poses each')
    parser.add_argument('--all-reviewed', action='store_true', help='Include all 29 distinct accepted standing motions in the wider posture review')
    parser.add_argument('--size', type=int, default=560)
    parser.add_argument('--samples', type=int, default=12)
    parser.add_argument('--worker', action='store_true', help=argparse.SUPPRESS)
    args=parser.parse_args(sys.argv[sys.argv.index('--')+1:] if '--' in sys.argv else None)
    if args.pilot and args.all_reviewed:parser.error('--pilot and --all-reviewed are separate review sizes')
    if args.times is not None:
        if args.clips is None or len(args.clips)!=1:parser.error('--times requires exactly one --clips selection')
        if any(not math.isfinite(time) or time<0 for time in args.times):parser.error('--times must be finite, nonnegative seconds')
