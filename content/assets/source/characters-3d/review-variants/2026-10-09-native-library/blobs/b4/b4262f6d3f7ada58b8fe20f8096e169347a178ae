"""Regular upper collar rows with an unchanged sewn native base."""
import math
from mathutils import Vector

def collar_directions(vertices):
    points=[(v.co.x,v.co.y+.036,i) for i,v in enumerate(vertices)]
    # The native sewn edge has small inward detours at its rear. Follow its
    # outer angular order without copying those detours into the visible rim.
    ordered=sorted(points)
    def cross(o,a,b):return (a[0]-o[0])*(b[1]-o[1])-(a[1]-o[1])*(b[0]-o[0])
    halves=[]
    for sequence in (ordered,list(reversed(ordered))):
        h=[]
        for p in sequence:
            while len(h)>=2 and cross(h[-2],h[-1],p)<=0:h.pop()
            h.append(p)
        halves.extend(h[:-1])
    ids=sorted({p[2] for p in halves});count=len(vertices);angles=[None]*count
    for k,a in enumerate(ids):
        b=ids[(k+1)%len(ids)];end=b if b>a else b+count
        start=math.atan2(points[a][1],points[a][0]);stop=math.atan2(points[b][1],points[b][0])
        delta=(stop-start)%math.tau
        if delta>math.pi:raise ValueError('The sewn collar must retain its native outer winding')
        for j in range(a,end):angles[j%count]=start+delta*(j-a)/(end-a)
    for i in range(1,count):
        while angles[i]<angles[i-1]:angles[i]+=math.tau
    step=math.tau/count;phase=sum(a-i*step for i,a in enumerate(angles))/count
    return [[Vector((math.cos(a*(1-f)+(phase+i*step)*f),math.sin(a*(1-f)+(phase+i*step)*f),0)) for i,a in enumerate(angles)] for f in (.15,.60,1.)]

def refine_reduced_collar(ctx):
    """Rebuild only the visible collar after the accepted coat reduction."""
    import bpy,bmesh
    from mathutils.kdtree import KDTree
    from anatomy_surface import sewn_boundary,surface_weights
    coat=ctx['coat'];objects=ctx['objects'];red=ctx['M']['red'];skin=ctx['skin']
    red_index=list(coat.data.materials).index(red)
    def navy_faces():
        return sorted(tuple(sorted(tuple(v for v in coat.data.vertices[i].co) for i in f.vertices))for f in coat.data.polygons if f.material_index!=red_index)
    before=navy_faces()
    old_colours=coat.data.color_attributes.get('Human_Surface_Tone')
    old_ids={i for f in coat.data.polygons if f.material_index==red_index for i in f.vertices}
    old_points=[coat.data.vertices[i].co.copy() for i in old_ids]
    old_tones=[tuple(old_colours.data[i].color) if old_colours else (1,1,1,1) for i in old_ids]
    tree=KDTree(len(old_points))
    for i,p in enumerate(old_points):tree.insert(p,i)
    tree.balance()
    bm=bmesh.new();bm.from_mesh(coat.data)
    red_faces=[f for f in bm.faces if f.material_index==red_index]
    bmesh.ops.delete(bm,geom=red_faces,context='FACES')
    loose=[v for v in bm.verts if not v.link_faces]
    if loose:bmesh.ops.delete(bm,geom=loose,context='VERTS')
    bm.to_mesh(coat.data);bm.free();coat.data.update()
    seam=sewn_boundary(coat,lambda v:v.co.z>1.485 and abs(v.co.x)<.13)
    count=len(seam);directions=collar_directions(seam)
    phase=math.atan2(directions[-1][0].y,directions[-1][0].x)
    coords=[v.co.copy()for v in seam]
    weights=[{coat.vertex_groups[g.group].name:g.weight for g in v.groups if g.weight>1e-7}for v in seam]
    faces=[];rows=[list(range(count))]
    def ring(level,dirs):
        ids=[]
        for direction in dirs:
            centre=Vector((0,-.036,level));hit,q,n,face=skin.ray_cast(centre+direction*.17,-direction)
            if not hit or (q-centre).length>=.115:raise ValueError('Collar row requires the native neck surface')
            ids.append(len(coords));coords.append(q+Vector((n.x,n.y,0)).normalized()*.006);weights.append(surface_weights(skin,q,face))
        return ids
    rows.append(ring(1.516,directions[0]))
    regular=[Vector((math.cos(phase+i*math.tau/104),math.sin(phase+i*math.tau/104),0))for i in range(104)]
    rows.append(ring(1.525,regular));rows.append(ring(1.533,regular))
    outer=list(rows[-1])
    for depth,drop in ((.0026,0),(.0026,.0026)):
        ids=[]
        for i in outer:
            p=coords[i];radial=Vector((p.x,p.y+.036,0)).normalized();ids.append(len(coords));coords.append(p-radial*depth-Vector((0,0,drop)));weights.append(dict(weights[i]))
        rows.append(ids)
    for lower,upper in zip(rows,rows[1:]):
        i=j=0;n=len(lower);m=len(upper)
        while i<n or j<m:
            a=lower[i%n];b=upper[j%m];u=(i+1)/n if i<n else 2;v=(j+1)/m if j<m else 2
            if abs(u-v)<1e-10:faces.append((a,lower[(i+1)%n],upper[(j+1)%m],b));i+=1;j+=1
            elif u<v:faces.append((a,lower[(i+1)%n],b));i+=1
            else:faces.append((a,upper[(j+1)%m],b));j+=1
    collar=ctx['mesh']('Crimson_Collar_Regular_Rim',coords,faces,red,weights)
    tones=collar.data.color_attributes.new(name='Human_Surface_Tone',type='FLOAT_COLOR',domain='POINT')
    for v,c in zip(collar.data.vertices,tones.data):c.color=old_tones[tree.find(v.co)[1]]
    seam_positions={tuple(round(x,6)for x in p)for p in coords[:count]}
    bpy.ops.object.select_all(action='DESELECT');coat.select_set(True);collar.select_set(True);bpy.context.view_layer.objects.active=coat;bpy.ops.object.join();objects.remove(collar)
    bm=bmesh.new();bm.from_mesh(coat.data);ids=[v for v in bm.verts if tuple(round(x,6)for x in v.co)in seam_positions];bmesh.ops.remove_doubles(bm,verts=ids,dist=.000002);bmesh.ops.triangulate(bm,faces=[f for f in bm.faces if f.material_index==red_index]);bm.to_mesh(coat.data);bm.free();coat.data.update()
    assert navy_faces()==before,'The collar rebuild must preserve every accepted coat support triangle'
    gold=next(o for o in objects if o.name=='Fine_Collar_Gold_Edge');insertion=objects.index(gold);objects.remove(gold);bpy.data.objects.remove(gold,do_unlink=True)
    path=[coords[i]+Vector((0,0,.0007))for i in outer];path.append(path[0]);ww=[weights[i]for i in outer];ww.append(ww[0])
    trim=ctx['tube']('Fine_Collar_Gold_Edge',path,[.0015]*len(path),ctx['M']['brass'],[w for w in ww for _ in range(6)],6)
    colours=trim.data.color_attributes.new(name='Human_Surface_Tone',type='FLOAT_COLOR',domain='POINT')
    for v,c in zip(trim.data.vertices,colours.data):
        shade=.96-.025*(.5+.5*math.sin(v.co.z*61+v.co.x*39));c.color=(shade,shade,shade*.97,1)
    trim['part']='outfit';trim['appearance']=ctx['preset'];objects.remove(trim);objects.insert(insertion,trim)
    print('COLLAR_SUPPORT_PRESERVED',len(before),'seam',count,'rim',len(outer))
