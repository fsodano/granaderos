import assert from 'node:assert/strict';
import fs from 'node:fs';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {buildIdentity} from '../tools/build-identity.mjs';
import {encodeSave,decodeSave} from '../game/save.js';
import {dispatchCampaign,rosterFor,operativeLocation} from '../game/campaign.js';
import {enterSector} from '../game/world.js';
import {syncBattleTime} from '../game/time.js';
import {actBattle,presentedActBattle,createBattle,getReachable,canSee,visibleHostiles} from '../game/tactical.js';
import {spacePoint,sameSurface} from '../game/tactical-space.js';
import {contractQuote,contractExpiresSeconds} from '../game/contracts.js';
import {previewStrategicRoute} from '../game/strategic-route.js';
import {tooTiredToMarch} from '../game/march-fatigue.js';
import {sectorInventoryModel} from '../game/sector-inventory.js';
import {careAssignmentReason,doctorRate} from '../game/medical-care.js';
import {addIssuedGriefParticipant} from '../game/companion-grief.js';
import {addIssuedConductObserver} from '../game/service-objections.js';
const root=process.cwd(),input='/tmp/granaderos-stock-ending/stock-salta-recapture-battle-continuation-settled.save.json',prefix='/tmp/granaderos-stock-ending/stock-controlled-recovery';
const inputText=fs.readFileSync(input,'utf8'),sha=b=>createHash('sha256').update(b).digest('hex'),inputHash=sha(inputText);
assert.equal(inputHash,'e8898c6bd62eb60c4962481d69ed3e2efd4a191df8a11ed30fb203c01651d451');
const source=await buildIdentity(root);assert.equal(source.source,'f8273d5cd172633712f14fb6bbcb4960eefcbbb93a2e1c7981875562a8ea8e9d');
const files=[...new Set(execFileSync('git',['ls-files','--cached','--others','--exclude-standard','-z','--','tests'],{encoding:'utf8'}).split('\0').filter(Boolean))].sort();
function testDigest(){const h=createHash('sha256');for(const p of files){h.update(p);h.update('\0');h.update(fs.readFileSync(p));h.update('\0');}return h.digest('hex');}
const tests={count:files.length,digest:testDigest()};assert.deepEqual(tests,{count:881,digest:'6a7ed1dfd0f186f8e03229cba722f938f9aea686690612313a2e0e785164926b'});
assert.equal(fs.existsSync(prefix+'-before.save.json'),false,'Never overwrite an earlier proof prefix.');
let pair=decodeSave(inputText),history=[],events=[],frames=0,renewalCost=0,stage='admission',attemptedAction=null;
const initial=structuredClone(pair),dead=Object.keys(pair.campaign.operativeState).map(Number).filter(id=>!pair.campaign.operativeState[id].alive),originalServing=pair.campaign.recruited.filter(id=>pair.campaign.operativeState[id].alive),recruited=[];
assert.equal(dead.length,40);assert.equal(originalServing.length,9);
const clock=c=>c.hour*3600+(c.secondOfHour??0),c=()=>pair.campaign,roster=()=>rosterFor(c()),actor=id=>pair.battle?.units.find(u=>u.side==='player'&&u.id===String(id));
function short(){return {hour:c().hour,second:c().secondOfHour??0,cash:c().resources.treasury,location:c().location,pendingBattle:c().pendingBattle?.id??null,pendingEncounter:c().pendingEncounter,squads:c().squads.filter(q=>q.members.length).map(q=>({id:q.id,location:q.location,members:q.members,journey:q.journey?{status:q.journey.status,reason:q.journey.reason,path:q.journey.path,elapsed:q.journey.elapsed,elapsedSecond:q.journey.elapsedSecond}:null})),living:c().recruited.filter(id=>c().operativeState[id].alive).map(id=>{const r=actor(id)??c().operativeState[id];return {id,location:operativeLocation(c(),id),hp:r.hp,bleed:r.bleeding,bandaged:r.bandaged,medkits:r.medkits,morale:r.personalMorale??r.morale,energy:r.energy,fatigue:r.fatigue,asleep:r.asleep,assignment:c().operativeState[id].assignment,expiry:contractExpiresSeconds(c().contracts[id])};}),capture105:{hp:c().operativeState[105].hp,bleed:c().operativeState[105].bleeding,captured:c().operativeState[105].captured}};}
function official(){const text=encodeSave(c(),pair.battle);assert.deepEqual(decodeSave(text),pair);return text;}
function save(name){const text=official();fs.writeFileSync(prefix+'-'+name+'.save.json',text);fs.writeFileSync(prefix+'-latest.save.json',text);fs.writeFileSync(prefix+'-history.json',JSON.stringify(history,null,2)+'\n');fs.writeFileSync(prefix+'-events.json',JSON.stringify(events,null,2)+'\n');console.log(JSON.stringify({event:'checkpoint',stage:name,orders:history.length,...short()}));}
function safe(){assert.equal(c().defeated,false,'A real campaign loss stops this stage.');assert.equal(c().pendingEncounter,null,'An unexpected real encounter stops this stage.');for(const id of dead)assert.equal(c().operativeState[id].alive,false,`Dead${id} stays dead.`);for(const id of [...originalServing,...recruited]){const r=c().operativeState[id];assert.ok(r.alive&&!r.captured&&c().recruited.includes(id),`Serving${id} must stay available.`);assert.ok(r.hp>=15&&!r.bleeding,`Acute${id} requires a separate aid decision.`);const e=contractExpiresSeconds(c().contracts[id]);assert.ok(e===null||e>clock(c()),`Serving${id} expired.`);}assert.equal(c().operativeState[105].captured,true,'Existing captivity stays intact.');assert.ok(c().operativeState[105].alive,'An actual captive death stops this stage.');if(pair.battle){assert.equal(pair.battle.status,'active');assert.equal(pair.battle.mode,'exploration');assert.equal(pair.battle.phase,'player');assert.equal(visibleHostiles(pair.battle,'player').length,0,'An observed threat stops controlled contact.');}for(const q of c().squads.filter(q=>q.journey)){assert.equal(q.journey.status,'moving','An actual route interruption stops this stage.');for(const id of q.members){assert.equal(c().operativeState[id].asleep,false,'Sleeping interrupts travel.');assert.equal(tooTiredToMarch(c().operativeState[id]),false,'Fatigue interrupts travel.');}}}
function termBudget(seconds){for(const id of [...originalServing,...recruited]){const e=contractExpiresSeconds(c().contracts[id]);assert.ok(e===null||e>clock(c())+seconds,`Requote serving${id} before advancing another${seconds}s.`);}}
function perform(p,step){
 if(step.kind==='campaign'){const next=dispatchCampaign(p.campaign,step.action);assert.equal(next.lastError,null,next.lastError);return {campaign:next,battle:next.pendingBattle?enterSector(next.pendingBattle,next.sectorStates[next.pendingBattle.sector]):null};}
 if(step.kind==='tactical'){const before=structuredClone(p.battle),next=actBattle(p.battle,step.action),shown=presentedActBattle(p.battle,step.action);assert.deepEqual(p.battle,before);assert.equal(next.lastError,null,next.lastError);assert.deepEqual(shown.state,next);const synced=syncBattleTime(p.campaign,next);assert.equal(synced.error,null,synced.error);return {campaign:synced.campaign,battle:synced.battle};}
 if(step.kind==='talk'){const npc=p.battle.npcs.find(n=>n.id===step.action.npcId),next=dispatchCampaign(p.campaign,{...step.action,sectorState:p.battle});assert.equal(next.lastError,null,next.lastError);assert.equal(next.lastConversation.outcome,'recruited');let updated=structuredClone(p.battle);updated.npcs=updated.npcs.filter(n=>n.id!==npc.id);const id=next.lastConversation.operativeId,issued=next.pendingBattle.squad.find(o=>o.id===id);assert.ok(issued&&npc);if(!updated.units.some(u=>Number(u.id)===id)){const unit=createBattle([issued],{width:p.battle.width,height:p.battle.height,enemies:[],exploration:true}).units.find(u=>u.side==='player'),joined={...unit,x:npc.x,y:npc.y};updated.units.push(joined);addIssuedGriefParticipant(updated,joined);addIssuedConductObserver(updated,joined);}return {campaign:next,battle:updated};}
 if(step.kind==='leave'){const next=dispatchCampaign(p.campaign,{type:'leaveSector',battleId:p.campaign.pendingBattle.id,sectorState:p.battle,survivors:p.battle.units.filter(u=>u.side==='player')});assert.equal(next.lastError,null,next.lastError);return {campaign:next,battle:null};}
 throw Error('Unknown step kind.');
}
function accept(step,detail={}){safe();save('pre-action');attemptedAction=structuredClone(step);const before=short(),snapshot=structuredClone(pair);let frameCount=0;if(step.kind==='tactical')frameCount=presentedActBattle(pair.battle,step.action).frames.length;pair=perform(pair,step);assert.deepEqual(snapshot,decodeSave(encodeSave(snapshot.campaign,snapshot.battle)));history.push(structuredClone(step));frames+=frameCount;if(step.kind==='talk')recruited.push(c().lastConversation.operativeId);events.push({index:history.length,stage,kind:step.kind,action:step.action??null,detail,before,after:short()});fs.appendFileSync(prefix+'-accepted.jsonl',JSON.stringify(events.at(-1))+'\n');save('active');safe();attemptedAction=null;}
function raw(action,detail){assert.equal(pair.battle,null);accept({kind:'campaign',action},detail);}
function tactical(action){termBudget(600);accept({kind:'tactical',action});}
function waitHour(){termBudget(3600);raw({type:'wait',hours:1});}
function road(destination){assert.equal(pair.battle,null);const q=c().squads.find(q=>q.id===c().activeSquadId),plan=previewStrategicRoute(c(),q.id,destination,'posta');assert.ok(plan.valid,plan.reason);termBudget(plan.hours*3600+600);assert.ok(plan.path.every(at=>c().sectors[at]?.owner==='patriot'));raw(plan.action,{publicRoute:plan});for(let i=0;i<24&&c().squads.find(s=>s.id===q.id).journey;i++)waitHour();assert.equal(c().squads.find(s=>s.id===q.id).journey,undefined);assert.equal(c().location,destination);}
function approachNPC(npcId){for(let i=0;i<240;i++){const u=actor(0),n=pair.battle.npcs.find(n=>n.id===npcId);assert.ok(u&&n,'The actual known contact and envoy must exist.');assert.ok(u.hp>=15&&u.energy>10&&!u.asleep&&!u.unconscious,'A fatigued/incapable envoy stops approach.');if(sameSurface(u,n)&&Math.abs(u.x-n.x)+Math.abs(u.y-n.y)<=1){if(canSee(pair.battle,u,n))return;tactical({type:'look',unitId:u.id,...spacePoint(n)});continue;}const reach=getReachable(pair.battle,u),adjacent=reach.filter(p=>sameSurface(p,n)&&Math.abs(p.x-n.x)+Math.abs(p.y-n.y)===1).sort((a,b)=>a.cost-b.cost)[0];if(adjacent?.path.length){tactical({type:'move',unitId:u.id,...spacePoint(adjacent.path[0])});continue;}const doors=pair.battle.tiles.filter(t=>t.type==='door'&&!t.open&&!t.locked),options=doors.flatMap(door=>reach.filter(p=>sameSurface(p,door)&&Math.abs(p.x-door.x)+Math.abs(p.y-door.y)===1).map(p=>({door,p}))).sort((a,b)=>(a.p.cost+Math.abs(a.door.x-n.x)+Math.abs(a.door.y-n.y))-(b.p.cost+Math.abs(b.door.x-n.x)+Math.abs(b.door.y-n.y)));const next=options[0];assert.ok(next,'No legal actual door/contact approach.');tactical(next.p.path.length?{type:'move',unitId:u.id,...spacePoint(next.p.path[0])}:{type:'door',unitId:u.id,doorId:next.door.doorId??`door:${next.door.x}:${next.door.y}`,open:true});}throw Error('Actual contact approach exceeded240steps.');}
function recruit(npcId,id){approachNPC(npcId);const n=pair.battle.npcs.find(n=>n.id===npcId),u=actor(0);assert.ok(canSee(pair.battle,u,n));const sourceNPC={id:n.id,operativeId:n.operativeId,...spacePoint(n),hp:n.hp,medkits:n.civilianSupplies?.medkits,civilianWeapons:n.civilianWeapons};accept({kind:'talk',action:{type:'talkNPC',npcId,approach:'recruit',unitId:'0'}},{actualObservedAdjacent:true,sourceNPC});assert.equal(c().lastConversation.operativeId,id);assert.equal(c().contracts[id].expiresAt,null);assert.equal(c().contracts[id].paid,0);assert.equal(actor(id).x,n.x);assert.equal(actor(id).y,n.y);save('recruited-'+id);}
async function verifyReplay(){let replay=decodeSave(inputText);for(const step of history){replay=perform(replay,step);assert.deepEqual(decodeSave(encodeSave(replay.campaign,replay.battle)),replay);}assert.deepEqual(replay,pair);return {orders:history.length,exact:true,ordinaryPresentedEqual:true,officialEveryAction:true};}
function receipt(error,replay){return {source,tests,input,inputHash,inputUnchanged:sha(fs.readFileSync(input))===inputHash,stage,error,attemptedAction,history,events,orders:history.length,frames,renewalCost,originalServing,priorDead:dead,recruited,seconds:clock(c())-clock(initial.campaign),cashDelta:c().resources.treasury-initial.campaign.resources.treasury,before:{clock:{hour:initial.campaign.hour,second:initial.campaign.secondOfHour},cash:initial.campaign.resources.treasury},after:short(),captureCare:c().detentionRecords,fullReplay:replay,limits:'One controlled recovery stage only; no hostile entry/assault/new hire, no full ending.'};}
try{
 safe();save('before');
 stage='five-renewals';for(const id of [116,117,146,127,144]){const old=c().contracts[id],expires=contractExpiresSeconds(old),quote=contractQuote(c(),roster().find(o=>o.id===id),'day'),cash=c().resources.treasury;assert.ok(quote.available&&cash>=quote.price);raw({type:'renewContract',id,term:'day',expectedExpiresAt:old.expiresAt,expectedExpiresSecond:old.expiresSecond??0},{quote});renewalCost+=quote.price;assert.equal(c().resources.treasury,cash-quote.price);assert.equal(contractExpiresSeconds(c().contracts[id]),expires+86400);}assert.equal(renewalCost,548);save('terms-retained');
 stage='stable-rear-rest';for(const id of [116,117,128,145])raw({type:'assignCare',operativeId:id,assignment:'rest'});
 stage='envoy-formation';raw({type:'createSquad',name:'Contactos de retaguardia',ids:[0],sector:'cordoba'});const envoySquad=c().activeSquadId;
 stage='rural-route';raw({type:'selectSquad',id:'squad-40'});const rural=previewStrategicRoute(c(),'squad-40','cordoba','march');assert.ok(rural.valid,rural.reason);assert.equal(rural.hours,32);termBudget(rural.hours*3600+1800);raw(rural.action,{publicRoute:rural});
 stage='BA-road';raw({type:'selectSquad',id:envoySquad});road('buenos_aires');raw({type:'visitSector'});save('BA-entered');
 stage='Paroissien-contact';recruit('paroissien',10);stage='Dorrego-contact';recruit('dorrego',4);accept({kind:'leave'});
 stage='known-BA-dressings';const beforeKits=c().operativeState[0].medkits,model=sectorInventoryModel(c(),'buenos_aires',roster(),0),rows=model.entries.filter(e=>{try{return JSON.parse(e.expected).item==='medkits';}catch{return false;}});assert.ok(rows.length,'The already-known BA dressing source remains.');let dressings=0;for(const row of rows){assert.ok(row.reachable,row.reason);raw({type:'sectorInventory',sector:'buenos_aires',operativeId:0,direction:'take',sourceKey:row.key,expected:row.expected,count:row.count},{sourceBefore:row});dressings+=row.count;const left=sectorInventoryModel(c(),'buenos_aires',roster(),0).entries.find(e=>e.key===row.key)?.count??0;assert.equal(left,0);}assert.equal(dressings,6);assert.equal(c().operativeState[0].medkits,beforeKits+6);save('BA-finite-dressings');
 stage='Retiro-road';road('retiro');raw({type:'visitSector'});stage='Cabral-contact';recruit('cabral',3);accept({kind:'leave'});stage='envoy-return';road('cordoba');for(const id of c().squad)raw({type:'assignCare',operativeId:id,assignment:'rest'});save('contacts-returned');
 stage='rural-arrival';for(let i=0;i<40&&c().squads.find(q=>q.id==='squad-40').journey;i++)waitHour();assert.equal(c().squads.find(q=>q.id==='squad-40').location,'cordoba');assert.equal(c().squads.find(q=>q.id==='squad-40').journey,undefined);for(const id of [146,144,127,9])raw({type:'assignCare',operativeId:id,assignment:'rest'});save('rural-returned');
 stage='two-finite-clinical-hours';const doctors=[10,116];for(const id of doctors){assert.equal(careAssignmentReason(c(),roster().find(o=>o.id===id),'doctor'),'');raw({type:'assignCare',operativeId:id,assignment:'doctor'});}for(const id of [144,127])raw({type:'assignCare',operativeId:id,assignment:'patient'});const clinicalBefore=structuredClone(c().operativeState);waitHour();assert.ok(c().operativeState[144].hp>clinicalBefore[144].hp&&c().operativeState[127].hp>clinicalBefore[127].hp);assert.equal(c().operativeState[10].medkits,clinicalBefore[10].medkits-1);assert.equal(c().operativeState[116].medkits,clinicalBefore[116].medkits-1);raw({type:'assignCare',operativeId:116,assignment:'rest'});waitHour();assert.equal(c().operativeState[10].medkits,clinicalBefore[10].medkits-2);raw({type:'assignCare',operativeId:10,assignment:'rest'});save('clinical-strokes-complete');
 safe();assert.deepEqual(new Set(recruited),new Set([10,4,3]));assert.equal(c().pendingBattle,null);assert.equal(c().pendingEncounter,null);assert.equal(c().recruited.filter(id=>c().operativeState[id].alive).length,12);for(const id of originalServing){assert.ok(c().operativeState[id].hp>=initial.campaign.operativeState[id].hp);assert.equal(c().operativeState[id].condition,initial.campaign.operativeState[id].condition);}stage='final-replay';const replay=await verifyReplay();assert.equal(sha(fs.readFileSync(input)),inputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests.digest);save('accepted');fs.writeFileSync(prefix+'-receipt.json',JSON.stringify(receipt(null,replay),null,2)+'\n');console.log(JSON.stringify({event:'controlledRecoveryAccepted',orders:history.length,renewalCost,recruited,seconds:clock(c())-clock(initial.campaign),...short()}));
}catch(error){let stoppedAdmissionError=null,replay=null;try{save('stopped');}catch(e){stoppedAdmissionError=e.stack;console.error(e.stack);}try{replay=await verifyReplay();}catch(e){replay={error:e.stack};}assert.equal(sha(fs.readFileSync(input)),inputHash);assert.deepEqual(await buildIdentity(root),source);assert.equal(testDigest(),tests.digest);const report=receipt(error.stack,replay);report.stoppedAdmissionError=stoppedAdmissionError;fs.writeFileSync(prefix+'-stopped.receipt.json',JSON.stringify(report,null,2)+'\n');console.error(error.stack);console.log(JSON.stringify({event:'controlledRecoveryStopped',stage,orders:history.length,replay,summary:short()}));process.exitCode=1;}
