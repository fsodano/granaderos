import {readFileSync,writeFileSync} from 'node:fs';
import {decodeSave,encodeSave} from '../game/save.js';
import {enterSector} from '../game/world.js';
import {fightNorthernSector} from '../tests/northern-route.mjs';
import {assignedMountainBatteryController} from '../tests/mountain-battery-driver.mjs';
import {prepareNorthernOfficerRelief,completeHiredNorthernMission} from '../tests/fresh-northern-command.mjs';
const directory='/tmp/granaderos-stock-ending';
const start=decodeSave(readFileSync(`${directory}/current-tucuman.save.json`,'utf8')).campaign;
const checkpoint=(name,campaign,battle=null)=>{const encoded=encodeSave(campaign,battle);decodeSave(encoded);writeFileSync(`${directory}/${name}.save.json`,encoded);console.log(JSON.stringify({checkpoint:name,hour:campaign.hour,second:campaign.secondOfHour,treasury:campaign.resources.treasury}));};
const report=record=>{const {campaign,...note}=record;if(campaign)checkpoint(`relief-${record.event}-${campaign.hour}`,campaign);console.log(JSON.stringify(note));};
const relief=prepareNorthernOfficerRelief(start,{report});
const initial=enterSector({...relief.pendingBattle,hour:relief.hour,secondOfHour:relief.secondOfHour??0},relief.sectorStates.salta);
checkpoint('current-salta-prepared',relief,initial);
const crewScene={...initial,units:initial.units.filter(unit=>unit.side!=='player'||unit.hp>=15&&!unit.unconscious&&!unit.routed&&!unit.surrendered&&!unit.departure&&!unit.fled&&!unit.asleep&&!unit.knockedDown&&!unit.entangled&&(unit.energy??100)>0)};
const salta=fightNorthernSector(relief,'salta',{controller:assignedMountainBatteryController(crewScene),report});
checkpoint('current-salta',salta.campaign);
writeFileSync(`${directory}/current-salta.note.json`,JSON.stringify(salta.summary,null,2));
const ending=completeHiredNorthernMission(salta.campaign);
checkpoint('current-yatasto',ending);
console.log(JSON.stringify({done:true,hour:ending.hour,treasury:ending.resources.treasury,phase:ending.phase}));
