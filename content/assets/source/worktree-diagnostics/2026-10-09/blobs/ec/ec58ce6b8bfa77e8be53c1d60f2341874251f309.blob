import assert from 'node:assert/strict';import {readFile,writeFile}from'node:fs/promises';import{execFileSync}from'node:child_process';import{createHash}from'node:crypto';import{resolve}from'node:path';
const root=process.cwd(),manifestPath=resolve('assets/video/intro/source/capture-manifest.json'),m=JSON.parse(await readFile(manifestPath));assert.equal(m.clips.length,5);assert.deepEqual(m.errors,[]);
for(const c of m.clips){const p=resolve(c.path);if(c.name!=='battle')execFileSync('ffmpeg',['-y','-loglevel','error','-ss',c.rawTrimStart.toFixed(3),'-i',resolve(c.rawVideo),'-vf','setpts=PTS-STARTPTS','-frames:v',String(c.duration*25),'-r','25','-an','-c:v','libx264','-preset','medium','-crf','20','-pix_fmt','yuv420p','-movflags','+faststart',p]);const stats=JSON.parse(execFileSync('ffprobe',['-v','error','-show_entries','stream=width,height,r_frame_rate,nb_frames,start_time,duration','-show_entries','format=duration,start_time,size','-of','json',p],{encoding:'utf8'}));c.media=stats;assert.equal(stats.streams[0].nb_frames,String(c.duration*25));assert.equal(Number(stats.streams[0].start_time),0);assert.equal(Number(stats.format.duration),c.duration);c.sha256=createHash('sha256').update(await readFile(p)).digest('hex');console.log(JSON.stringify({name:c.name,frames:stats.streams[0].nb_frames,duration:stats.format.duration,start:stats.format.start_time,sha256:c.sha256}));}
await writeFile(manifestPath,JSON.stringify(m,null,2)+'\n');
execFileSync('ffmpeg',['-y','-loglevel','error','-ss','2','-i',resolve('assets/video/intro/source/battle.mp4'),'-frames:v','1',resolve('.cache/trailer-capture/battle-encoded-frame.png')]);
