<!doctype html><html lang="es"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Granaderos — Tráiler histórico</title><style>body{margin:0;background:#101612;color:#f1e9d4;font:17px Georgia,serif}main{max-width:1120px;margin:35px auto;padding:0 24px}header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}h1{font-size:28px;font-weight:normal;letter-spacing:3px;margin:0}p{font:14px Arial,sans-serif;color:#c2bdae}video{display:block;width:100%;background:#080d0a;box-shadow:0 12px 60px #0008;aspect-ratio:16/9}nav{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}button,a{border:1px solid #826f4e;border-radius:3px;background:#20271e;color:#eee2c1;padding:10px 16px;cursor:pointer;font:14px Arial,sans-serif;text-decoration:none}button:hover,a:hover{background:#394032}footer{display:flex;justify-content:space-between;align-items:center;margin-top:18px}</style><main><header><h1>GRANADEROS</h1><p>La independencia se conquista.</p></header><video id="trailer" controls preload="metadata" poster="/assets/video/intro/poster.jpg"><source src="/assets/video/intro/granaderos-intro.mp4?v=historical20261009" type="video/mp4"><track kind="subtitles" srclang="es" label="Español" src="captions.vtt"></video><nav aria-label="Escenas del tráiler"><button onclick="playAt(0)">Apertura</button><button onclick="playAt(7)">Reclutamiento</button><button onclick="playAt(15)">Campaña</button><button onclick="playAt(22)">Equipo</button><button onclick="playAt(29)">San Lorenzo</button><button onclick="playAt(41)">Combate</button><button onclick="playAt(51)">Cierre</button></nav><footer><p>56 segundos · Grabación real del juego · Ilustración y música originales</p><a href="/assets/video/intro/granaderos-intro.mp4" download>Descargar video</a></footer></main><script>const trailer=document.getElementById('trailer');function playAt(time){trailer.currentTime=time;trailer.play()}</script></html>