import fs from 'node:fs';
import assert from 'node:assert/strict';
import {createHash} from 'node:crypto';
import {execFileSync} from 'node:child_process';
import {buildIdentity} from '../tools/build-identity.mjs';
import {decodeSave,encodeSave} from '../game/save.js';

const dir='/tmp/granaderos-stock-ending/',prefix=dir+'stock-isolation-main217-readonly-final';
const priorPrefix=dir+'stock-isolation-main217-readonly-continuation';
const targetPath=dir+'stock-ensenada-daylight-approach-accepted.save.json';
const actualPath=priorPrefix+'-stopped.save.json',receiptPath=priorPrefix+'-stopped.receipt.json';
const sha=x=>createHash('sha256').update(x).digest('hex');
const targetText=fs.readFileSync(targetPath),actualText=fs.readFileSync(actualPath),receiptText=fs.readFileSync(receiptPath);
const targetHash=sha(targetText),actualHash=sha(actualText),record=JSON.parse(receiptText);
assert.equal(targetHash,'63b7922f55e3a380335a0e71b7a2c2394cb2cc71ca5c759f6f7da68b9506357c');
assert.equal(actualHash,'2c9ac0ae113fd30d8260b2bb46f0dfc9d74a5dcc1037e986dd19bcd623f6135b');
assert.equal(record.completedOrders,217);assert.equal(record.currentStep,null);assert.equal(record.admissionError,null);
assert.equal(record.officialEveryAction,true);assert.equal(record.newGameplayOrders,0);
assert.match(record.error,/Expected values to be strictly equal/);
const a=decodeSave(targetText.toString()),b=decodeSave(actualText.toString());
assert.deepEqual(a,b);assert.deepEqual(decodeSave(encodeSave(b.campaign,b.battle)),b);
const targetEnvelope=JSON.parse(targetText),actualEnvelope=JSON.parse(actualText);
const oldTimestamp=targetEnvelope.savedAt,newTimestamp=actualEnvelope.savedAt;
assert.ok(Number.isFinite(Date.parse(oldTimestamp))&&Number.isFinite(Date.parse(newTimestamp)));
delete targetEnvelope.savedAt;delete actualEnvelope.savedAt;
assert.deepEqual(targetEnvelope,actualEnvelope,'Only the official outer save timestamp may differ.');
assert.equal(record.checkpointResults.length,8);assert.ok(record.checkpointResults.every(c=>c.exact===true));
assert.deepEqual(record.checkpointResults.map(c=>c.afterOrder),[10,173,176,187,201,202,211,217]);
assert.equal(record.events.length,217);assert.deepEqual(record.events.map(e=>e.index),Array.from({length:217},(_,i)=>i+1));
for(const checkpoint of record.checkpointResults)assert.equal(sha(fs.readFileSync(dir+checkpoint.checkpoint)),checkpoint.hash);
const firstRecord=JSON.parse(fs.readFileSync(record.continuationFrom.priorReceiptPath,'utf8'));
assert.equal(sha(fs.readFileSync(record.continuationFrom.priorReceiptPath)),record.continuationFrom.priorReceiptHash);
assert.equal(sha(fs.readFileSync(record.continuationFrom.resumePath)),record.continuationFrom.resumeHash);
assert.equal(firstRecord.completedOrders,85);assert.equal(record.continuationFrom.completedPriorOrders,85);
assert.ok(record.tacticalOrdinaryPresentedComparisons>0);assert.equal(record.canonicalJoinComparisons,3);
const source=await buildIdentity(process.cwd());assert.deepEqual(source,record.source);
assert.equal(source.source,'46b940fd767143624d3d9e07fe6d467975900986384f03741bf9d8a4c8cb3f97');
assert.equal(source.revision,'37febe6ba06897acc284e87cf7fe6f608662e819');
const paths=[...new Set(execFileSync('git',['ls-files','--cached','--others','--exclude-standard','-z','--','tests'],{encoding:'utf8'}).split('\0').filter(Boolean))].sort(),h=createHash('sha256');
for(const path of paths){h.update(path);h.update('\0');h.update(fs.readFileSync(path));h.update('\0');}
const tests={count:paths.length,digest:h.digest('hex')};assert.deepEqual(tests,record.tests);
assert.deepEqual(tests,{count:885,digest:'083c7d152babc7d913e6d2aae95e8109b8efbb1d0de76fc3a126d935acb9ed2f'});
assert.equal(execFileSync('git',['status','--porcelain'],{encoding:'utf8'}),record.statusBefore);
assert.equal(sha(fs.readFileSync(targetPath)),targetHash);assert.equal(sha(fs.readFileSync(actualPath)),actualHash);assert.equal(sha(fs.readFileSync(receiptPath)),sha(receiptText));
assert.equal(b.battle,null);assert.equal(b.campaign.pendingBattle,null);assert.equal(b.campaign.pendingEncounter,null);
assert.equal(b.campaign.hour,1590);assert.equal(b.campaign.secondOfHour,0);assert.equal(b.campaign.resources.treasury,97960);
assert.equal(b.campaign.squads.find(q=>q.id==='squad-44').journey.status,'ready');
const output=prefix+'-accepted.save.json',outReceipt=prefix+'-receipt.json';
assert.equal(fs.existsSync(output),false);assert.equal(fs.existsSync(outReceipt),false);
fs.writeFileSync(output,actualText);
const audit={readOnly:true,newGameplayOrders:0,source,tests,targetPath,targetHash,actualPath,actualHash,output,outputHash:actualHash,exactCampaignAndBattle:true,exactFormatAndSchema:true,onlyEnvelopeDifference:{field:'savedAt',oldTimestamp,newTimestamp},officialRoundtripExact:true,completedOrders:217,officialEveryAction:true,tacticalOrdinaryPresentedComparisons:record.tacticalOrdinaryPresentedComparisons,canonicalJoinComparisons:record.canonicalJoinComparisons,checkpointResults:record.checkpointResults,sourceHistoryInputUnchanged:true,preservedProofStops:[{prefix:dir+'stock-isolation-main217-readonly',reason:'Logging action.type on the successfully admitted leave order85.'},{prefix:priorPrefix,reason:'Raw-byte SHA equality after exact217 pair/checkpoint equality; official savedAt differs on serialization.'}],actualGameFailure:null,limits:'No action in this final audit. Full original217 history was read-only replayed once across the two proof segments. No new campaign/tactical action, hidden hostile strength/coordinates, source/test edit or build.'};
fs.writeFileSync(outReceipt,JSON.stringify(audit,null,2)+'\n');
console.log(JSON.stringify({event:'readOnlyMain217CompatibilityAccepted',output,outputHash:actualHash,receipt:outReceipt,receiptHash:sha(fs.readFileSync(outReceipt)),completedOrders:217,tacticalComparisons:audit.tacticalOrdinaryPresentedComparisons,canonicalJoinComparisons:audit.canonicalJoinComparisons,exactCampaignAndBattle:true,onlyEnvelopeDifference:audit.onlyEnvelopeDifference,source,tests}));
